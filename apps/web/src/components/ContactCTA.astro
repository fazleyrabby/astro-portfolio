---
import Sketch from "./port/Sketch.astro";
import { getLangFromUrl, useTranslations, useTranslatedPath } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const tp = useTranslatedPath(lang);
---

<section id="contact-cta" class="contact-editorial">
  <div class="contact-container">
    <div class="contact-inner reveal">
      <span class="section-label">Get in Touch</span>

      <h2 class="contact-title">
        {t('contact.title1') || "Have a challenge for me?"} <em>{t('contact.title2') || "Let's build it."}</em>
      </h2>

      <p class="contact-subtitle">
        {t('contact.subtitle') || "Available for mid-level backend engineering roles (remote), high-throughput API design, and database/queue scaling. Open to full-time opportunities and technical consulting."}
      </p>

      <div class="contact-actions">
        <a href="mailto:fazley111@gmail.com" class="btn-primary">
          {t('contact.startBtn') || "Start a Conversation"}
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/></svg>
        </a>
        <a href={tp("/resume/")} class="btn-ghost">
          {t('contact.resumeBtn') || "View Resume"}
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/></svg>
        </a>
        <a href="https://github.com/fazleyrabby" target="_blank" rel="noopener noreferrer" class="btn-ghost">
          GitHub ↗
        </a>
      </div>
    </div>
    <Sketch name="bottle" class="contact-sketch" />
  </div>
</section>

<style>
  .contact-editorial {
    padding: var(--space-section) 0;
  }

  .contact-container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 clamp(1.25rem, 4vw, 2rem);
  }

  .contact-container {
    position: relative;
  }
  .contact-container :global(.contact-sketch) {
    position: absolute;
    right: 0;
    top: 50%;
    width: 190px;
    transform: translateY(-50%);
  }
  @media (max-width: 860px) {
    .contact-container :global(.contact-sketch) { display: none; }
  }

  .contact-inner {
    text-align: center;
    max-width: 640px;
    margin: 0 auto;
  }

  .contact-title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    color: var(--text-primary);
    line-height: 1.15;
    margin: 0 0 1.25rem;
    letter-spacing: -0.02em;
  }
  .contact-title em {
    color: var(--accent);
    font-style: italic;
  }

  .contact-subtitle {
    font-family: var(--font-sans);
    font-size: 1rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin: 0 0 2rem;
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }
</style>
