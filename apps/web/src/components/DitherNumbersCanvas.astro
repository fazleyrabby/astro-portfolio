---
interface AstroProps {
  opacity?: string;
}

const { opacity = '0.24' } = Astro.props;
---

<canvas id="hero-dither-canvas" class="hero-dither-bg" style={`--dither-opacity: ${opacity};`}></canvas>
<div class="hero-dither-overlay"></div>

<script is:inline>
(function() {
  const canvas = document.getElementById('hero-dither-canvas');
  if (!canvas) return;

  const ctx = canvas.getContext('2d');
  if (!ctx) return;

  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  let width, height, dpr;
  let cols, rows;
  let fontSize = 14;
  const COL_W = 11;
  const ROW_H = 18;
  const DIGIT_CHANGE_MIN_MS = 900;
  const DIGIT_CHANGE_SPREAD_MS = 900;

  function digitChangeDelay() {
    return DIGIT_CHANGE_MIN_MS + Math.random() * DIGIT_CHANGE_SPREAD_MS;
  }

  function pseudoNoise(x, y) {
    const n = Math.sin(x * 12.9898 + y * 78.233) * 43758.5453;
    return n - Math.floor(n);
  }

  function fractalNoise(x, y, t, octaves) {
    let value = 0;
    let amp = 0.5;
    for (let i = 0; i < octaves; i++) {
      value += pseudoNoise(x * amp + t * 0.02 * (i + 1), y * amp + t * 0.015 * (i + 1)) * amp;
      amp *= 0.5;
    }
    return value / (1 - Math.pow(0.5, octaves));
  }

  let grid = [];

  function initGrid() {
    grid = [];
    for (let r = 0; r < rows; r++) {
      for (let c = 0; c < cols; c++) {
        grid.push({
          c, r,
          digit: Math.floor(Math.random() * 10),
          nextDigitChange: performance.now() + digitChangeDelay(),
          pushX: 0,
          pushY: 0,
          driftPhase: Math.random() * Math.PI * 2,
          driftSpeed: 0.3 + Math.random() * 0.7,
        });
      }
    }
  }

  function resize() {
    const parent = canvas.parentElement;
    const rect = parent ? parent.getBoundingClientRect() : { width: window.innerWidth, height: window.innerHeight };
    width = rect.width || window.innerWidth;
    height = rect.height || window.innerHeight;
    dpr = window.devicePixelRatio || 1;

    canvas.width = Math.floor(width * dpr);
    canvas.height = Math.floor(height * dpr);
    canvas.style.width = width + 'px';
    canvas.style.height = height + 'px';

    cols = Math.ceil(width / COL_W) + 1;
    rows = Math.ceil(height / ROW_H) + 1;

    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    fontSize = Math.max(9, Math.floor(ROW_H * 0.62));

    initGrid();
  }

  function isDark() {
    return document.documentElement.classList.contains('dark');
  }

  function getColors() {
    const style = getComputedStyle(document.documentElement);
    const ascii = style.getPropertyValue('--text-muted').trim() || '#78716c';
    const highlight = style.getPropertyValue('--accent').trim() || '#ea580c';
    return { ascii, highlight };
  }

  let mouseX = 0, mouseY = 0;
  let targetMouseX = 0, targetMouseY = 0;
  let isPointerActive = false;

  const canvasContainer = canvas.parentElement;

  canvasContainer?.addEventListener('mousemove', (e) => {
    isPointerActive = true;
    const rect = canvas.getBoundingClientRect();
    targetMouseX = e.clientX - rect.left;
    targetMouseY = e.clientY - rect.top;
  }, { passive: true });

  canvasContainer?.addEventListener('mouseleave', () => {
    isPointerActive = false;
    targetMouseX = width * 0.5;
    targetMouseY = height * 0.5;
  }, { passive: true });

  let startTime = 0;
  let animId = 0;
  let isVisible = true;

  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        isVisible = entry.isIntersecting;
        if (isVisible && !animId) {
          startTime = performance.now();
          animId = requestAnimationFrame(render);
        }
      });
    }, { threshold: 0.05 });
    io.observe(canvas);
  }

  function render(now) {
    if (!isVisible) { animId = 0; return; }
    const t = (now - startTime) * 0.001;

    mouseX += (targetMouseX - mouseX) * 0.08;
    mouseY += (targetMouseY - mouseY) * 0.08;

    const mouseOffsetX = (mouseX - width * 0.5) / width * 30;
    const mouseOffsetY = (mouseY - height * 0.5) / height * 30;

    ctx.clearRect(0, 0, width, height);
    ctx.font = `${fontSize}px "IBM Plex Mono", "JetBrains Mono", monospace`;
    ctx.textAlign = 'left';
    ctx.textBaseline = 'top';

    const colors = getColors();
    const baseAlpha = 0.65;

    for (let i = 0; i < grid.length; i++) {
      const p = grid[i];

      const drift = Math.sin(t * 0.08 * p.driftSpeed + p.driftPhase) * 1.2;
      const noiseOffsetY = fractalNoise(p.c * 0.15, p.r * 0.15, t * 0.25, 2) * 1.5;

      const dx = (p.c * COL_W + COL_W * 0.5) - mouseX;
      const dy = (p.r * ROW_H + ROW_H * 0.5) - mouseY;
      const dist = Math.sqrt(dx * dx + dy * dy);
      let targetPushX = 0, targetPushY = 0;
      if (isPointerActive && dist < 280 && dist > 0) {
        const falloff = 1 - dist / 280;
        const force = falloff * falloff * (3 - 2 * falloff) * 12;
        targetPushX = dx / dist * force;
        targetPushY = dy / dist * force;
      }
      p.pushX += (targetPushX - p.pushX) * 0.1;
      p.pushY += (targetPushY - p.pushY) * 0.1;

      const x = p.c * COL_W + p.pushX + mouseOffsetX;
      const y = p.r * ROW_H + drift + noiseOffsetY + p.pushY + mouseOffsetY;

      const highlightNoise = fractalNoise(p.c * 0.12, p.r * 0.12, t * 0.07, 2);
      const shouldHighlight = highlightNoise > 0.75;

      if (now >= p.nextDigitChange) {
        p.digit = Math.floor(Math.random() * 10);
        p.nextDigitChange = now + digitChangeDelay();
      }
      const char = String(p.digit);

      const rowY = p.r * ROW_H;
      const topBoost = rowY < height * 0.45
        ? 1.0 + (1.0 - rowY / (height * 0.45)) * 1.1
        : 1.0;

      if (shouldHighlight) {
        ctx.fillStyle = colors.highlight;
        ctx.globalAlpha = Math.min(1, 0.95 * topBoost);
      } else {
        ctx.fillStyle = colors.ascii;
        ctx.globalAlpha = Math.min(1, baseAlpha * topBoost);
      }

      ctx.fillText(char, x, y);
    }

    ctx.globalAlpha = 1.0;
    animId = requestAnimationFrame(render);
  }

  function boot() {
    resize();

    if (!height || height < 20) {
      const ro = new ResizeObserver(() => {
        if (!canvas.parentElement) return;
        const h = canvas.parentElement.getBoundingClientRect().height;
        if (h > 20) { ro.disconnect(); boot(); }
      });
      if (canvas.parentElement) ro.observe(canvas.parentElement);
      return;
    }

    mouseX = width * 0.5;
    mouseY = height * 0.5;
    targetMouseX = mouseX;
    targetMouseY = mouseY;

    if (prefersReducedMotion) {
      ctx.clearRect(0, 0, width, height);
      ctx.font = `${fontSize}px "IBM Plex Mono", "JetBrains Mono", monospace`;
      ctx.textAlign = 'left';
      ctx.textBaseline = 'top';
      ctx.fillStyle = isDark() ? 'rgba(232,232,234,0.55)' : 'rgba(74,82,96,0.55)';
      ctx.globalAlpha = 1.0;
      for (let i = 0; i < grid.length; i++) {
        const p = grid[i];
        ctx.fillText(String(p.digit), p.c * COL_W, p.r * ROW_H);
      }
    } else {
      if (animId) cancelAnimationFrame(animId);
      isVisible = true;
      startTime = performance.now();
      animId = requestAnimationFrame(render);
    }
  }

  new MutationObserver(() => {
    if (canvas.style.display !== 'none') resize();
  }).observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });

  window.addEventListener('resize', () => { resize(); }, { passive: true });

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => requestAnimationFrame(boot), { once: true });
  } else {
    requestAnimationFrame(boot);
  }

  document.addEventListener('astro:page-load', () => {
    if (animId) { cancelAnimationFrame(animId); animId = 0; }
    requestAnimationFrame(boot);
  }, { once: true });
})();
</script>

<style>
  .hero-dither-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
    opacity: var(--dither-opacity, 0.6);
    mix-blend-mode: normal;
    image-rendering: auto;
  }

  :global(.dark) .hero-dither-bg {
    opacity: var(--dither-opacity, 0.55);
    mix-blend-mode: screen;
  }

  .hero-dither-overlay {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0) 0%,
      rgba(0, 0, 0, 0) 60%,
      var(--bg-base) 100%
    );
  }

  :global(.dark) .hero-dither-overlay {
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0) 0%,
      rgba(0, 0, 0, 0) 60%,
      var(--bg-base) 100%
    );
  }
</style>
