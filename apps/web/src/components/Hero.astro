---
import {
  getLangFromUrl,
  useTranslations,
  useTranslatedPath,
} from "../i18n/utils";
import DitherNumbersCanvas from "./DitherNumbersCanvas.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const tp = useTranslatedPath(lang);
---

<section id="hero" class="hero-editorial">
  <DitherNumbersCanvas />

  <div class="hero-container">
    <div class="hero-grid">
      <!-- Left: Editorial typography -->
      <div class="hero-content reveal">
        <span class="hero-kicker"
          >{
            t("hero.available") || "Available for freelance & collaboration"
          }</span
        >

        <h1 class="hero-title">
          {t("hero.name") || "Md. Fazley Rabbi"}
        </h1>

        <p class="hero-role">Mid-Level Backend Engineer</p>

        {t("hero.tagline") && <p class="hero-tagline">{t("hero.tagline")}</p>}

        {t("hero.body") && <p class="hero-body">{t("hero.body")}</p>}

        <!-- Current Focus -->
        <div class="hero-focus">
          <span class="hero-focus-label">Current Focus</span>
          <div class="hero-focus-tags">
            {(
              t("focus.desc") ||
              "Distributed Systems, Payment Infra, Cloud Infrastructure, AI Workflows"
            )
              .split(",")
              .map((tag) => <span class="hero-focus-tag">{tag.trim()}</span>)}
          </div>
        </div>

        <!-- CTAs: Priority 1 (Resume) -> Priority 2 (Inquire) -> Priority 3 (GitHub) -->
        <div class="hero-actions">
          <a
            href={tp("/resume/")}
            class="btn-primary"
            title="View Resume"
          >
            {t("nav.resume") || "Resume"}
            <svg
              width="14"
              height="14"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"
              ></path></svg
            >
          </a>
          <a href="#contact-cta" class="btn-ghost">
            Inquire / Contact
            <svg
              width="14"
              height="14"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"
              ></path></svg
            >
          </a>
          <a
            href="https://github.com/fazleyrabby"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-ghost"
            title="Inspect GitHub Code & Repositories"
          >
            GitHub
            <svg
              width="13"
              height="13"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"
              ></path></svg
            >
          </a>
        </div>

        <!-- Social links inline -->
        <div class="hero-socials">
          <a
            href="https://github.com/fazleyrabby"
            target="_blank"
            rel="noopener noreferrer">GitHub</a
          >
          <span class="hero-social-dot">·</span>
          <a
            href="https://www.linkedin.com/in/fazley-rabby/"
            target="_blank"
            rel="noopener noreferrer">LinkedIn</a
          >
          <span class="hero-social-dot">·</span>
          <a
            href="https://x.com/fazley111"
            target="_blank"
            rel="noopener noreferrer">Twitter</a
          >
        </div>
      </div>

      <!-- Right: Monochrome Portrait / Binary 01 Dither Canvas -->
      <div class="hero-portrait reveal">
        <div class="hero-portrait-frame" id="hero-portrait-frame">
          <img
            src="/me.webp"
            alt="Fazley Rabbi — Backend Engineer"
            class="hero-portrait-base"
            id="hero-portrait-img"
            width="480"
            height="480"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          <img
            src="/me-hero-reveal.jpg"
            alt="Fazley Rabbi — Hero Mode"
            class="hero-portrait-reveal"
            width="480"
            height="480"
            loading="lazy"
            decoding="async"
          />
          <canvas id="hero-binary-canvas" class="hero-binary-canvas"></canvas>

          <!-- Avatar Mode Switch Pill -->
          <div class="hero-avatar-dock">
            <button type="button" id="hero-avatar-toggle-btn" class="hero-avatar-toggle-btn" title="Toggle Avatar Mode: Photo / Retro Dither">
              <span class="avatar-toggle-opt opt-photo active">PHOTO</span>
              <span class="avatar-toggle-sep">/</span>
              <span class="avatar-toggle-opt opt-binary">DITHER</span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-editorial {
    position: relative;
    padding: clamp(7.5rem, 16vh, 12.5rem) 0 clamp(3.5rem, 7vh, 6.5rem);
    margin-top: -64px; /* Extend dither canvas background up behind navigation bar */
    overflow: hidden;
  }

  .hero-container {
    position: relative;
    z-index: 1;
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 clamp(1.25rem, 4vw, 2rem);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 0.9fr;
    gap: clamp(2.5rem, 5vw, 4.5rem);
    align-items: center;
  }

  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
    .hero-portrait {
      order: -1;
      max-width: 440px;
      margin: 0 auto;
    }
  }

  /* Kicker */
  .hero-kicker {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: var(--accent);
    text-transform: uppercase;
    margin-bottom: 1.5rem;
    animation: subtleKicker 4s ease-in-out infinite;
  }

  @keyframes subtleKicker {
    0%,
    100% {
      opacity: 0.75;
      transform: translateY(0);
    }
    50% {
      opacity: 1;
      transform: translateY(-1.5px);
    }
  }

  /* Title */
  .hero-title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.875rem, 3.5vw, 2.75rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    margin: 0 0 0.5rem;
  }

  /* Role */
  .hero-role {
    font-family: var(--font-sans);
    font-size: 1.125rem;
    color: var(--text-secondary);
    font-weight: 400;
    margin: 0 0 1.5rem;
    letter-spacing: -0.01em;
  }

  /* Tagline */
  .hero-tagline {
    font-family: var(--font-sans);
    font-size: 1.125rem;
    color: var(--text-primary);
    line-height: 1.6;
    margin: 0 0 1rem;
    max-width: 520px;
    opacity: 0.95;
  }

  /* Body */
  .hero-body {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    color: var(--text-primary);
    line-height: 1.7;
    margin: 0 0 2rem;
    max-width: 520px;
    opacity: 0.9;
  }

  :global(.dark) .hero-body {
    color: #ffffff !important;
    opacity: 0.92;
  }

  :global(.dark) .hero-tagline {
    color: #ffffff !important;
    opacity: 0.98;
  }

  :global(.dark) .hero-focus-text {
    color: #ffffff !important;
    opacity: 0.95;
  }

  /* Current focus */
  .hero-focus {
    border-top: 1px solid var(--border);
    padding-top: 1.125rem;
    margin-bottom: 2rem;
  }
  .hero-focus-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-secondary);
    margin-bottom: 0.625rem;
  }
  .hero-focus-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .hero-focus-tag {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-primary);
    background: color-mix(in srgb, var(--text-primary) 3%, var(--bg-base));
    border: 1px solid var(--border);
    padding: 0.25rem 0.625rem;
    border-radius: 4px;
    transition: all 0.2s ease;
  }
  .hero-focus-tag:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  /* Actions */
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  /* Socials */
  .hero-socials {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-sans);
    font-size: 0.8125rem;
  }
  .hero-socials a {
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .hero-socials a:hover {
    color: var(--accent);
  }
  .hero-social-dot {
    color: var(--text-muted);
    opacity: 0.4;
  }

  /* Portrait */
  .hero-portrait {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.75rem;
  }
  .hero-portrait-frame {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--border);
    aspect-ratio: 1;
    width: 100%;
    max-width: 520px;
    cursor: none;
  }
  .hero-portrait-base {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    filter: grayscale(0.9) contrast(1.05);
    transition: filter 0.5s ease;
  }
  .hero-portrait-frame:hover .hero-portrait-base {
    filter: grayscale(0.3) contrast(1);
  }

  .hero-portrait-reveal {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transform: translateY(9px);
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.25s ease;
    mask-image: radial-gradient(
      circle 110px at var(--mouse-x, 50%) var(--mouse-y, 50%),
      rgba(0, 0, 0, 1) 0%,
      rgba(0, 0, 0, 0.85) 60%,
      transparent 100%
    );
    -webkit-mask-image: radial-gradient(
      circle 110px at var(--mouse-x, 50%) var(--mouse-y, 50%),
      rgba(0, 0, 0, 1) 0%,
      rgba(0, 0, 0, 0.85) 60%,
      transparent 100%
    );
  }

  .hero-portrait-frame.is-hovering .hero-portrait-reveal {
    opacity: 1;
  }

  /* Binary 01 Dither Canvas */
  .hero-binary-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 3;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    background: var(--bg-base);
  }

  .hero-portrait-frame.mode-binary .hero-binary-canvas {
    opacity: 1;
    pointer-events: auto;
  }

  .hero-portrait-frame.mode-binary .hero-portrait-base,
  .hero-portrait-frame.mode-binary .hero-portrait-reveal {
    opacity: 0 !important;
  }

  /* Avatar Toggle Dock & Button */
  .hero-avatar-dock {
    position: absolute;
    top: 14px;
    right: 14px;
    z-index: 10;
    pointer-events: auto;
  }

  .hero-avatar-toggle-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 11px;
    background: rgba(250, 250, 249, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid var(--border);
    border-radius: 9999px;
    font-family: var(--font-mono, monospace);
    font-size: 0.65rem;
    letter-spacing: 0.06em;
    color: var(--text-muted);
    cursor: pointer;
    user-select: none;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  :global(.dark) .hero-avatar-toggle-btn {
    background: rgba(15, 15, 15, 0.85);
    border-color: rgba(255, 255, 255, 0.16);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
  }

  .hero-avatar-toggle-btn:hover {
    border-color: var(--accent);
    color: var(--text-primary);
    transform: translateY(-1.5px);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.12);
  }

  .avatar-toggle-opt {
    font-weight: 500;
    transition: color 0.2s, opacity 0.2s;
    opacity: 0.45;
  }

  .avatar-toggle-opt.active {
    opacity: 1;
    color: var(--text-primary);
    font-weight: 700;
  }

  .avatar-toggle-sep {
    opacity: 0.25;
    font-size: 0.6rem;
  }
</style>

<script>
  function setupHeroAvatar() {
    const frame = document.getElementById("hero-portrait-frame");
    const img = document.getElementById("hero-portrait-img") as HTMLImageElement | null;
    const canvas = document.getElementById("hero-binary-canvas") as HTMLCanvasElement | null;
    const toggleBtn = document.getElementById("hero-avatar-toggle-btn");
    if (!frame || !img || !canvas || !toggleBtn) return;

    let avatarMode = (function() {
      try {
        return localStorage.getItem("hero_avatar_mode") || "photo";
      } catch (_) {
        return "photo";
      }
    })();

    const optPhoto = toggleBtn.querySelector(".opt-photo");
    const optBinary = toggleBtn.querySelector(".opt-binary");
    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    function applyModeUI() {
      if (avatarMode === "binary") {
        frame?.classList.add("mode-binary");
        optPhoto?.classList.remove("active");
        optBinary?.classList.add("active");
      } else {
        frame?.classList.remove("mode-binary");
        optBinary?.classList.remove("active");
        optPhoto?.classList.add("active");
      }
    }

    toggleBtn.addEventListener("click", (e) => {
      e.stopPropagation();
      avatarMode = avatarMode === "photo" ? "binary" : "photo";
      try {
        localStorage.setItem("hero_avatar_mode", avatarMode);
      } catch (_) {}
      applyModeUI();
      if (avatarMode === "binary") {
        renderBinaryDither();
      }
    });

    applyModeUI();

    // Typographic Halftone Character Ramp (densest to lightest)
    const CHAR_RAMP = ["8", "S", "0", "9", "5", "8", "0", "·", " "];

    interface HalftoneParticle {
      r: number;
      c: number;
      homeX: number;
      homeY: number;
      x: number;
      y: number;
      vx: number;
      vy: number;
      char: string;
      lum: number;
    }

    let gridData: HalftoneParticle[] = [];
    let cropCoords = { sx: 0, sy: 0, sDim: 480 };
    let mouseX = -9999, mouseY = -9999;
    let animId = 0;
    let numCols = 64;
    let numRows = 48;

    function processImageToBinary() {
      if (!img?.complete || img.naturalWidth === 0) {
        img?.addEventListener("load", processImageToBinary, { once: true });
        return;
      }

      const rect = frame?.getBoundingClientRect();
      const w = rect?.width || 480;
      const h = rect?.height || 480;

      // Exact object-fit: cover 1:1 center crop calculation
      const nw = img.naturalWidth || 480;
      const nh = img.naturalHeight || 480;
      const minDim = Math.min(nw, nh);
      cropCoords = {
        sx: (nw - minDim) / 2,
        sy: (nh - minDim) / 2,
        sDim: minDim
      };

      // Proportional cell sizing ensuring 1:1 face geometry without squishing
      const cellH = 10;
      const cellW = 6.2;
      numCols = Math.floor(w / cellW);
      numRows = Math.floor(h / cellH);

      const offscreen = document.createElement("canvas");
      offscreen.width = numCols;
      offscreen.height = numRows;
      const offCtx = offscreen.getContext("2d");
      if (!offCtx) return;

      offCtx.drawImage(
        img,
        cropCoords.sx,
        cropCoords.sy,
        cropCoords.sDim,
        cropCoords.sDim,
        0,
        0,
        numCols,
        numRows
      );
      const imgData = offCtx.getImageData(0, 0, numCols, numRows).data;

      gridData = [];
      const actualCellW = w / numCols;
      const actualCellH = h / numRows;

      for (let r = 0; r < numRows; r++) {
        for (let c = 0; c < numCols; c++) {
          const idx = (r * numCols + c) * 4;
          const red = imgData[idx];
          const green = imgData[idx + 1];
          const blue = imgData[idx + 2];
          // Perceptual luminance
          const lum = (0.299 * red + 0.587 * green + 0.114 * blue) / 255;

          // Select character based on luminance ramp
          let charIndex = Math.floor((1 - lum) * (CHAR_RAMP.length - 1));
          charIndex = Math.max(0, Math.min(CHAR_RAMP.length - 1, charIndex));
          const char = CHAR_RAMP[charIndex];

          const posX = c * actualCellW + actualCellW / 2;
          const posY = r * actualCellH + actualCellH / 2;

          gridData.push({
            r,
            c,
            homeX: posX,
            homeY: posY,
            x: posX,
            y: posY,
            vx: 0,
            vy: 0,
            char,
            lum
          });
        }
      }

      renderBinaryDither();
    }

    function renderBinaryDither(): boolean {
      if (!ctx || !canvas || gridData.length === 0) return false;

      const rect = frame?.getBoundingClientRect();
      const w = rect?.width || 480;
      const h = rect?.height || 480;
      const dpr = window.devicePixelRatio || 1;

      if (canvas.width !== w * dpr || canvas.height !== h * dpr) {
        canvas.width = w * dpr;
        canvas.height = h * dpr;
      }
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

      const isDark = document.documentElement.classList.contains("dark");
      const actualCellH = h / numRows;
      const fontSize = Math.floor(actualCellH * 0.92);

      // 1. Draw 1:1 center-cropped atmospheric background image (consistent dark terminal canvas)
      ctx.fillStyle = "#0a0a0a";
      ctx.fillRect(0, 0, w, h);

      if (img && img.complete) {
        ctx.save();
        ctx.globalAlpha = 0.28;
        ctx.drawImage(
          img,
          cropCoords.sx,
          cropCoords.sy,
          cropCoords.sDim,
          cropCoords.sDim,
          0,
          0,
          w,
          h
        );
        ctx.restore();
      }

      // 2. Physics & Particle Simulation for Jumping Texts
      ctx.font = `600 ${fontSize}px "IBM Plex Mono", "JetBrains Mono", monospace`;
      ctx.textAlign = "center";
      ctx.textBaseline = "middle";

      const isHovering = frame.classList.contains("is-hovering") && mouseX >= 0 && mouseY >= 0;
      const pushRadius = 80;
      let needsNextFrame = isHovering;

      for (let i = 0; i < gridData.length; i++) {
        const pt = gridData[i];
        if (!pt.char || pt.char === " ") continue;

        // Interactive mouse jump / scatter
        if (isHovering) {
          const dx = pt.x - mouseX;
          const dy = pt.y - mouseY;
          const dist = Math.sqrt(dx * dx + dy * dy);

          if (dist < pushRadius && dist > 0) {
            const force = (1 - dist / pushRadius) * 14;
            const angle = Math.atan2(dy, dx) + (Math.random() - 0.5) * 0.7;
            pt.vx += Math.cos(angle) * force * 0.4 + (Math.random() - 0.5) * 1.6;
            pt.vy += Math.sin(angle) * force * 0.4 + (Math.random() - 0.5) * 1.6;
          }
        }

        // Spring physics back to home position
        const springK = 0.09;
        pt.vx += (pt.homeX - pt.x) * springK;
        pt.vy += (pt.homeY - pt.y) * springK;
        pt.vx *= 0.82;
        pt.vy *= 0.82;
        pt.x += pt.vx;
        pt.y += pt.vy;

        if (
          Math.abs(pt.vx) > 0.02 ||
          Math.abs(pt.vy) > 0.02 ||
          Math.abs(pt.x - pt.homeX) > 0.1 ||
          Math.abs(pt.y - pt.homeY) > 0.1
        ) {
          needsNextFrame = true;
        }

        // Color and Opacity Shading (Consistent across all theme modes)
        const displacement = Math.sqrt((pt.x - pt.homeX) ** 2 + (pt.y - pt.homeY) ** 2);
        const isDisplaced = displacement > 3;

        if (isDisplaced) {
          ctx.fillStyle = "#ea580c"; // Lively accent orange on jumping particles
        } else {
          const alpha = Math.min(1, pt.lum * 1.25 + 0.15);
          ctx.fillStyle = `rgba(244, 244, 245, ${alpha.toFixed(2)})`;
        }

        ctx.fillText(pt.char, pt.x, pt.y);
      }

      return needsNextFrame;
    }

    function startAnimationLoop() {
      cancelAnimationFrame(animId);
      const loop = () => {
        if (avatarMode !== "binary") return;
        const needsMore = renderBinaryDither();
        if (needsMore) {
          animId = requestAnimationFrame(loop);
        }
      };
      loop();
    }

    // Interactive mouse listeners
    frame.addEventListener("mouseenter", () => {
      frame.classList.add("is-hovering");
      if (avatarMode === "binary") {
        startAnimationLoop();
      }
    });

    frame.addEventListener("mousemove", (e: MouseEvent) => {
      const rect = frame.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      mouseX = x;
      mouseY = y;
      frame.style.setProperty("--mouse-x", `${x}px`);
      frame.style.setProperty("--mouse-y", `${y}px`);
      if (avatarMode === "binary") {
        startAnimationLoop();
      }
    });

    frame.addEventListener("mouseleave", () => {
      frame.classList.remove("is-hovering");
      mouseX = -9999;
      mouseY = -9999;
      if (avatarMode === "binary") {
        startAnimationLoop();
      }
    });

    // Theme toggle observer to update colors
    const themeObs = new MutationObserver(() => {
      if (avatarMode === "binary") {
        renderBinaryDither();
      }
    });
    themeObs.observe(document.documentElement, { attributes: true, attributeFilter: ["class"] });

    processImageToBinary();
  }

  setupHeroAvatar();
  document.addEventListener("astro:page-load", setupHeroAvatar);
</script>
