---
import {
  getLangFromUrl,
  useTranslations,
  useTranslatedPath,
} from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const tp = useTranslatedPath(lang);
---

<section id="hero" class="hero-editorial">
  <div class="hero-container">
    <div class="hero-grid">
      <!-- Left: Editorial typography -->
      <div class="hero-content reveal">
        <span class="hero-kicker"
          >{
            t("hero.available") || "Available for freelance & collaboration"
          }</span
        >

        <h1 class="hero-title">
          {t("hero.name") || "Md. Fazley Rabbi"}
        </h1>

        <p class="hero-role">Backend Engineer</p>

        {t("hero.tagline") && <p class="hero-tagline">{t("hero.tagline")}</p>}

        {t("hero.body") && <p class="hero-body">{t("hero.body")}</p>}

        <!-- Current Focus -->
        <div class="hero-focus">
          <span class="hero-focus-label">Current Focus</span>
          <span class="hero-focus-text"
            >{
              t("focus.desc") ||
                "System design, distributed systems, cloud infrastructure, AI-powered developer workflows."
            }</span
          >
        </div>

        <!-- CTAs -->
        <div class="hero-actions">
          <a href={tp("/resume/")} class="btn-primary">
            {t("nav.resume") || "Resume"}
            <svg
              width="14"
              height="14"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"></path></svg
            >
          </a>
          <a href="#projects" class="btn-ghost">
            {t("hero.viewProjects") || "View Projects"}
          </a>
        </div>

        <!-- Social links inline -->
        <div class="hero-socials">
          <a
            href="https://github.com/fazleyrabby"
            target="_blank"
            rel="noopener noreferrer">GitHub</a
          >
          <span class="hero-social-dot">·</span>
          <a
            href="https://www.linkedin.com/in/fazley-rabby/"
            target="_blank"
            rel="noopener noreferrer">LinkedIn</a
          >
          <span class="hero-social-dot">·</span>
          <a
            href="https://x.com/fazley111"
            target="_blank"
            rel="noopener noreferrer">Twitter</a
          >
        </div>
      </div>

      <!-- Right: Monochrome Portrait -->
      <div class="hero-portrait reveal">
        <div class="hero-portrait-frame">
          <img
            src="/me.webp"
            alt="Fazley Rabbi — Backend Engineer"
            class="hero-portrait-base"
            width="480"
            height="480"
            loading="eager"
            fetchpriority="high"
          />
          <img
            src="/me-hero-reveal.jpg"
            alt="Fazley Rabbi — Hero Mode"
            class="hero-portrait-reveal"
            width="480"
            height="480"
            loading="eager"
          />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-editorial {
    position: relative;
    padding: clamp(4.5rem, 11vh, 8.5rem) 0 clamp(3.5rem, 7vh, 6.5rem);
    overflow: hidden;
  }

  .hero-container {
    position: relative;
    z-index: 1;
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 clamp(1.25rem, 4vw, 2rem);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 0.9fr;
    gap: clamp(2.5rem, 5vw, 4.5rem);
    align-items: center;
  }

  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
    .hero-portrait {
      order: -1;
      max-width: 440px;
      margin: 0 auto;
    }
  }

  /* Kicker */
  .hero-kicker {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: var(--accent);
    text-transform: uppercase;
    margin-bottom: 1.5rem;
    animation: subtleKicker 4s ease-in-out infinite;
  }

  @keyframes subtleKicker {
    0%,
    100% {
      opacity: 0.75;
      transform: translateY(0);
    }
    50% {
      opacity: 1;
      transform: translateY(-1.5px);
    }
  }

  /* Title */
  .hero-title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.875rem, 3.5vw, 2.75rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    margin: 0 0 0.5rem;
  }

  /* Role */
  .hero-role {
    font-family: var(--font-sans);
    font-size: 1.125rem;
    color: var(--text-secondary);
    font-weight: 400;
    margin: 0 0 1.5rem;
    letter-spacing: -0.01em;
  }

  /* Tagline */
  .hero-tagline {
    font-family: var(--font-sans);
    font-size: 1.125rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0 0 1rem;
    max-width: 520px;
  }

  /* Body */
  .hero-body {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    color: var(--text-muted);
    line-height: 1.7;
    margin: 0 0 2rem;
    max-width: 520px;
  }

  /* Current focus */
  .hero-focus {
    border-top: 1px solid var(--border);
    padding-top: 1.25rem;
    margin-bottom: 2rem;
  }
  .hero-focus-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 0.375rem;
  }
  .hero-focus-text {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  /* Actions */
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  /* Socials */
  .hero-socials {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-sans);
    font-size: 0.8125rem;
  }
  .hero-socials a {
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .hero-socials a:hover {
    color: var(--accent);
  }
  .hero-social-dot {
    color: var(--text-muted);
    opacity: 0.4;
  }

  /* Portrait */
  .hero-portrait {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.75rem;
  }
  .hero-portrait-frame {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--border);
    aspect-ratio: 1;
    width: 100%;
    max-width: 520px;
    cursor: crosshair;
  }
  .hero-portrait-base {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    filter: grayscale(0.9) contrast(1.05);
    transition: filter 0.5s ease;
  }
  .hero-portrait-frame:hover .hero-portrait-base {
    filter: grayscale(0.3) contrast(1);
  }

  .hero-portrait-reveal {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transform: translateY(9px);
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.25s ease;
    mask-image: radial-gradient(
      circle 110px at var(--mouse-x, 50%) var(--mouse-y, 50%),
      rgba(0, 0, 0, 1) 0%,
      rgba(0, 0, 0, 0.85) 60%,
      transparent 100%
    );
    -webkit-mask-image: radial-gradient(
      circle 110px at var(--mouse-x, 50%) var(--mouse-y, 50%),
      rgba(0, 0, 0, 1) 0%,
      rgba(0, 0, 0, 0.85) 60%,
      transparent 100%
    );
  }

  .hero-portrait-frame.is-hovering .hero-portrait-reveal {
    opacity: 1;
  }
</style>

<script>
  function setupPortraitReveal() {
    const frame = document.querySelector(
      ".hero-portrait-frame",
    ) as HTMLElement | null;
    if (!frame) return;

    frame.addEventListener("mouseenter", () => {
      frame.classList.add("is-hovering");
    });

    frame.addEventListener("mousemove", (e: MouseEvent) => {
      const rect = frame.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      frame.style.setProperty("--mouse-x", `${x}px`);
      frame.style.setProperty("--mouse-y", `${y}px`);
    });

    frame.addEventListener("mouseleave", () => {
      frame.classList.remove("is-hovering");
    });
  }

  setupPortraitReveal();
  document.addEventListener("astro:page-load", setupPortraitReveal);
</script>
