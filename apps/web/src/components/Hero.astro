---
import {
  getLangFromUrl,
  useTranslations,
  useTranslatedPath,
} from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const tp = useTranslatedPath(lang);
---

<section id="hero" class="hero-editorial">

  <!-- Top-Left Floating Artifact: System Architecture Topology Vector -->
  <div class="hero-artifact hero-artifact--top-left hidden lg:flex">
    <div class="artifact-raw artifact-float-1">
      <div class="raw-label-row">
        <span class="status-pulse"></span>
        <span class="raw-label">TOPOLOGY // ACTIVE_CLUSTER</span>
      </div>
      <!-- Frameless SVG Architecture Diagram -->
      <svg width="210" height="44" viewBox="0 0 210 44" fill="none" xmlns="http://www.w3.org/2000/svg">
        <line x1="0" y1="22" x2="210" y2="22" stroke="var(--border)" stroke-dasharray="3 3" opacity="0.5"/>
        
        <!-- Node 1: Edge -->
        <rect x="2" y="10" width="42" height="24" rx="2" fill="none" stroke="var(--text-muted)" stroke-dasharray="2 2" stroke-width="1"/>
        <text x="23" y="25" fill="var(--text-secondary)" font-family="var(--font-mono)" font-size="8" text-anchor="middle" font-weight="600">EDGE</text>

        <!-- Arrow 1 -->
        <path d="M44 22L56 22" stroke="var(--accent)" stroke-width="1.2" stroke-dasharray="2 2"/>

        <!-- Node 2: App Server -->
        <rect x="56" y="7" width="54" height="30" rx="3" fill="none" stroke="var(--accent)" stroke-width="1.2"/>
        <text x="83" y="21" fill="var(--accent)" font-family="var(--font-mono)" font-size="8" text-anchor="middle" font-weight="700">PHP 8.3</text>
        <text x="83" y="29" fill="var(--text-muted)" font-family="var(--font-mono)" font-size="6.5" text-anchor="middle">FRANKENPHP</text>

        <!-- Arrow 2 -->
        <path d="M110 22L122 22" stroke="var(--text-muted)" stroke-width="1"/>

        <!-- Node 3: Redis / Queue -->
        <rect x="122" y="10" width="40" height="24" rx="2" fill="none" stroke="var(--border)" stroke-width="1"/>
        <text x="142" y="25" fill="var(--text-secondary)" font-family="var(--font-mono)" font-size="7.5" text-anchor="middle">REDIS</text>

        <!-- Node 4: ClickHouse -->
        <rect x="168" y="10" width="40" height="24" rx="2" fill="none" stroke="var(--border)" stroke-width="1"/>
        <text x="188" y="25" fill="var(--text-secondary)" font-family="var(--font-mono)" font-size="7.5" text-anchor="middle">OLAP</text>
      </svg>
      <span class="raw-sub">node-primary-ap · 12ms roundtrip</span>
    </div>
  </div>

  <!-- Top-Right Floating Artifact: Live Telemetry Sparkline Waveform -->
  <div class="hero-artifact hero-artifact--top-right hidden lg:flex">
    <div class="artifact-raw artifact-float-2 text-right">
      <div class="raw-label-row justify-end">
        <span class="raw-label">TELEMETRY // THROUGHPUT</span>
        <span class="raw-badge">4.2k req/s</span>
      </div>
      <!-- Frameless Waveform Graph -->
      <svg width="190" height="38" viewBox="0 0 190 38" fill="none" xmlns="http://www.w3.org/2000/svg">
        <line x1="0" y1="10" x2="190" y2="10" stroke="var(--border)" stroke-dasharray="2 2" opacity="0.3"/>
        <line x1="0" y1="20" x2="190" y2="20" stroke="var(--border)" stroke-dasharray="2 2" opacity="0.3"/>
        <line x1="0" y1="30" x2="190" y2="30" stroke="var(--border)" stroke-dasharray="2 2" opacity="0.3"/>
        
        <defs>
          <linearGradient id="waveGrad" x1="0" y1="0" x2="0" y2="38">
            <stop offset="0%" stop-color="var(--accent)" stop-opacity="0.2"/>
            <stop offset="100%" stop-color="var(--accent)" stop-opacity="0.0"/>
          </linearGradient>
        </defs>
        <path d="M0 26 Q 25 18, 50 24 T 100 12 T 140 18 T 170 8 L 190 14 L 190 38 L 0 38 Z" fill="url(#waveGrad)"/>
        <path d="M0 26 Q 25 18, 50 24 T 100 12 T 140 18 T 170 8 L 190 14" stroke="var(--accent)" stroke-width="1.5" stroke-linecap="round" fill="none"/>
        <circle cx="190" cy="14" r="3" fill="var(--accent)"/>
      </svg>
      <div class="raw-stats-row">
        <span>CPU: 18%</span>
        <span>RAM: 1.4/64GB</span>
        <span>ERR: 0.00%</span>
      </div>
    </div>
  </div>

  <div class="hero-container">
    <div class="hero-grid">
      <!-- Left: Editorial typography -->
      <div class="hero-content reveal">
        <span class="hero-kicker"
          >{
            t("hero.available") || "Available for freelance & collaboration"
          }</span
        >

        <h1 class="hero-title">
          {t("hero.name") || "Md. Fazley Rabbi"}
        </h1>

        <p class="hero-role">Backend Engineer</p>

        {t("hero.tagline") && <p class="hero-tagline">{t("hero.tagline")}</p>}

        {t("hero.body") && <p class="hero-body">{t("hero.body")}</p>}

        <!-- Current Focus -->
        <div class="hero-focus">
          <span class="hero-focus-label">Current Focus</span>
          <span class="hero-focus-text"
            >{
              t("focus.desc") ||
                "System design, distributed systems, cloud infrastructure, AI-powered developer workflows."
            }</span
          >
        </div>

        <!-- CTAs -->
        <div class="hero-actions">
          <a href={tp("/resume/")} class="btn-primary">
            {t("nav.resume") || "Resume"}
            <svg
              width="14"
              height="14"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"></path></svg
            >
          </a>
          <a href="#projects" class="btn-ghost">
            {t("hero.viewProjects") || "View Projects"}
          </a>
        </div>

        <!-- Social links inline -->
        <div class="hero-socials">
          <a
            href="https://github.com/fazleyrabby"
            target="_blank"
            rel="noopener noreferrer">GitHub</a
          >
          <span class="hero-social-dot">·</span>
          <a
            href="https://www.linkedin.com/in/fazley-rabby/"
            target="_blank"
            rel="noopener noreferrer">LinkedIn</a
          >
          <span class="hero-social-dot">·</span>
          <a
            href="https://x.com/fazley111"
            target="_blank"
            rel="noopener noreferrer">Twitter</a
          >
        </div>
      </div>

      <!-- Right: Monochrome Portrait -->
      <div class="hero-portrait reveal">
        <div class="hero-portrait-frame">
          <img
            src="/me.webp"
            alt="Fazley Rabbi — Backend Engineer"
            class="hero-portrait-base"
            width="480"
            height="480"
            loading="eager"
            fetchpriority="high"
          />
          <img
            src="/me-hero-reveal.jpg"
            alt="Fazley Rabbi — Hero Mode"
            class="hero-portrait-reveal"
            width="480"
            height="480"
            loading="eager"
          />
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom-Left Floating Artifact: Frameless Terminal / CLI Code Telemetry -->
  <div class="hero-artifact hero-artifact--bottom-left hidden xl:flex">
    <div class="artifact-raw artifact-float-3">
      <div class="raw-label-row">
        <span class="raw-prompt">$</span>
        <span class="raw-label">docker compose ps --healthy</span>
      </div>
      <div class="raw-cli-list">
        <div class="cli-row"><span class="cli-ok">✓</span> app_worker     <span class="cli-status">healthy</span> :8080</div>
        <div class="cli-row"><span class="cli-ok">✓</span> redis_queue    <span class="cli-status">healthy</span> :6379</div>
        <div class="cli-row"><span class="cli-ok">✓</span> clickhouse_db  <span class="cli-status">healthy</span> :8123</div>
      </div>
    </div>
  </div>

  <!-- Bottom-Right Floating Artifact: Frameless Tech Icon Vector Array -->
  <div class="hero-artifact hero-artifact--bottom-right hidden xl:flex">
    <div class="artifact-raw artifact-float-4 text-right">
      <div class="raw-label-row justify-end">
        <span class="raw-label">STACK_ENVIRONMENT</span>
      </div>
      <div class="raw-icon-array">
        <div class="raw-icon" title="Server">
          <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5.25 14.25h13.5m-13.5 3h13.5m-13.5 3h13.5M6 3h12a2 2 0 012 2v6a2 2 0 01-2 2H6a2 2 0 01-2-2V5a2 2 0 012-2z"/></svg>
        </div>
        <div class="raw-icon" title="Docker Container">
          <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 7.5l-9-5.25L3 7.5m18 0l-9 5.25m9-5.25v9l-9 5.25M3 7.5l9 5.25M3 7.5v9l9 5.25m0-9v9"/></svg>
        </div>
        <div class="raw-icon" title="Cloud / Tunnel">
          <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15a4.5 4.5 0 004.5 4.5H18a3.75 3.75 0 001.332-7.257 3 3 0 00-3.758-3.848 5.25 5.25 0 00-10.233 2.33A4.502 4.502 0 002.25 15z"/></svg>
        </div>
        <div class="raw-icon" title="Terminal CLI">
          <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 7.5l3 2.25-3 2.25m4.5 0h3m-9 8.25h13.5A2.25 2.25 0 0021 18V6a2.25 2.25 0 00-2.25-2.25H5.25A2.25 2.25 0 003 6v12a2.25 2.25 0 002.25 2.25z"/></svg>
        </div>
      </div>
      <span class="raw-sub">x86_64 · Ubuntu 24.04 LTS</span>
    </div>
  </div>

</section>

<style>
  .hero-editorial {
    position: relative;
    padding: clamp(4.5rem, 11vh, 8.5rem) 0 clamp(3.5rem, 7vh, 6.5rem);
    overflow: hidden;
  }

  /* Visual Infrastructure Artifacts in Background */
  .hero-artifact {
    position: absolute;
    z-index: 0;
    pointer-events: none;
    user-select: none;
    opacity: 0.28;
    filter: grayscale(0.2);
  }

  .hero-artifact--top-left {
    top: 2rem;
    left: clamp(1rem, 3vw, 2.5rem);
  }

  .hero-artifact--top-right {
    top: 2rem;
    right: clamp(1rem, 3vw, 2.5rem);
  }

  .hero-artifact--bottom-left {
    bottom: 1.5rem;
    left: clamp(1rem, 3vw, 2.5rem);
  }

  .hero-artifact--bottom-right {
    bottom: 1.5rem;
    right: clamp(1rem, 3vw, 2.5rem);
  }

  /* Raw Frameless Artifact Elements */
  .artifact-raw {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  /* Continuous Subtle Floating Animations */
  .artifact-float-1 {
    animation: floatSubtle1 9s ease-in-out infinite alternate;
  }
  .artifact-float-2 {
    animation: floatSubtle2 11s ease-in-out infinite alternate;
  }
  .artifact-float-3 {
    animation: floatSubtle3 10s ease-in-out infinite alternate;
  }
  .artifact-float-4 {
    animation: floatSubtle4 12s ease-in-out infinite alternate;
  }

  @keyframes floatSubtle1 {
    0% { transform: translateY(0px) rotate(0deg); }
    100% { transform: translateY(-8px) rotate(-0.5deg); }
  }

  @keyframes floatSubtle2 {
    0% { transform: translateY(0px) rotate(0deg); }
    100% { transform: translateY(-10px) rotate(0.5deg); }
  }

  @keyframes floatSubtle3 {
    0% { transform: translateY(0px) translateX(0px); }
    100% { transform: translateY(-7px) translateX(4px); }
  }

  @keyframes floatSubtle4 {
    0% { transform: translateY(0px) translateX(0px); }
    100% { transform: translateY(-9px) translateX(-4px); }
  }

  .raw-label-row {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.06em;
  }

  .raw-label {
    font-weight: 600;
    color: var(--text-secondary);
  }

  .raw-badge {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 700;
    color: var(--accent);
    background: var(--accent-dim);
    padding: 0.1rem 0.375rem;
    border-radius: 3px;
  }

  .raw-sub {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    color: var(--text-muted);
    letter-spacing: 0.03em;
  }

  .raw-stats-row {
    display: flex;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    color: var(--text-muted);
  }

  .raw-prompt {
    color: var(--accent);
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.75rem;
  }

  .raw-cli-list {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
  }

  .cli-row {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    color: var(--text-secondary);
  }

  .cli-ok {
    color: #22c55e;
    font-weight: 700;
    font-size: 0.65rem;
  }

  .cli-status {
    color: #22c55e;
    font-weight: 600;
    font-size: 0.58rem;
  }

  .raw-icon-array {
    display: flex;
    gap: 0.5rem;
    justify-content: flex-end;
    padding: 0.15rem 0;
  }

  .raw-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border: 1px dashed var(--border);
    border-radius: 4px;
    color: var(--text-secondary);
  }

  .status-pulse {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: #22c55e;
    box-shadow: 0 0 8px rgba(34, 197, 94, 0.6);
    display: inline-block;
    animation: pulseStatus 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }

  @keyframes pulseStatus {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.85); }
  }

  .hero-container {
    position: relative;
    z-index: 1;
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 clamp(1.25rem, 4vw, 2rem);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 0.9fr;
    gap: clamp(2.5rem, 5vw, 4.5rem);
    align-items: center;
  }

  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
    .hero-portrait {
      order: -1;
      max-width: 440px;
      margin: 0 auto;
    }
  }

  /* Kicker */
  .hero-kicker {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: var(--accent);
    text-transform: uppercase;
    margin-bottom: 1.5rem;
    animation: subtleKicker 4s ease-in-out infinite;
  }

  @keyframes subtleKicker {
    0%,
    100% {
      opacity: 0.75;
      transform: translateY(0);
    }
    50% {
      opacity: 1;
      transform: translateY(-1.5px);
    }
  }

  /* Title */
  .hero-title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.875rem, 3.5vw, 2.75rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    margin: 0 0 0.5rem;
  }

  /* Role */
  .hero-role {
    font-family: var(--font-sans);
    font-size: 1.125rem;
    color: var(--text-secondary);
    font-weight: 400;
    margin: 0 0 1.5rem;
    letter-spacing: -0.01em;
  }

  /* Tagline */
  .hero-tagline {
    font-family: var(--font-sans);
    font-size: 1.125rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0 0 1rem;
    max-width: 520px;
  }

  /* Body */
  .hero-body {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    color: var(--text-muted);
    line-height: 1.7;
    margin: 0 0 2rem;
    max-width: 520px;
  }

  /* Current focus */
  .hero-focus {
    border-top: 1px solid var(--border);
    padding-top: 1.25rem;
    margin-bottom: 2rem;
  }
  .hero-focus-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 0.375rem;
  }
  .hero-focus-text {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  /* Actions */
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  /* Socials */
  .hero-socials {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-sans);
    font-size: 0.8125rem;
  }
  .hero-socials a {
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .hero-socials a:hover {
    color: var(--accent);
  }
  .hero-social-dot {
    color: var(--text-muted);
    opacity: 0.4;
  }

  /* Portrait */
  .hero-portrait {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.75rem;
  }
  .hero-portrait-frame {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--border);
    aspect-ratio: 1;
    width: 100%;
    max-width: 520px;
    cursor: crosshair;
  }
  .hero-portrait-base {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    filter: grayscale(0.9) contrast(1.05);
    transition: filter 0.5s ease;
  }
  .hero-portrait-frame:hover .hero-portrait-base {
    filter: grayscale(0.3) contrast(1);
  }

  .hero-portrait-reveal {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transform: translateY(9px);
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.25s ease;
    mask-image: radial-gradient(
      circle 110px at var(--mouse-x, 50%) var(--mouse-y, 50%),
      rgba(0, 0, 0, 1) 0%,
      rgba(0, 0, 0, 0.85) 60%,
      transparent 100%
    );
    -webkit-mask-image: radial-gradient(
      circle 110px at var(--mouse-x, 50%) var(--mouse-y, 50%),
      rgba(0, 0, 0, 1) 0%,
      rgba(0, 0, 0, 0.85) 60%,
      transparent 100%
    );
  }

  .hero-portrait-frame.is-hovering .hero-portrait-reveal {
    opacity: 1;
  }
</style>

<script>
  function setupPortraitReveal() {
    const frame = document.querySelector(
      ".hero-portrait-frame",
    ) as HTMLElement | null;
    if (!frame) return;

    frame.addEventListener("mouseenter", () => {
      frame.classList.add("is-hovering");
    });

    frame.addEventListener("mousemove", (e: MouseEvent) => {
      const rect = frame.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      frame.style.setProperty("--mouse-x", `${x}px`);
      frame.style.setProperty("--mouse-y", `${y}px`);
    });

    frame.addEventListener("mouseleave", () => {
      frame.classList.remove("is-hovering");
    });
  }

  setupPortraitReveal();
  document.addEventListener("astro:page-load", setupPortraitReveal);
</script>
