---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import AsciiAvatar from "./AsciiAvatar.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="hero" class="py-12 md:py-16 border-b border-[var(--grid-line)]">
  <div class="max-w-[1100px] mx-auto px-4">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      
      <!-- Identity Section -->
      <div class="lg:col-span-7 flex flex-col justify-center">
        

        <h1 class="font-serif font-bold text-4xl md:text-5xl text-theme-primary leading-[1.1] mb-2">
          {t('hero.name') || "Fazley Rabbi"}
        </h1>
        
        <p class="font-mono text-sm text-[var(--accent)] uppercase tracking-wider mb-4">
          Laravel & Backend Engineer
        </p>

        {t("hero.tagline") && (
          <p class="font-sans text-lg text-theme-secondary leading-relaxed mb-4 max-w-[560px]">
            {t("hero.tagline")}
          </p>
        )}

        {t("hero.body") && (
          <p class="font-sans text-base text-theme-secondary leading-relaxed mb-6 max-w-[560px]">
            {t("hero.body")}
          </p>
        )}

        <!-- Current Focus Section -->
        <div class="border-t border-[var(--grid-line)] pt-4 mb-6">
          <span class="font-mono text-xs text-theme-muted uppercase tracking-wider block mb-1">Current Focus</span>
          <span class="font-sans text-sm text-theme-secondary">{t('focus.desc') || "Designing scale-resilient APIs and high-throughput background processing architectures on Laravel and Redis."}</span>
        </div>

        <!-- Call Actions (Compact Editorial Layout) -->
        <div class="flex flex-wrap items-center gap-4">
          <a href="/resume" class="px-4 py-2 rounded bg-[var(--accent)] text-[#080808] font-mono text-xs font-bold uppercase tracking-wider hover:opacity-95 transition-opacity">
            {t('nav.resume') || "Resume"}
          </a>
          <a href="#projects" class="px-4 py-2 rounded bg-[var(--grid-line)] border border-[var(--border)] text-theme-primary font-mono text-xs font-bold uppercase tracking-wider hover:border-[var(--accent)] transition-all">
            {t('hero.viewProjects') || "View Projects"}
          </a>
          <div class="h-4 w-[1px] bg-[var(--border)] hidden sm:block"></div>
          <div class="flex items-center gap-4 font-mono text-xs text-theme-muted">
            <a href="https://github.com/fazleyrabby" target="_blank" class="hover:text-[var(--accent)] transition-colors">GITHUB</a>
            <a href="https://www.linkedin.com/in/fazley-rabby/" target="_blank" class="hover:text-[var(--accent)] transition-colors">LINKEDIN</a>
          </div>
        </div>
      </div>

      <!-- Right Column: ASCII Portrait -->
      <div class="lg:col-span-5 hidden lg:flex items-center justify-center p-4 bg-transparent">
        <div class="w-full flex justify-center items-center overflow-hidden h-[240px]">
          <AsciiAvatar />
        </div>
      </div>

    </div>
  </div>
</section>
