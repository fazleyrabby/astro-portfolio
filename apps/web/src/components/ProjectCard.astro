---
import { Image } from "astro:assets";
import { getLangFromUrl, useTranslations, useTranslatedPath } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const tp = useTranslatedPath(lang);

const { project, index = 10, isHome = false } = Astro.props;
const { title, tech, live, github, thumbnail, description, type, status, problem, highlights, role } = project.data;
const isCritical = !isHome && index < 2;

const baseSlug = project.slug.replace(/-bn$/, '');
const hasCaseStudy = !!(problem || (highlights && highlights.length));
const caseUrl = hasCaseStudy ? tp(`/projects/${baseSlug}`) : null;

// Architectural diagnostic mapper
const getProjectMeta = (slug: string, techStack: string[] = []) => {
  const s = slug.replace(/-bn$/, '');
  
  let arch = "Monolithic / MVC Architecture";
  let infra = "VPS / Linux Deployment";
  
  if (s === "electronic-first") {
    arch = "Transactional / Fraud Detection Engine";
    infra = "Read Replicas / ClickHouse Analytics";
  } else if (s === "signalstack") {
    arch = "Event-Driven Feed Aggregation & AI Failover";
    infra = "Redis Queue / Multi-Tier AI Inference";
  } else if (s === "hujjah") {
    arch = "Semantic Vector Search & LLM Pipeline";
    infra = "Supabase pgvector / Vercel Edge";
  } else if (s === "litepos") {
    arch = "Multi-Business POS / Per-Store Isolation";
    infra = "Isolated DBs / Live Sync";
  } else if (s === "larabrix") {
    arch = "CMS Framework Component Architecture";
    infra = "CI/CD / Package Registry";
  } else if (s === "lenden" || s === "e-bank") {
    arch = "Ledger Transaction / Double-Entry System";
    infra = "Stripe / SSLCommerz Integrations";
  } else if (s === "prompts-library") {
    arch = "Content Directory System";
    infra = "Supabase REST API / Edge Functions";
  }

  return { arch, infra };
};

const { arch, infra } = getProjectMeta(project.slug, tech || []);
---

<article class="v2-project-card group flex flex-col bg-surface overflow-hidden h-full">
  {isHome ? (
    /* Workspace Card Format */
    <div class="flex flex-col flex-grow p-5">
      <div class="flex justify-between items-center mb-3">
        <span class="v2-type-tag">{type || "ENGINEERING SYSTEM"}</span>
        <div class="flex items-center gap-1.5 px-2 py-0.5 rounded bg-[var(--accent-dim)]">
          <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent)]"></span>
          <span class="font-mono text-[0.6rem] font-bold tracking-wider text-[var(--accent)] uppercase">{status || "PRODUCTION"}</span>
        </div>
      </div>

      <h3 class="v2-card-title mb-2">
        {caseUrl ? <a href={caseUrl} class="hover:text-[var(--accent)] transition-colors">{title}</a> : title}
      </h3>

      <p class="v2-card-desc mb-4">
        {description}
      </p>

      <!-- System Diagnostic Specs -->
      <div class="v2-spec-box mb-4">
        <div class="v2-spec-row">
          <span class="v2-spec-k">ROLE:</span>
          <span class="v2-spec-v">{role || "Lead Backend Architect"}</span>
        </div>
        <div class="v2-spec-row">
          <span class="v2-spec-k">ARCH:</span>
          <span class="v2-spec-v truncate max-w-[200px]" title={arch}>{arch}</span>
        </div>
        <div class="v2-spec-row">
          <span class="v2-spec-k">INFRA:</span>
          <span class="v2-spec-v truncate max-w-[200px]" title={infra}>{infra}</span>
        </div>
      </div>

      <!-- Tech Stack Tags -->
      <div class="flex gap-1.5 flex-wrap mb-4 mt-auto">
        {tech?.slice(0, 4).map((t: string) => <span class="v2-tech-tag">{t}</span>)}
        {tech && tech.length > 4 && (
          <span class="v2-tech-tag opacity-60">+{tech.length - 4}</span>
        )}
      </div>

      <!-- Actions -->
      <div class="flex gap-2 w-full pt-3 border-t border-[var(--grid-line)] font-mono text-[0.65rem]">
        {caseUrl && (
          <a class="v2-action-btn v2-action-btn--primary" href={caseUrl}>
            {t('project.viewCase') || "System Case Study"} →
          </a>
        )}
        {!caseUrl && live && (
          <a class="v2-action-btn v2-action-btn--secondary" href={live} target="_blank" rel="noreferrer">
            {t('project.liveDemo') || "Live Endpoint"} ↗
          </a>
        )}
        {github && (
          <a class="v2-action-btn v2-action-btn--ghost" href={github} target="_blank" rel="noreferrer">
            Repository ↗
          </a>
        )}
      </div>
    </div>
  ) : (
    /* Full Archive Page Card Format */
    <a href={caseUrl || live || github || "#"} class="block relative overflow-hidden aspect-video bg-black/20 w-full">
      {thumbnail && (
        <Image
          src={thumbnail}
          class="object-cover object-left-top w-full h-full transition-transform duration-500 group-hover:scale-105"
          alt={`${title} system thumbnail`}
          width={600} height={338} 
          format="webp"
          loading={isCritical ? "eager" : "lazy"}
          fetchpriority={isCritical ? "high" : "auto"}
          quality={85}
        />
      )}
      {type && <span class="v2-type-tag absolute top-3 right-3">{type}</span>}
    </a>

    <div class="flex flex-col flex-grow p-6">
      <div class="flex items-center justify-between mb-2">
        <h3 class="v2-card-title">
          {caseUrl ? <a href={caseUrl} class="hover:text-[var(--accent)] transition-colors">{title}</a> : title}
        </h3>
        {status && (
          <span class="font-mono text-[0.6rem] font-bold uppercase tracking-wider text-[var(--accent)] bg-[var(--accent-dim)] px-2 py-0.5 rounded">
            {status}
          </span>
        )}
      </div>

      <p class="v2-card-desc mb-4">
        {description}
      </p>

      <div class="flex gap-1.5 flex-wrap mb-4 mt-auto">
        {tech?.map((t: string) => <span class="v2-tech-tag">{t}</span>)}
      </div>

      <div class="flex gap-2 w-full pt-4 border-t border-[var(--grid-line)] font-mono text-[0.68rem]">
        {caseUrl && (
          <a class="v2-action-btn v2-action-btn--primary" href={caseUrl}>
            {t('project.viewCase') || "Read Case Study"} →
          </a>
        )}
        {live && (
          <a class="v2-action-btn v2-action-btn--secondary" href={live} target="_blank" rel="noreferrer">
            {t('project.liveDemo') || "Live System"} ↗
          </a>
        )}
        {github && (
          <a class="v2-action-btn v2-action-btn--ghost" href={github} target="_blank" rel="noreferrer">
            Source Code ↗
          </a>
        )}
      </div>
    </div>
  )}
</article>

<style>
  .v2-project-card {
    border: 1px solid var(--grid-line-strong);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--text-primary) 2%, var(--bg-base));
    transition: border-color var(--t-fast) ease, transform var(--t-fast) ease, box-shadow var(--t-fast) ease;
  }

  .v2-project-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 4px 20px rgba(232, 130, 58, 0.08);
  }

  .v2-type-tag {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .v2-card-title {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.25;
    color: var(--text-primary);
  }

  .v2-card-desc {
    font-family: var(--font-sans);
    font-size: 1.05rem;
    line-height: 1.65;
    color: var(--text-secondary);
  }

  .v2-spec-box {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 10px 12px;
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--text-primary) 3%, var(--bg-base));
    border: 1px solid var(--grid-line);
  }

  .v2-spec-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .v2-spec-k {
    color: var(--text-muted);
    font-weight: 700;
    letter-spacing: 0.06em;
  }

  .v2-spec-v {
    color: var(--text-primary);
    font-weight: 600;
  }

  .v2-tech-tag {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    padding: 3px 9px;
    border-radius: 4px;
    background: color-mix(in srgb, var(--text-primary) 5%, var(--bg-base));
    color: var(--text-secondary);
    border: 1px solid var(--grid-line);
  }

  .v2-action-btn {
    flex: 1;
    text-align: center;
    padding: 9px 12px;
    border-radius: var(--radius);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    transition: all var(--t-fast) ease;
    text-decoration: none;
  }

  .v2-action-btn--primary {
    background: var(--accent-dim);
    color: var(--accent);
    border: 1px solid rgba(232, 130, 58, 0.25);
  }

  .v2-action-btn--primary:hover {
    background: var(--accent);
    color: #080808;
  }

  .v2-action-btn--secondary {
    background: color-mix(in srgb, var(--text-primary) 4%, var(--bg-base));
    color: var(--text-primary);
    border: 1px solid var(--grid-line-strong);
  }

  .v2-action-btn--secondary:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .v2-action-btn--ghost {
    background: transparent;
    color: var(--text-muted);
    border: 1px solid transparent;
  }

  .v2-action-btn--ghost:hover {
    color: var(--text-primary);
    border-color: var(--grid-line);
  }
</style>
