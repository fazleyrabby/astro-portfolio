---
// TableOfContents.astro — Floating sidebar TOC with scroll-spy and collapse toggle
// Auto-populates from h2–h4 in #article-content
---

<aside id="toc-sidebar" class="toc-sidebar">
  <nav id="toc" class="toc-nav" aria-label="Table of Contents">
    <div class="flex items-center justify-between mb-4 pb-2 border-b border-[var(--border)]">
      <span class="toc-label mb-0 pb-0 border-b-0">On this page</span>
      <button id="toc-collapse-btn" class="toc-action-btn hover:text-[var(--accent)]" title="Close / Collapse Outline">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>
    <div id="toc-links" class="toc-links"></div>
  </nav>
</aside>

<!-- Floating expand outline trigger tab (desktop) -->
<button id="toc-expand-btn" class="toc-expand-btn hidden" title="Expand Outline">
  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5"/></svg>
</button>

<style>
  /* Floating TOC — fixed on right side on ultra-wide screens */
  .toc-sidebar {
    position: fixed;
    right: calc((100vw - 840px) / 2 - 260px);
    top: 120px;
    width: 220px;
    z-index: 40;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease, transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.25rem 1rem;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.08);
  }
  .toc-sidebar.toc-visible {
    opacity: 1;
    pointer-events: auto;
  }

  /* Collapse / Expand styles */
  .toc-action-btn {
    background: transparent;
    border: none;
    cursor: pointer;
    color: var(--text-muted);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2px;
    transition: color 0.2s ease;
  }
  .toc-expand-btn {
    position: fixed;
    right: 1.5rem;
    top: 50%;
    transform: translateY(-50%);
    width: 32px;
    height: 32px;
    border-radius: 9999px;
    background: var(--bg-base);
    border: 1px solid var(--border);
    color: var(--text-secondary);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 40;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
    transition: all 0.2s ease;
  }
  .toc-expand-btn:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  /* Mobile TOC Modal overlay mode */
  .toc-sidebar.toc-mobile-open,
  :global(.toc-sidebar.toc-mobile-open) {
    display: block !important;
    position: fixed !important;
    bottom: 5.5rem;
    right: 1.5rem;
    top: auto !important;
    transform: none !important;
    width: min(300px, calc(100vw - 3rem));
    max-height: min(450px, 70vh);
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg, 12px);
    padding: 1.25rem 1rem;
    z-index: 60;
    opacity: 1 !important;
    pointer-events: auto !important;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.35);
    animation: slideUp 0.25s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes slideUp {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .toc-sidebar.toc-mobile-open .toc-nav,
  :global(.toc-sidebar.toc-mobile-open) .toc-nav {
    position: relative !important;
    top: 0 !important;
    max-height: calc(min(450px, 70vh) - 3.5rem) !important;
  }

  .toc-nav {
    max-height: calc(100vh - 8rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    padding-right: 0.5rem;

    /* Sleek thin scrollbar */
    scrollbar-width: thin;
    scrollbar-color: var(--border) transparent;
  }

  .toc-nav::-webkit-scrollbar {
    width: 3px;
  }
  .toc-nav::-webkit-scrollbar-track {
    background: transparent;
  }
  .toc-nav::-webkit-scrollbar-thumb {
    background: var(--border);
    border-radius: var(--radius);
  }

  .toc-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-secondary);
  }

  .toc-links {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  /* Injected via JS */
  .toc-links :global(a) {
    display: block;
    font-family: var(--font-sans);
    font-size: 0.7rem;
    line-height: 1.35;
    color: var(--text-secondary);
    text-decoration: none;
    padding: 0.35rem 0.6rem;
    border-left: 2px solid transparent;
    border-radius: 0 var(--radius) var(--radius) 0;
    transition:
      color 0.2s ease,
      border-color 0.2s ease,
      background 0.2s ease,
      opacity 0.2s ease;
    opacity: 0.65;
  }

  .toc-links :global(a:hover) {
    color: var(--text-secondary);
    opacity: 0.85;
    background: var(--accent-dim);
  }

  .toc-links :global(a.toc-active) {
    color: var(--accent-text);
    border-left-color: var(--accent);
    opacity: 1;
    font-weight: 600;
    background: var(--accent-dim);
  }

  /* Indentation levels */
  .toc-links :global(a[data-level="3"]) {
    padding-left: 1.2rem;
    font-size: 0.66rem;
  }
  .toc-links :global(a[data-level="4"]) {
    padding-left: 1.8rem;
    font-size: 0.62rem;
  }

  /* Hide floating TOC on smaller screens — mobile uses the popup button instead */
  @media (max-width: 1379px) {
    .toc-sidebar:not(.toc-mobile-open) {
      display: none !important;
    }
    .toc-sidebar.toc-visible:not(.toc-mobile-open) {
      display: none !important;
    }
    .toc-expand-btn {
      display: none !important;
    }
  }
</style>

<script>
  function initTOC() {
    const article = document.getElementById('article-content');
    const tocLinks = document.getElementById('toc-links');
    const toggleBtn = document.getElementById('toc-toggle-btn') || document.getElementById('mobile-toc-btn');
    const sidebar = document.getElementById('toc-sidebar');
    const collapseBtn = document.getElementById('toc-collapse-btn');
    const expandBtn = document.getElementById('toc-expand-btn');

    if (!article || !tocLinks || !sidebar) return;

    // Singleton lock: Prevent double-binding event listeners due to Astro page-loads!
    if (sidebar.getAttribute('data-toc-init') === 'true') return;
    sidebar.setAttribute('data-toc-init', 'true');

    const headings = [...article.querySelectorAll('h2, h3, h4')] as HTMLElement[];
    if (headings.length === 0) {
      sidebar.style.display = 'none';
      if (toggleBtn) toggleBtn.style.display = 'none';
      return;
    }

    // Ensure every heading has an ID
    headings.forEach((h, index) => {
      if (!h.id) {
        h.id = (h.textContent || '')
          .toLowerCase()
          .trim()
          .replace(/[^\w\s-]/g, '')
          .replace(/[\s_-]+/g, '-')
          .replace(/^-+|-+$/g, '') || `section-${index + 1}`;
      }
    });

    // Collapse / Expand handlers
    if (collapseBtn) {
      collapseBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        if (sidebar.classList.contains('toc-mobile-open')) {
          sidebar.classList.remove('toc-mobile-open');
          return;
        }
        sidebar.classList.remove('toc-visible');
        sidebar.classList.add('toc-collapsed-state');
        if (expandBtn) expandBtn.classList.remove('hidden');
      });
    }

    if (expandBtn) {
      expandBtn.addEventListener('click', () => {
        sidebar.classList.add('toc-visible');
        sidebar.classList.remove('toc-collapsed-state');
        expandBtn.classList.add('hidden');
      });
    }

    // Mobile / Floating Toggle Button Logic
    if (toggleBtn) {
      toggleBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        const isCurrentlyOpen = sidebar.classList.contains('toc-mobile-open');
        if (isCurrentlyOpen) {
          sidebar.classList.remove('toc-mobile-open');
        } else {
          sidebar.classList.add('toc-mobile-open');
        }
      });

      document.addEventListener('click', (e) => {
        if (sidebar.classList.contains('toc-mobile-open')) {
          const target = e.target as Node;
          if (!sidebar.contains(target) && !toggleBtn.contains(target)) {
            sidebar.classList.remove('toc-mobile-open');
          }
        }
      });
    }

    // Build TOC links
    tocLinks.innerHTML = headings.map(h => {
      const level = Number(h.tagName[1]);
      return `<a href="#${h.id}" data-id="${h.id}" data-level="${level}">${h.textContent?.trim() || ''}</a>`;
    }).join('');

    let currentActive: string | null = null;
    let isClickScrolling = false;

    // Smooth scroll on click (works with Lenis)
    tocLinks.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target.tagName === 'A') {
        e.preventDefault();
        const id = target.getAttribute('data-id');
        if (!id) return;
        const el = document.getElementById(id);
        if (el) {
          isClickScrolling = true;
          
          currentActive = id;
          tocLinks.querySelectorAll('a').forEach(a => a.classList.remove('toc-active'));
          target.classList.add('toc-active');

          // Auto-close on mobile after link click
          if (sidebar.classList.contains('toc-mobile-open')) {
            sidebar.classList.remove('toc-mobile-open');
          }

          el.scrollIntoView({ behavior: 'smooth', block: 'start' });
          history.replaceState(null, '', `#${id}`);
          
          setTimeout(() => { isClickScrolling = false; }, 1200);
        }
      }
    });

    // Scroll spy via scroll listener
    const updateScrollSpyAndProgress = () => {
      if (isClickScrolling) return;

      const scrollOffset = 150; // pixels from the top
      let activeHeading: HTMLElement | null = null;

      for (const h of headings) {
        const rect = h.getBoundingClientRect();
        if (rect.top <= scrollOffset) {
          activeHeading = h;
        } else {
          break;
        }
      }

      if (!activeHeading && headings.length > 0) {
        activeHeading = headings[0];
      }

      if (activeHeading) {
        const id = activeHeading.id;
        if (id !== currentActive) {
          currentActive = id;
          tocLinks.querySelectorAll('a').forEach(a => a.classList.remove('toc-active'));
          const link = tocLinks.querySelector(`[data-id="${id}"]`);
          link?.classList.add('toc-active');

          link?.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
        }
      }
    };

    const scrollContainer = document.querySelector('.scroll-container');
    const scrollTarget = scrollContainer || window;
    scrollTarget.addEventListener('scroll', updateScrollSpyAndProgress, { passive: true });
    updateScrollSpyAndProgress();

    // Highlight heading from URL hash on load
    if (window.location.hash) {
      const hashId = window.location.hash.slice(1);
      const link = tocLinks.querySelector(`[data-id="${hashId}"]`);
      link?.classList.add('toc-active');
    }

    // Show/hide TOC based on article scroll position (desktop only)
    const tocObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (sidebar.classList.contains('toc-collapsed-state') || sidebar.classList.contains('toc-mobile-open')) {
          return;
        }
        if (entry.isIntersecting) {
          sidebar.classList.add('toc-visible');
        } else {
          sidebar.classList.remove('toc-visible');
        }
      });
    }, { threshold: 0, rootMargin: '-100px 0px -100px 0px' });
    tocObserver.observe(article);
  }

  // Run on page load and after Astro page transitions
  document.addEventListener('DOMContentLoaded', initTOC);
  document.addEventListener('astro:page-load', initTOC);

  // Fallback: if DOM is already loaded
  if (document.readyState !== 'loading') {
    initTOC();
  }
</script>
