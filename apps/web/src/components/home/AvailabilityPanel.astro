---
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const services = [
  "Production Laravel Applications & Architectures",
  "High-Volume REST API & Webhook Systems",
  "Multi-Gateway Payment Integration & Ledgers",
  "System Performance, Queue Optimization & Docker",
];
---

<section class="v3-avail-card bg-surface border border-[var(--border)] rounded-lg p-6 flex flex-col justify-between h-full shadow-sm">
  <div class="v3-card-head mb-4 pb-3 border-b border-[var(--grid-line)] flex items-center justify-between">
    <span class="font-mono text-xs font-bold tracking-widest text-[var(--accent)] uppercase">AVAILABILITY & SERVICES</span>
    <span class="font-mono text-[0.65rem] font-bold tracking-wider px-2 py-0.5 rounded bg-[var(--accent-dim)] text-[var(--accent)] border border-rgba(234,88,12,0.25)">
      {t("status.available") || "AVAILABLE"}
    </span>
  </div>

  <div class="v3-avail-body my-auto space-y-3">
    <span class="font-mono text-[0.65rem] font-bold uppercase tracking-wider text-theme-muted block">AVAILABLE FOR COLLABORATION</span>
    <ul class="space-y-2">
      {services.map((s) => (
        <li class="font-sans text-base text-theme-primary flex items-start gap-2">
          <span class="text-[var(--accent)] font-bold shrink-0">›</span>
          <span>{s}</span>
        </li>
      ))}
    </ul>
  </div>

  <div class="v3-avail-actions flex gap-2 pt-4 border-t border-[var(--grid-line)] mt-4 font-mono text-xs">
    <a href="mailto:fazley111@gmail.com" class="flex-1 text-center py-2 rounded bg-[var(--accent)] text-[#080808] font-bold uppercase tracking-wider hover:opacity-90 transition-opacity">Email Console</a>
    <a href="/resume" class="flex-1 text-center py-2 rounded bg-[var(--grid-line)] text-theme-primary font-bold uppercase tracking-wider border border-[var(--border)] hover:border-[var(--accent)] hover:text-[var(--accent)] transition-colors">Resume</a>
  </div>
</section>
