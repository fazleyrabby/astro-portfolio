---
const items = [
  { area: "AI Engineering & Tooling", note: "Local LLMs, OpenRouter API, agent workflows" },
  { area: "Observability & Metrics", note: "Structured logging, transaction tracing, ClickHouse OLAP" },
  { area: "Infrastructure Automation", note: "Docker Compose, Proxmox homelab, Redis Horizon queues" },
];
---

<section class="v3-focus-card bg-surface border border-[var(--border)] rounded-lg p-6 flex flex-col justify-between h-full shadow-sm">
  <div class="v3-card-head mb-4 pb-3 border-b border-[var(--grid-line)]">
    <span class="font-mono text-xs font-bold tracking-widest text-[var(--accent)] uppercase">CURRENT EXPERIMENTS & FOCUS</span>
  </div>

  <ul class="v3-focus-list space-y-4 my-auto">
    {items.map((it) => (
      <li class="flex items-start gap-3">
        <span class="w-2 h-2 rounded-full bg-[var(--accent)] mt-1.5 shrink-0"></span>
        <div class="flex flex-col gap-0.5">
          <span class="font-sans font-bold text-base text-theme-primary">{it.area}</span>
          <span class="font-mono text-xs text-theme-muted leading-normal">{it.note}</span>
        </div>
      </li>
    ))}
  </ul>
</section>
