---
import { getCollection, render } from "astro:content";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const all = await getCollection("experiences");
const items = all
  .filter((e) => (e.data.lang || "en") === lang)
  .sort((a, b) => {
    const da = a.data.timeline ? new Date(a.data.timeline) : new Date(0);
    const db = b.data.timeline ? new Date(b.data.timeline) : new Date(0);
    return db.getTime() - da.getTime();
  });

const rendered = await Promise.all(
  items.map(async (e) => {
    const { Content } = await render(e);
    return { ...e, Content };
  })
);
---

<section class="experience-editorial">
  <div class="experience-container">
    <!-- Header -->
    <div class="experience-header reveal">
      <div>
        <span class="section-label">Experience</span>
        <h2 class="experience-title">{t("experience.title") || "Career Journey"}</h2>
      </div>
      <span class="experience-years">2021 — Present</span>
    </div>

    <!-- Timeline -->
    <div class="experience-timeline">
      {rendered.map((item) => (
        <div class="timeline-entry reveal">
          <!-- Timeline indicator -->
          <div class="timeline-marker">
            <div class="timeline-dot"></div>
          </div>

          <!-- Content -->
          <div class="timeline-content">
            <div class="timeline-head">
              <div>
                <a href={item.data.link ?? "#"} target="_blank" rel="noreferrer" class="timeline-company">
                  {item.data.title}
                </a>
                <span class="timeline-role">{item.data.role}</span>
              </div>
              <span class="timeline-date">{item.data.from} — {item.data.to}</span>
            </div>

            <div class="timeline-body">
              <item.Content />
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .experience-editorial {
    padding: var(--space-section) 0;
    border-bottom: 1px solid var(--border);
  }

  .experience-container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 clamp(1.25rem, 4vw, 2rem);
  }

  .experience-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
    gap: 1rem;
  }

  .experience-title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.375rem, 2.5vw, 1.875rem);
    color: var(--text-primary);
    margin: 0;
    letter-spacing: -0.02em;
  }

  .experience-years {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  /* Timeline */
  .experience-timeline {
    position: relative;
    display: flex;
    flex-direction: column;
  }

  .experience-timeline::before {
    content: "";
    position: absolute;
    left: 11.5px;
    top: 10px;
    bottom: 50px;
    width: 1px;
    background: var(--border);
  }

  .timeline-entry {
    display: grid;
    grid-template-columns: 24px 1fr;
    gap: 1.5rem;
    position: relative;
    z-index: 1;
  }

  /* Marker */
  .timeline-marker {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 6px;
  }

  .timeline-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    border: 2px solid var(--accent);
    background: var(--bg-base);
    flex-shrink: 0;
    transition: background 0.2s ease;
    z-index: 2;
  }

  .timeline-entry:hover .timeline-dot {
    background: var(--accent);
  }

  /* Content */
  .timeline-content {
    padding-bottom: clamp(2rem, 4vw, 3rem);
  }

  .timeline-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .timeline-company {
    display: block;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 1.125rem;
    color: var(--text-primary);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .timeline-company:hover {
    color: var(--accent);
  }

  .timeline-role {
    display: block;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--accent);
    margin-top: 0.125rem;
  }

  .timeline-date {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--text-muted);
    letter-spacing: 0.04em;
    white-space: nowrap;
    padding-top: 0.25rem;
  }

  .timeline-body {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.7;
  }
  .timeline-body :global(h2),
  .timeline-body :global(h3),
  .timeline-body :global(h4) {
    font-family: var(--font-sans) !important;
    font-size: 0.9375rem !important;
    font-weight: 600 !important;
    color: var(--text-primary) !important;
    margin: 1.25rem 0 0.375rem 0 !important;
    letter-spacing: 0 !important;
    text-transform: none !important;
  }
  .timeline-body :global(ul) {
    list-style-type: disc;
    padding-left: 1.25rem;
    margin-top: 0.375rem;
    margin-bottom: 0.75rem;
  }
  .timeline-body :global(li) {
    margin-bottom: 0.375rem;
    padding-left: 0.15rem;
  }
  .timeline-body :global(li::marker) {
    color: var(--accent);
  }
</style>
