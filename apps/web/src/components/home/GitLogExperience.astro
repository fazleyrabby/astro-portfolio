---
import { getCollection } from "astro:content";
import { getLangFromUrl, useTranslations, useTranslatedPath } from "../../i18n/utils";
import { profile } from "../../data/profile";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const tp = useTranslatedPath(lang);

const all = await getCollection("experiences");
const items = all
  .filter((e) => (e.data.lang || "en") === lang)
  .sort((a, b) => {
    const da = a.data.timeline ? new Date(a.data.timeline).getTime() : 0;
    const db = b.data.timeline ? new Date(b.data.timeline).getTime() : 0;
    return db - da;
  });

// Decorative short "hash" — stable per entry, not a real commit.
const shortHash = (s: string) => {
  let h = 0x811c9dc5;
  for (const ch of s) h = Math.imul(h ^ ch.charCodeAt(0), 0x01000193);
  return (h >>> 0).toString(16).padStart(8, "0").slice(0, 7);
};

// Freelance work runs alongside full-time roles, so it lives on its own branch lane.
const isSideBranch = (title: string) => /freelance/i.test(title);

const commits = items.map((e, i) => ({
  hash: shortHash(e.id),
  head: i === 0,
  side: isSideBranch(e.data.title),
  company: e.data.title,
  role: e.data.role,
  link: e.data.link && e.data.link !== "#" ? e.data.link : null,
  // Commit body: the entry's opening paragraph from its markdown.
  summary: (e.body ?? "").trim().split(/\n\s*\n/)[0]?.replace(/[*_`#>]/g, "").trim() ?? "",
  range: `${e.data.from} — ${e.data.to}`,
  current: /present/i.test(e.data.to),
}));

const firstEdu = profile.education[0];
---

<section class="gitlog" aria-labelledby="gitlog-title">
  <div class="gitlog-container">
    <div class="gitlog-header reveal">
      <div>
        <span class="section-label">Experience</span>
        <h2 id="gitlog-title" class="gitlog-title">{t("experience.title") || "Career Journey"}</h2>
      </div>
      <a href={tp("/resume/")} class="gitlog-more">
        git show --full <span aria-hidden="true">→</span> résumé
      </a>
    </div>

    <div class="gitlog-term reveal">
      <p class="gitlog-cmd" aria-hidden="true"><span>$</span> git log --graph --oneline career</p>

      <ol class="gitlog-list">
        {commits.map((c) => (
          <li class:list={["commit", { "is-side": c.side }]}>
            <span class="graph" aria-hidden="true">
              <span class="lane lane-main">{c.side ? "|" : "*"}</span>
              <span class="lane lane-side">{c.side ? "*" : "|"}</span>
            </span>
            <span class="hash" aria-hidden="true">{c.hash}</span>
            <span class="msg">
              {c.head && <span class="ref">(HEAD → main)</span>}
              {c.side && <span class="ref ref-side">(freelance)</span>}
              <span class="verb" aria-hidden="true">feat:</span>
              <span class="role">{c.role}</span>
              <span class="at">@</span>
              {c.link ? (
                <a href={c.link} target="_blank" rel="noopener noreferrer" class="company">{c.company}</a>
              ) : (
                <span class="company">{c.company}</span>
              )}
            </span>
            <span class:list={["date", { "is-current": c.current }]}>{c.range}</span>
            {c.summary && <span class="body">{c.summary}</span>}
          </li>
        ))}
        {firstEdu && (
          <li class="commit is-root">
            <span class="graph" aria-hidden="true">
              <span class="lane lane-main">*</span>
              <span class="lane lane-side">/</span>
            </span>
            <span class="hash" aria-hidden="true">0000001</span>
            <span class="msg">
              <span class="verb" aria-hidden="true">init:</span>
              <span class="role">{firstEdu.credential}</span>
              <span class="at">@</span>
              <span class="company">{firstEdu.institution}</span>
            </span>
            <span class="date">{firstEdu.year}</span>
          </li>
        )}
      </ol>
    </div>
  </div>
</section>

<style>
  .gitlog {
    padding: var(--space-section) 0;
    border-bottom: 1px solid var(--border);
  }
  .gitlog-container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 clamp(1.25rem, 4vw, 2rem);
  }
  .gitlog-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: clamp(1rem, 2vw, 1.5rem);
  }
  .gitlog-title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.375rem, 2.5vw, 1.875rem);
    color: var(--text-primary);
    margin: 0;
    letter-spacing: -0.02em;
  }
  .gitlog-more {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-secondary);
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--t-fast) ease;
  }
  .gitlog-more:hover {
    color: var(--accent);
  }

  .gitlog-term {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg-surface);
    padding: clamp(1rem, 2.5vw, 1.5rem);
    overflow-x: auto;
  }
  .gitlog-cmd {
    margin: 0 0 1rem;
    color: var(--text-muted);
  }
  .gitlog-cmd span {
    color: var(--accent);
  }

  .gitlog-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .commit {
    display: grid;
    grid-template-columns: auto auto 1fr auto;
    align-items: baseline;
    gap: 0 1rem;
    padding: 0.625rem 0.5rem;
    border-radius: 4px;
    transition: background var(--t-fast) ease;
  }
  .commit:hover {
    background: var(--accent-dim);
  }

  .graph {
    display: inline-flex;
    gap: 0.5rem;
    color: var(--text-muted);
  }
  .lane-main {
    color: var(--accent);
  }
  .is-side .lane-main,
  .lane-side {
    color: var(--text-muted);
    opacity: 0.6;
  }
  .is-side .lane-side {
    color: #22c55e;
    opacity: 1;
  }

  .hash {
    color: #eab308;
  }
  .msg {
    color: var(--text-primary);
    min-width: 0;
  }
  .ref {
    color: #06b6d4;
    margin-right: 0.5rem;
  }
  .ref-side {
    color: #22c55e;
  }
  .verb {
    color: var(--text-muted);
    margin-right: 0.375rem;
  }
  .at {
    color: var(--text-muted);
    margin: 0 0.375rem;
  }
  .company {
    color: var(--text-primary);
    font-weight: 600;
    text-decoration: none;
  }
  a.company {
    text-decoration: underline;
    text-decoration-color: var(--border);
    text-underline-offset: 3px;
  }
  a.company:hover {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }
  .date {
    color: var(--text-muted);
    white-space: nowrap;
  }
  .body {
    grid-column: 3 / -1;
    margin-top: 0.25rem;
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    line-height: 1.55;
    color: var(--text-secondary);
    max-width: 62ch;
  }
  .date.is-current {
    color: var(--accent-text);
  }
  .is-root .msg,
  .is-root .date {
    color: var(--text-secondary);
  }

  @media (max-width: 720px) {
    .gitlog-header {
      flex-direction: column;
      align-items: flex-start;
    }
    .commit {
      grid-template-columns: auto 1fr;
      gap: 0.25rem 0.75rem;
    }
    .hash {
      display: none;
    }
    .date,
    .body {
      grid-column: 2;
    }
    .date {
      font-size: 0.75rem;
    }
  }
</style>
