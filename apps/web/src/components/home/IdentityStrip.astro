---
import { getCollection } from "astro:content";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";
import OperatorCard from "../OperatorCard.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const projects = await getCollection("projects");
const localized = projects.filter((p) => (p.data.lang || "en") === lang && !p.data.hidden);
const totalCommits = localized.reduce((s, p) => s + (p.data.commits || 0), 0);
const startYear = 2021;
const years = new Date().getFullYear() - startYear;

const meta = [
  { k: "EXP", v: `${years}+ yrs` },
  { k: "PROJECTS", v: `${localized.length}` },
  { k: "COMMITS", v: totalCommits > 0 ? `${(totalCommits / 1000).toFixed(1)}k+` : "—" },
  { k: "LOC", v: "Chittagong, BD · UTC+6" },
  { k: "STACK", v: "Laravel / PHP / MySQL" },
  { k: "INFRA", v: "Docker / VPS / Redis" },
];
---

<section class="v2-hero-strip">
  <div class="v2-hero-grid">
    <!-- Left Hero Column: Exact Original Bio & Identity Details -->
    <div class="v2-hero-info">
      <div class="v2-hero-status">
        <span class="v2-status-text">{t("hero.available")}</span>
      </div>

      <h1 class="v2-hero-name">{t("hero.name") || "Fazley Rabbi"}</h1>
      <p class="v2-hero-role">Laravel & Backend Engineer</p>

      {t("hero.tagline") && (
        <p class="v2-hero-tagline">{t("hero.tagline")}</p>
      )}

      {t("hero.body") && (
        <p class="v2-hero-body">{t("hero.body")}</p>
      )}

      <!-- Primary & Secondary Workstation Actions -->
      <div class="v2-hero-actions">
        <a href="/resume" class="v2-btn v2-btn--primary">Resume</a>
        <a href="#projects" class="v2-btn v2-btn--secondary">Projects</a>
        <a href="mailto:fazley111@gmail.com" class="v2-btn v2-btn--ghost">Contact</a>
        <div class="v2-hero-links">
          <a href="https://github.com/fazleyrabby" target="_blank" rel="noreferrer">GH</a>
          <span class="dot">·</span>
          <a href="https://www.linkedin.com/in/fazley-rabby/" target="_blank" rel="noreferrer">LN</a>
          <span class="dot">·</span>
          <a href="https://fazleyrabbi.xyz" target="_blank" rel="noreferrer">SITE</a>
        </div>
      </div>

      <!-- Original Technical Meta Specs Bar -->
      <div class="v2-meta-grid">
        {meta.map((m) => (
          <div class="v2-meta-item">
            <span class="v2-meta-k">{m.k}</span>
            <span class="v2-meta-v">{m.v}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- Right Hero Column: Operator Card -->
    <div class="v2-hero-operator">
      <OperatorCard />
    </div>
  </div>
</section>

<style>
  .v2-hero-strip {
    padding: 24px 0 32px;
    background: transparent;
  }

  .v2-hero-grid {
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    gap: 36px;
    align-items: center;
    width: 100%;
  }

  @media (max-width: 992px) {
    .v2-hero-grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }

  .v2-hero-info {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .v2-hero-status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 3px 10px;
    border-radius: 999px;
    background: var(--accent-dim);
    border: 1px solid rgba(232, 130, 58, 0.25);
    width: fit-content;
  }

  .v2-status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--accent);
  }

  .v2-status-text {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--accent);
    text-transform: uppercase;
  }

  .v2-hero-name {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 3.5vw, 2.5rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    margin: 0;
  }

  .v2-hero-role {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--accent);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin: 0;
  }

  .v2-hero-tagline {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.1rem;
    line-height: 1.55;
    color: var(--text-secondary);
    max-width: 640px;
    margin: 0;
  }

  .v2-hero-body {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--text-muted);
    max-width: 640px;
    margin: 0;
  }

  .v2-hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    padding-top: 8px;
  }

  .v2-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 10px 18px;
    border-radius: var(--radius);
    transition: all var(--t-fast) ease;
    text-decoration: none;
  }

  .v2-btn--primary {
    background: var(--accent);
    color: #080808;
    border: 1px solid var(--accent);
  }

  .v2-btn--primary:hover {
    background: transparent;
    color: var(--accent);
  }

  .v2-btn--secondary {
    background: color-mix(in srgb, var(--text-primary) 4%, var(--bg-base));
    color: var(--text-primary);
    border: 1px solid var(--grid-line-strong);
  }

  .v2-btn--secondary:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .v2-btn--ghost {
    background: transparent;
    color: var(--text-secondary);
    border: 1px solid var(--grid-line);
  }

  .v2-btn--ghost:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .v2-hero-links {
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.06em;
    color: var(--text-muted);
    margin-left: 6px;
  }

  .v2-hero-links a:hover { color: var(--accent); }
  .v2-hero-links .dot { color: var(--grid-line-strong); }

  .v2-meta-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    padding-top: 16px;
    border-top: 1px solid var(--grid-line-strong);
    margin-top: 6px;
  }

  @media (max-width: 640px) {
    .v2-meta-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .v2-meta-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .v2-meta-k {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .v2-meta-v {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-primary);
  }
</style>
