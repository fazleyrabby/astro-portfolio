---
import { supabase } from "@lib/supabase";
import { getLangFromUrl, useTranslations, useTranslatedPath } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const tp = useTranslatedPath(lang);

const { data, error } = await supabase
  .from("posts")
  .select("slug, title, published_at")
  .eq("status", "published")
  .eq("lang", lang)
  .order("published_at", { ascending: false })
  .limit(6);

if (error) console.error("LatestNotes supabase error:", error);
const posts = data || [];
---

<section class="py-12 border-b border-[var(--grid-line)]">
  <div class="max-w-[1100px] mx-auto px-4">
    <div class="flex items-center justify-between mb-8">
      <h2 class="font-serif font-bold text-2xl md:text-3xl text-theme-primary">{t("nav.blog") || "Engineering Notes"}</h2>
      <a href="/posts" class="font-mono text-xs text-[var(--accent)] uppercase tracking-wider hover:underline">View All Notes →</a>
    </div>

    {posts.length === 0 ? (
      <div class="py-6 text-center font-mono text-xs text-theme-muted">{t("posts.empty")}</div>
    ) : (
      <div class="space-y-4">
        {posts.map((p, i) => (
          <a href={tp(`/posts/${p.slug}`)} class="group flex items-baseline justify-between py-2 border-b border-[var(--grid-line)] border-dashed last:border-none">
            <div class="flex items-baseline gap-4 min-w-0">
              <span class="font-mono text-xs text-theme-muted group-hover:text-[var(--accent)] transition-colors shrink-0">
                {String(i + 1).padStart(2, "0")}.
              </span>
              <span class="font-sans font-medium text-base text-theme-primary group-hover:text-[var(--accent)] transition-colors truncate">
                {p.title}
              </span>
            </div>
            <span class="font-mono text-xs text-theme-muted shrink-0 ml-4">
              {p.published_at
                ? new Date(p.published_at).toLocaleDateString(lang === "bn" ? "bn-BD" : "en-US", {
                    month: "short",
                    year: "numeric",
                  })
                : "—"}
            </span>
          </a>
        ))}
      </div>
    )}
  </div>
</section>
