---
import { getLatestPosts } from "@lib/supabase-cache";
import { getLangFromUrl, useTranslations, useTranslatedPath } from "../../i18n/utils";
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const tp = useTranslatedPath(lang);
const posts = await getLatestPosts(lang, 4);
---

<section class="notes-editorial" aria-labelledby="home-writing-title">
  <header class="notes-header">
    <h2 id="home-writing-title">{t("nav.blog")}</h2>
    <a class="notes-view-all" href={tp("/posts/")}>{lang === "bn" ? "সব লেখা পড়ুন" : "All writing"}</a>
  </header>
  {posts.length === 0 ? (
    <p class="notes-empty">{t("posts.empty")}</p>
  ) : (
    <ul class="notes-list">
      {posts.map((post) => (
        <li>
          <a href={tp(`/posts/${post.slug}/`)}>{post.title}</a>
          {post.published_at && (
            <time datetime={post.published_at}>
              {new Date(post.published_at).toLocaleDateString(lang === "bn" ? "bn-BD" : "en-US", { month: "short", year: "numeric" })}
            </time>
          )}
        </li>
      ))}
    </ul>
  )}
</section>

<style>
  .notes-editorial { min-width: 0; max-width: 1100px; margin: 0 auto; padding: clamp(1.5rem, 3vw, 2.5rem) clamp(1.25rem, 4vw, 2rem); }
  .notes-header { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.5rem 1rem; margin-bottom: 0.75rem; }
  h2 { font-size: clamp(1.5rem, 2.5vw, 2rem); font-weight: 500; margin: 0; }
  .notes-list { list-style: none; margin: 0 0 0.75rem; padding: 0; }
  .notes-list li { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: baseline; gap: 0.5rem 1.5rem; padding: 0.875rem 0; border-bottom: 1px solid var(--border); }
  .notes-list li:first-child { padding-top: 0; }
  .notes-list a { display: block; color: var(--text-primary); font-size: 1rem; font-weight: 500; line-height: 1.5; text-decoration: none; }
  .notes-list a:hover { color: var(--accent-text); }
  time { font-size: 0.8125rem; color: var(--text-secondary); white-space: nowrap; }
  .notes-view-all { display: inline-block; color: var(--accent-text); font-size: 0.9375rem; padding-block: 0.375rem; text-underline-offset: 5px; }
  .notes-empty { color: var(--text-secondary); line-height: 1.6; }
  @media (max-width: 480px) {
    .notes-list li { grid-template-columns: 1fr; gap: 0.25rem; }
  }
</style>
