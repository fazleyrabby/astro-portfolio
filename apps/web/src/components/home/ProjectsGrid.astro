---
import { getCollection } from "astro:content";
import { getLangFromUrl, useTranslations, useTranslatedPath } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const tp = useTranslatedPath(lang);
const projects = (await getCollection("projects"))
  .filter((p) => (p.data.lang || "en") === lang && !p.data.hidden && p.data.category !== "experimental")
  .sort((a, b) => (a.data.position ?? 999) - (b.data.position ?? 999))
  .slice(0, 4);
---

<div class="selected-work">
  <header class="work-header">
    <h2 id="selected-work-title">{t("projects.title")}</h2>
    <a href={tp("/projects/")}>{t("projects.viewAll")}</a>
  </header>
  <div class="work-grid">
    {projects.map(({ data, slug }) => {
      const hasCase = !!(data.problem || data.highlights?.length);
      const href = hasCase ? tp(`/projects/${slug.replace(/-bn$/, "")}/`) : (data.live || data.github || tp("/projects/"));
      return (
        <article class="work-item">
          {data.thumbnail && (
            <a class="work-image" href={href} aria-label={`${lang === "bn" ? "দেখুন" : "View"} ${data.title}`}>
              <img src={data.thumbnail} alt="" loading="lazy" decoding="async" width="800" height="450" />
            </a>
          )}
          <div class="work-body">
          <h3><a href={href}>{data.title}</a></h3>
          <p>{data.description}</p>
          {data.tech?.length > 0 && <p class="work-tech">{data.tech.slice(0, 4).join(" · ")}</p>}
          <div class="work-actions">
          <a class="work-link" href={href}>
            {hasCase ? (lang === "bn" ? "কেস স্টাডি পড়ুন" : "Read case study") : (lang === "bn" ? "প্রজেক্ট দেখুন" : "View project")}
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </a>
          {data.live && <a class="work-secondary" href={data.live} target="_blank" rel="noopener noreferrer">{lang === "bn" ? "লাইভ" : "Live"}</a>}
          {data.github && <a class="work-secondary" href={data.github} target="_blank" rel="noopener noreferrer">GitHub</a>}
          </div>
          </div>
        </article>
      );
    })}
  </div>
</div>

<style>
  .selected-work { padding: clamp(1.5rem, 3vw, 2.5rem); }
  .work-header { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.75rem 1.5rem; margin-bottom: 1.5rem; }
  .work-header h2 { margin: 0; font-size: clamp(1.5rem, 2.5vw, 2rem); font-weight: 600; }
  .work-header > a, .work-link { font-size: 0.9375rem; color: var(--accent-text); text-underline-offset: 5px; }
  .work-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(1.5rem, 3vw, 2.5rem); }
  .work-item { min-width: 0; overflow: hidden; background: var(--bg-surface); border: 1px solid var(--border); border-radius: 14px; display: flex; flex-direction: column; }
  .work-body { padding: 1.25rem; flex: 1; display: flex; flex-direction: column; }
  .work-actions { margin-top: auto; display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1.25rem; }
  .work-secondary { color: var(--text-secondary); font-size: 0.8125rem; text-underline-offset: 4px; padding-block: 0.375rem; }
  .work-image { display: block; aspect-ratio: 2 / 1; overflow: hidden; background: var(--bg-surface); }
  .work-image img { width: 100%; height: 100%; object-fit: cover; transition: transform var(--t-mid) var(--ease-out-expo); }
  .work-image:hover img { transform: scale(1.025); }
  .work-item h3 { margin: 0 0 0.75rem; font-size: clamp(1.25rem, 2vw, 1.5rem); font-weight: 600; }
  .work-item h3 a { color: var(--text-primary); text-decoration: none; }
  .work-item h3 a:hover { color: var(--accent-text); }
  .work-item p { font-size: 0.9375rem; line-height: 1.6; color: var(--text-secondary); margin: 0 0 0.75rem; }
  .work-item .work-tech { font-size: 0.8125rem; }
  .work-link { display: inline-flex; align-items: center; gap: 0.5rem; padding-block: 0.375rem; }
  @media (max-width: 640px) {
    .work-grid { grid-template-columns: 1fr; gap: 1.5rem; }
  }
  @media (prefers-reduced-motion: reduce) { .work-image img { transition: none; } }
</style>
