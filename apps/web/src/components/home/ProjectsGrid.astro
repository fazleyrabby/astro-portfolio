---
import { getCollection } from "astro:content";
import { getLangFromUrl, useTranslations, useTranslatedPath } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const tp = useTranslatedPath(lang);

const all = await getCollection("projects");
const localized = all
  .filter((p) => (p.data.lang || "en") === lang && !p.data.hidden)
  .sort((a, b) => (a.data.position || 0) - (b.data.position || 0))
  .slice(0, 3); // Top 3 projects

// SVG Architecture schemas mapping for featured section
const archMap: Record<string, { arch: string; infra: string }> = {
  "electronic-first": { arch: "Transactional / Fraud Detection", infra: "Read Replicas / ClickHouse" },
  signalstack: { arch: "Event-Driven Feed / AI Failover", infra: "Redis Queue / Multi-Tier AI" },
  hujjah: { arch: "Semantic Vector Search / LLM", infra: "Supabase pgvector / Vercel Edge" },
  dailylog: { arch: "Monolithic / Life OS Dashboard", infra: "Docker / PostgreSQL" },
  mealhq: { arch: "Restaurant Platform / POS", infra: "Docker / MySQL" },
  edubase: { arch: "Modular Monolith / Education Intelligence", infra: "Redis Horizon / Meilisearch / Docker" },
  litepos: { arch: "Multi-Business POS System", infra: "Per-Store Config / Live Sync" },
  larabrix: { arch: "CMS Framework Components", infra: "CI/CD / Package Registry" },
  lenden: { arch: "Ledger / Double-Entry", infra: "Stripe / SSLCommerz" },
  "e-bank": { arch: "Ledger / Double-Entry", infra: "Stripe / SSLCommerz" },
};

const getMeta = (slug: string) => {
  const s = slug.replace(/-bn$/, "");
  return archMap[s] || { arch: "Monolithic / MVC", infra: "VPS / Linux" };
};
---

<section id="projects" class="py-12 border-b border-[var(--grid-line)]">
  <div class="max-w-[1100px] mx-auto px-4">
    
    <div class="flex items-center justify-between mb-8">
      <h2 class="font-serif font-bold text-2xl md:text-3xl text-theme-primary">{t("projects.title") || "Featured Production Systems"}</h2>
      <a href="/projects" class="font-mono text-xs text-[var(--accent)] uppercase tracking-wider hover:underline">{t("projects.viewAll") || "View All"} →</a>
    </div>

    <!-- Spacious Case Study Previews (Stack list instead of grid cards) -->
    <div class="space-y-12">
      {localized.map((project) => {
        const { title, description, type, status, problem, solution, impact, thumbnail } = project.data;
        const baseSlug = project.slug.replace(/-bn$/, "");
        const hasCase = !!(problem || (project.data.highlights && project.data.highlights.length));
        const href = hasCase ? tp(`/projects/${baseSlug}`) : (project.data.live || project.data.github || "#");
        
        return (
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start pt-8 first:pt-0 border-t border-[var(--grid-line)] first:border-none">
            
            <!-- Left block: SVG / Screenshot info -->
            <div class="lg:col-span-5 flex flex-col gap-4">
              {thumbnail ? (
                <div class="rounded-md overflow-hidden border border-[var(--border)] bg-[var(--bg-base)] aspect-video">
                  <img
                    src={thumbnail}
                    alt={`${title} thumbnail`}
                    class="w-full h-full object-cover"
                    loading="lazy"
                  />
                </div>
              ) : (
                <div class="rounded-md border border-[var(--border)] p-4 bg-[var(--bg-base)] flex items-center justify-center aspect-video text-theme-muted font-mono text-xs">
                  NO SCHEMA DETECTED
                </div>
              )}
              
              <!-- One High-level telemetry metric -->
              <div class="flex items-center justify-between px-3 py-2 rounded bg-[var(--bg-base)] border border-[var(--border)] font-mono text-[11px] text-theme-secondary">
                <span>SYSTEM CLASS //</span>
                <span class="text-[var(--accent)] font-semibold">{type?.toUpperCase() || 'BACKEND ENGINE'}</span>
              </div>
            </div>

            <!-- Right block: Case study preview details -->
            <div class="lg:col-span-7 flex flex-col justify-start">
              <div class="flex items-center gap-3 mb-2 font-mono text-xs text-theme-muted">
                <span>{type?.toUpperCase() || 'BACKEND'}</span>
                <span class="opacity-30">•</span>
                <span class="text-[var(--accent)]">{status?.toUpperCase() || 'ACTIVE'}</span>
              </div>

              <h3 class="font-serif font-bold text-2xl text-theme-primary mb-3">{title}</h3>
              <p class="text-theme-secondary text-sm leading-relaxed mb-4">{description}</p>

              <!-- One Challenge & One Outcome previews -->
              <div class="space-y-3 mb-6">
                {problem && (
                  <div class="flex flex-col gap-0.5">
                    <span class="font-mono text-tiny text-theme-muted uppercase tracking-wider">Challenge</span>
                    <p class="text-theme-secondary text-xs line-clamp-2">{problem}</p>
                  </div>
                )}
                {impact && (
                  <div class="flex flex-col gap-0.5">
                    <span class="font-mono text-tiny text-[var(--accent)] uppercase tracking-wider">Outcome</span>
                    <p class="text-theme-primary font-medium text-xs line-clamp-2">{impact}</p>
                  </div>
                )}
              </div>

              <!-- CTA link to case study -->
              <a href={href} class="self-start px-3 py-1.5 rounded bg-[var(--grid-line)] border border-[var(--border)] font-mono text-xs text-theme-primary font-bold uppercase tracking-wider hover:border-[var(--accent)] transition-all">
                Explore Case Study →
              </a>
            </div>

          </div>
        );
      })}
    </div>

  </div>
</section>
