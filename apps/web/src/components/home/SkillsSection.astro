---
const skillsMatrix = [
  {
    category: "Backend & Systems",
    items: [
      { name: "Laravel", isPrimary: true },
      { name: "PHP 8.x", isPrimary: true },
      { name: "REST APIs", isPrimary: false },
      { name: "Livewire", isPrimary: false },
      { name: "Queue Workers", isPrimary: false },
      { name: "Event-Driven Architecture", isPrimary: true }
    ]
  },
  {
    category: "Databases & Analytics",
    items: [
      { name: "MySQL", isPrimary: true },
      { name: "ClickHouse", isPrimary: true },
      { name: "Redis", isPrimary: true },
      { name: "SQLite", isPrimary: false },
      { name: "Read Replicas", isPrimary: false },
      { name: "Query Optimization", isPrimary: true }
    ]
  },
  {
    category: "Infrastructure & DevOps",
    items: [
      { name: "Docker", isPrimary: true },
      { name: "Docker Compose", isPrimary: false },
      { name: "Linux (Ubuntu)", isPrimary: true },
      { name: "Nginx", isPrimary: false },
      { name: "VPS Hardening", isPrimary: false },
      { name: "GitHub Actions", isPrimary: false }
    ]
  },
  {
    category: "Security & Integrations",
    items: [
      { name: "Fraud Engines", isPrimary: true },
      { name: "PayPal API", isPrimary: false },
      { name: "Checkout.com", isPrimary: false },
      { name: "Stripe", isPrimary: true },
      { name: "Webhooks", isPrimary: true },
      { name: "Local LLMs / Groq", isPrimary: false }
    ]
  }
];
---

<section id="skills" class="skills-editorial">
  <div class="skills-container">

    <div class="skills-layout">
      <!-- Left: Title & Overview -->
      <div class="skills-intro reveal">
        <div class="section-badge">
          <span class="badge-num">04</span>
          <span class="badge-label">Capabilities</span>
        </div>
        <h2 class="section-title">Technical Capabilities</h2>
        <p class="section-desc">
          Core backend frameworks, high-throughput datastores, infrastructure tooling, and payment security systems.
        </p>
      </div>

      <!-- Right: Enhanced Matrix without dots -->
      <div class="skills-matrix reveal">
        {skillsMatrix.map((group) => (
          <div class="matrix-group">
            <h3 class="group-title">
              <span>{group.category}</span>
              <span class="group-count">0{group.items.length}</span>
            </h3>
            <div class="group-tags">
              {group.items.map((item) => (
                <span
                  class:list={["matrix-tag", { "matrix-tag--primary": item.isPrimary }]}
                  data-primary={item.isPrimary ? "true" : "false"}
                >
                  {item.name}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>

<script>
  function initSkillsInteraction() {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    const tags = document.querySelectorAll<HTMLElement>("#skills .matrix-tag");
    tags.forEach((tag) => {
      tag.addEventListener("mousemove", (e: MouseEvent) => {
        const rect = tag.getBoundingClientRect();
        const x = e.clientX - rect.left - rect.width / 2;
        const y = e.clientY - rect.top - rect.height / 2;
        tag.style.transform = `translate(${x * 0.25}px, ${y * 0.25}px) scale(1.05)`;
      });

      tag.addEventListener("mouseleave", () => {
        tag.style.transform = "translate(0px, 0px) scale(1)";
      });
    });
  }

  initSkillsInteraction();
  document.addEventListener("astro:page-load", initSkillsInteraction);
</script>

<style>
  .skills-editorial {
    padding: clamp(4rem, 8vh, 7rem) 0;
    border-bottom: 1px solid var(--border);
  }

  .skills-container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 clamp(1.25rem, 4vw, 2rem);
  }

  .skills-layout {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(3rem, 6vw, 5rem);
    align-items: start;
  }

  @media (max-width: 860px) {
    .skills-layout {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }

  /* Intro */
  .section-badge {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 0.75rem;
  }
  .badge-num {
    font-weight: 700;
  }
  .section-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    font-weight: 500;
    color: var(--text-primary);
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin: 0 0 1rem;
  }
  .section-desc {
    font-family: var(--font-sans);
    font-size: 1rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  /* Matrix */
  .skills-matrix {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .matrix-group {
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
    transition: opacity 0.3s ease;
  }

  .matrix-group:last-child {
    padding-bottom: 0;
    border-bottom: none;
  }

  .skills-matrix:hover .matrix-group {
    opacity: 0.55;
  }
  .skills-matrix:hover .matrix-group:hover {
    opacity: 1;
  }

  .group-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-primary);
    margin: 0 0 0.875rem;
  }

  .group-count {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--text-muted);
    opacity: 0.7;
  }

  .group-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .matrix-tag {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    padding: 0.38rem 0.8rem;
    border-radius: var(--radius);
    background: var(--bg-card);
    color: var(--text-secondary);
    border: 1px solid var(--border);
    cursor: default;
    user-select: none;
    transition: transform 0.18s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.2s ease, color 0.2s ease, background-color 0.2s ease, box-shadow 0.2s ease;
  }

  .matrix-tag--primary {
    color: var(--text-primary);
    font-weight: 500;
    border-color: color-mix(in srgb, var(--text-primary) 22%, var(--border));
    background: color-mix(in srgb, var(--text-primary) 3%, var(--bg-card));
  }

  .matrix-tag:hover {
    color: var(--accent) !important;
    border-color: var(--accent) !important;
    background: color-mix(in srgb, var(--accent) 8%, var(--bg-card));
    box-shadow: 0 4px 12px color-mix(in srgb, var(--accent) 15%, transparent);
  }
</style>


