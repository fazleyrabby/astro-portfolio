---
const groups = [
  { k: "BACKEND", v: ["Laravel", "PHP", "Node.js", "REST APIs"] },
  { k: "INFRASTRUCTURE", v: ["Docker", "Linux VPS", "Nginx", "Redis"] },
  { k: "DATABASE", v: ["MySQL", "ClickHouse", "Supabase"] },
  { k: "CLOUD & DEVOPS", v: ["AWS", "Cloudflare", "GitHub Actions"] },
  { k: "AI & TOOLING", v: ["Local LLMs", "Ollama", "OpenRouter"] },
  { k: "FRONTEND & WEB", v: ["JavaScript", "Astro", "Tailwind CSS"] },
];
---

<section class="v3-stack-card bg-surface border border-[var(--border)] rounded-lg p-6 flex flex-col h-full shadow-sm">
  <div class="v3-card-head mb-4 pb-3 border-b border-[var(--grid-line)] flex items-center justify-between">
    <span class="font-mono text-xs font-bold tracking-widest text-[var(--accent)] uppercase">WORKBENCH STACK & TOOLING</span>
  </div>

  <div class="v3-stack-grid grid grid-cols-1 sm:grid-cols-2 gap-4 my-auto">
    {groups.map((g) => (
      <div class="v3-stack-group flex flex-col gap-1.5">
        <span class="font-mono text-[0.62rem] font-bold tracking-wider text-theme-muted uppercase">{g.k}</span>
        <div class="flex flex-wrap gap-1.5">
          {g.v.map((tag) => (
            <span class="font-mono text-xs px-2 py-0.5 rounded bg-[var(--grid-line)] text-theme-primary border border-[var(--border)]">{tag}</span>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>
