---
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="v3-value-prop">
  <div class="v3-prop-grid">
    <!-- Left Column: What I Build -->
    <div class="v3-prop-card bg-surface border border-[var(--border)] rounded-lg p-6 md:p-8">
      <div class="v3-card-head mb-4 pb-3 border-b border-[var(--grid-line)]">
        <span class="font-mono text-xs font-bold tracking-widest text-[var(--accent)] uppercase">{t('valueprop.whatIBuild.title') || "WHAT I BUILD"}</span>
        <h3 class="font-display font-bold text-xl md:text-2xl text-theme-primary mt-1">{t('valueprop.whatIBuild.desc') || "Commercial-grade applications engineered for speed, security, and scalability."}</h3>
      </div>
      
      <div class="v3-items-space space-y-4">
        <div class="v3-prop-item">
          <h4 class="font-sans font-bold text-base md:text-lg text-theme-primary flex items-center gap-2">
            <span class="w-2 h-2 rounded-sm bg-[var(--accent)]"></span> {t('valueprop.whatIBuild.saas')}
          </h4>
          <p class="font-sans text-base text-theme-secondary pl-4 leading-relaxed mt-1">{t('valueprop.whatIBuild.saasDesc')}</p>
        </div>

        <div class="v3-prop-item">
          <h4 class="font-sans font-bold text-base md:text-lg text-theme-primary flex items-center gap-2">
            <span class="w-2 h-2 rounded-sm bg-[var(--accent)]"></span> {t('valueprop.whatIBuild.ecommerce')}
          </h4>
          <p class="font-sans text-base text-theme-secondary pl-4 leading-relaxed mt-1">{t('valueprop.whatIBuild.ecommerceDesc')}</p>
        </div>

        <div class="v3-prop-item">
          <h4 class="font-sans font-bold text-base md:text-lg text-theme-primary flex items-center gap-2">
            <span class="w-2 h-2 rounded-sm bg-[var(--accent)]"></span> {t('valueprop.whatIBuild.payments')}
          </h4>
          <p class="font-sans text-base text-theme-secondary pl-4 leading-relaxed mt-1">{t('valueprop.whatIBuild.paymentsDesc')}</p>
        </div>

        <div class="v3-prop-item">
          <h4 class="font-sans font-bold text-base md:text-lg text-theme-primary flex items-center gap-2">
            <span class="w-2 h-2 rounded-sm bg-[var(--accent)]"></span> {t('valueprop.whatIBuild.apis')}
          </h4>
          <p class="font-sans text-base text-theme-secondary pl-4 leading-relaxed mt-1">{t('valueprop.whatIBuild.apisDesc')}</p>
        </div>
      </div>
    </div>

    <!-- Right Column: Why Companies Hire Me -->
    <div class="v3-prop-card bg-surface border border-[var(--border)] rounded-lg p-6 md:p-8">
      <div class="v3-card-head mb-4 pb-3 border-b border-[var(--grid-line)]">
        <span class="font-mono text-xs font-bold tracking-widest text-[var(--accent)] uppercase">{t('valueprop.whyHire.title') || "WHY COMPANIES HIRE ME"}</span>
        <h3 class="font-display font-bold text-xl md:text-2xl text-theme-primary mt-1">{t('valueprop.whyHire.desc') || "Engineering discipline focused on direct business outcomes, uptime, and maintainability."}</h3>
      </div>

      <div class="v3-items-space space-y-4">
        <div class="v3-prop-item">
          <h4 class="font-sans font-bold text-base md:text-lg text-theme-primary flex items-center gap-2">
            <span class="w-2 h-2 rounded-sm bg-[var(--accent-secondary)]"></span> {t('valueprop.whyHire.experience')}
          </h4>
          <p class="font-sans text-base text-theme-secondary pl-4 leading-relaxed mt-1">{t('valueprop.whyHire.experienceDesc')}</p>
        </div>

        <div class="v3-prop-item">
          <h4 class="font-sans font-bold text-base md:text-lg text-theme-primary flex items-center gap-2">
            <span class="w-2 h-2 rounded-sm bg-[var(--accent-secondary)]"></span> {t('valueprop.whyHire.laravel')}
          </h4>
          <p class="font-sans text-base text-theme-secondary pl-4 leading-relaxed mt-1">{t('valueprop.whyHire.laravelDesc')}</p>
        </div>

        <div class="v3-prop-item">
          <h4 class="font-sans font-bold text-base md:text-lg text-theme-primary flex items-center gap-2">
            <span class="w-2 h-2 rounded-sm bg-[var(--accent-secondary)]"></span> {t('valueprop.whyHire.architecture')}
          </h4>
          <p class="font-sans text-base text-theme-secondary pl-4 leading-relaxed mt-1">{t('valueprop.whyHire.architectureDesc')}</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .v3-prop-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }
  @media (max-width: 900px) {
    .v3-prop-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
