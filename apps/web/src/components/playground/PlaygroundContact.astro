---
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="contact" class="pg-contact">
  <div class="pg-contact-container">

    <!-- Final Destination Visual Sheet -->
    <div class="pg-contact-card">
      <div class="pg-contact-header">
        <span class="pg-section-kicker">✦ FINAL DESTINATION</span>
        <h2 class="pg-contact-title">Let's Build Something Memorable</h2>
        <p class="pg-contact-desc">
          Available for freelance projects, technical architecture consulting, and backend collaborations.
        </p>
      </div>

      <div class="pg-contact-grid">
        <!-- Direct Contact Actions -->
        <div class="pg-contact-methods">
          <a href="mailto:fazley111@gmail.com" class="pg-contact-pill" data-cursor="SAY HELLO">
            <span class="pg-pill-icon">✉️</span>
            <span class="pg-pill-text">fazley111@gmail.com</span>
          </a>

          <div class="pg-socials-row">
            <a href="https://github.com/fazleyrabby" target="_blank" rel="noopener noreferrer" class="pg-social-badge" data-cursor="GITHUB">
              GitHub
            </a>
            <a href="https://www.linkedin.com/in/fazley-rabby/" target="_blank" rel="noopener noreferrer" class="pg-social-badge" data-cursor="LINKEDIN">
              LinkedIn
            </a>
            <a href="https://x.com/fazley111" target="_blank" rel="noopener noreferrer" class="pg-social-badge" data-cursor="TWITTER">
              Twitter
            </a>
          </div>
        </div>
      </div>

      <!-- Footer Bar with Secret Easter Egg F -->
      <div class="pg-footer-bar">
        <span id="pg-footer-egg" class="pg-footer-copy" data-cursor="SECRET EGG">
          © {new Date().getFullYear()} Md. Fazley Rabbi. All rights reserved. ✦
        </span>
        <span class="pg-footer-mode">Built with Astro & Interactive Playground Physics</span>
      </div>

    </div>

  </div>
</section>

<style>
  .pg-contact {
    padding: 4rem 1.5rem 6rem;
    background: var(--pg-bg);
  }

  .pg-contact-container {
    max-width: 1120px;
    margin: 0 auto;
  }

  .pg-contact-card {
    background: var(--pg-surface);
    border: 2px solid var(--pg-ink);
    border-radius: 24px;
    padding: clamp(2rem, 5vw, 4rem);
    box-shadow: 8px 8px 0px var(--pg-ink);
    text-align: center;
  }

  .pg-section-kicker {
    font-family: var(--font-mono, monospace);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--pg-terracotta);
    text-transform: uppercase;
  }

  .pg-contact-title {
    font-family: var(--font-display, serif);
    font-size: clamp(2rem, 4vw, 3.25rem);
    font-weight: 700;
    color: var(--pg-ink);
    margin: 0.5rem 0 0.75rem;
    letter-spacing: -0.02em;
  }

  .pg-contact-desc {
    font-family: var(--font-sans, sans-serif);
    font-size: 1.0625rem;
    color: var(--pg-ink-muted);
    max-width: 560px;
    margin: 0 auto 2.5rem;
    line-height: 1.6;
  }

  .pg-contact-methods {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 3rem;
  }

  .pg-contact-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.85rem 1.75rem;
    border-radius: 999px;
    background: var(--pg-mustard);
    border: 2px solid var(--pg-ink);
    box-shadow: 4px 4px 0px var(--pg-ink);
    font-family: var(--font-mono, monospace);
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--pg-ink);
    text-decoration: none;
    transition: transform 0.2s var(--pg-ease-bounce), box-shadow 0.2s ease;
  }

  .pg-contact-pill:hover {
    transform: translateY(-3px) scale(1.03);
    box-shadow: 6px 6px 0px var(--pg-ink);
    background: var(--pg-terracotta);
    color: #FFFFFF;
  }

  .pg-socials-row {
    display: flex;
    gap: 0.75rem;
  }

  .pg-social-badge {
    padding: 0.4rem 1rem;
    border-radius: 999px;
    border: 1.5px solid var(--pg-ink);
    background: var(--pg-bg);
    font-family: var(--font-mono, monospace);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--pg-ink);
    text-decoration: none;
    box-shadow: 2px 2px 0px var(--pg-ink);
    transition: transform 0.2s ease;
  }

  .pg-social-badge:hover {
    transform: translateY(-2px);
    background: var(--pg-forest);
    color: #FFFFFF;
  }

  .pg-footer-bar {
    border-top: 1.5px dashed var(--pg-border);
    padding-top: 1.5rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    font-family: var(--font-mono, monospace);
    font-size: 0.75rem;
    color: var(--pg-ink-muted);
  }

  .pg-footer-copy {
    cursor: pointer;
    transition: color 0.2s ease;
  }

  .pg-footer-copy:hover {
    color: var(--pg-terracotta);
  }
</style>
