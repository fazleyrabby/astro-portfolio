---
import { getLangFromUrl, useTranslations, useTranslatedPath } from "../../i18n/utils";
import LangToggle from "@components/LangToggle.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const currentPathname = Astro.url.pathname;
const cleanPath = currentPathname.replace(/^\/bn/, "").replace(/\/$/, "");

const navItems = [
  { href: translatePath("/"), label: t("nav.home") || "Home", match: cleanPath === "" || cleanPath === "/" },
  { href: translatePath("/projects/"), label: t("nav.projects") || "Projects", match: cleanPath.startsWith("/projects") },
  { href: translatePath("/posts/"), label: t("nav.blog") || "Blog", match: cleanPath.startsWith("/posts") },
  { href: translatePath("/about/"), label: t("nav.about") || "About", match: cleanPath.startsWith("/about") },
  { href: translatePath("/resume/"), label: t("nav.resume") || "Resume", match: cleanPath.startsWith("/resume") },
];
---

<!-- Custom Physics Cursor Element -->
<div id="pg-cursor" aria-hidden="true">
  <span class="pg-cursor-label">EXPLORE</span>
</div>

<header class="pg-nav-container">
  <div class="pg-nav-dock">
    <!-- Brand Logo -->
    <a href={translatePath("/")} class="pg-nav-logo" data-cursor="HOME">
      <span class="pg-logo-badge">FR</span>
      <span class="pg-logo-name">Fazley Rabbi</span>
    </a>

    <!-- Nav Items Dock -->
    <nav class="pg-nav-links" aria-label="Playground Main Navigation">
      {navItems.map((item) => (
        <a
          href={item.href}
          class:list={["pg-nav-pill", { "is-active": item.match }]}
          data-cursor={item.label.toUpperCase()}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <!-- Utility Controls -->
    <div class="pg-nav-utilities">
      <LangToggle altUrl={Astro.props.altUrl} />

      <button id="pg-theme-btn" class="pg-utility-btn" title="Toggle Theme" aria-label="Toggle theme" data-cursor="THEME">
        <svg class="icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
        <svg class="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/></svg>
      </button>

      <!-- Mobile Trigger -->
      <button id="pg-mobile-trigger" class="pg-utility-btn pg-mobile-only" aria-label="Open navigation menu">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
    </div>
  </div>
</header>

<style>
  .pg-nav-container {
    position: fixed;
    top: 1rem;
    left: 0;
    right: 0;
    z-index: 950;
    display: flex;
    justify-content: center;
    padding: 0 1rem;
    pointer-events: none;
  }

  .pg-nav-dock {
    pointer-events: auto;
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 0.45rem 0.85rem;
    background: color-mix(in srgb, var(--pg-surface, #FFFFFF) 88%, transparent);
    backdrop-filter: blur(16px) saturate(1.4);
    -webkit-backdrop-filter: blur(16px) saturate(1.4);
    border: 1.5px solid var(--pg-ink);
    border-radius: 999px;
    box-shadow: 4px 4px 0px var(--pg-ink);
    transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .pg-nav-dock:hover {
    transform: translateY(-1px);
  }

  .pg-nav-logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--pg-ink);
  }

  .pg-logo-badge {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--pg-terracotta);
    color: #FFFFFF;
    font-family: var(--font-mono, monospace);
    font-size: 0.75rem;
    font-weight: 700;
  }

  .pg-logo-name {
    font-family: var(--font-mono, monospace);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .pg-nav-links {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .pg-nav-pill {
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    font-family: var(--font-mono, monospace);
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--pg-ink-muted);
    text-decoration: none;
    transition: all 0.18s ease;
  }

  .pg-nav-pill:hover,
  .pg-nav-pill.is-active {
    color: var(--pg-ink);
    background: var(--pg-mustard);
    font-weight: 700;
  }

  .pg-nav-utilities {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    border-left: 1px dashed var(--pg-border);
    padding-left: 0.75rem;
  }

  .pg-utility-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 1px solid var(--pg-ink);
    background: var(--pg-surface);
    color: var(--pg-ink);
    cursor: pointer;
    transition: transform 0.2s ease, background-color 0.2s ease;
  }

  .pg-utility-btn:hover {
    transform: scale(1.1);
    background: var(--pg-terracotta);
    color: #FFFFFF;
  }

  .icon-moon { display: none; }
  :global(.dark) .icon-sun { display: none; }
  :global(.dark) .icon-moon { display: block; }

  .pg-mobile-only { display: none; }

  @media (max-width: 768px) {
    .pg-nav-links { display: none; }
    .pg-mobile-only { display: flex; }
  }
</style>

<script>
  const themeBtn = document.getElementById("pg-theme-btn");
  themeBtn?.addEventListener("click", () => {
    const isDark = document.documentElement.classList.contains("dark");
    if (isDark) {
      document.documentElement.classList.remove("dark");
      localStorage.setItem("color-mode", "light");
    } else {
      document.documentElement.classList.add("dark");
      localStorage.setItem("color-mode", "dark");
    }
  });
</script>
