---
import Sketch from "./Sketch.astro";

interface Props {
  title: string;
  lede?: string;
  kicker?: string;
  motif?: "yard" | "pier" | "lighthouse" | "coast" | "bay" | string;
}
const { title, lede, kicker, motif } = Astro.props;
---

<header class="modern-page-header">
  <div class="modern-header-inner">
    {kicker && <p class="modern-header-kicker">{kicker}</p>}
    <h1 class="modern-header-title">{title}</h1>
    {lede && <p class="modern-header-lede">{lede}</p>}
    <slot />
    {motif && <Sketch name={motif} class="modern-header-sketch" />}
  </div>
</header>

<style>
  .modern-page-header {
    border-bottom: 1px solid var(--border);
    background: var(--bg-base);
    padding: 48px 0 36px;
    transition: background-color 260ms ease, border-color 260ms ease;
  }
  .modern-header-inner {
    width: min(900px, calc(100% - 48px));
    margin: 0 auto;
    position: relative;
    animation: modern-header-arrive 600ms var(--ease-out-expo) both;
  }
  @keyframes modern-header-arrive {
    from { transform: translateY(12px); }
    to { transform: translateY(0); }
  }
  .modern-header-kicker {
    margin: 0 0 8px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent-text);
  }
  .modern-header-title {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: clamp(2rem, 4vw, 2.75rem);
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    margin: 0;
  }
  .modern-header-lede {
    max-width: 58ch;
    margin: 12px 0 0;
    font-size: 16px;
    line-height: 1.6;
    color: var(--text-secondary);
  }
  /* Spot drawing sits in the free right-hand column; it never shares space with text. */
  .modern-header-inner :global(.modern-header-sketch) {
    position: absolute;
    right: 0;
    bottom: -14px;
    width: 236px;
  }
  @media (max-width: 860px) {
    .modern-header-inner :global(.modern-header-sketch) { display: none; }
  }
  @media (min-width: 861px) {
    .modern-header-lede { max-width: min(58ch, calc(100% - 276px)); }
  }
  @media (max-width: 640px) {
    .modern-page-header { padding: 36px 0 24px; }
    .modern-header-inner { width: calc(100% - 40px); }
    .modern-header-lede { font-size: 15px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .modern-header-inner { animation: none !important; }
  }
</style>
