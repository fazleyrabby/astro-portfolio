</style>

<script>
  // Time of day is tied to story chapters, not raw scroll distance: every element with
  // [data-time-stop="0..1"] pins that moment of the day to its position on the page.
  type Stop = { t: number; c: Record<string, string> };

  const PALETTE: Stop[] = [
    { t: 0, c: { "sky-1": "#7fa6d9", "sky-2": "#f7c9b0", "sky-3": "#ffb487", "hill-far": "#c9b3d1", "hill-mid": "#a58fc0", "hill-near": "#7d6fa3", city: "#8f7fb4", "sea-1": "#f2a98a", "sea-2": "#5f6fa8", struct: "#3a3566", fore: "#2a2550", "sun-color": "#ffd9a0" } },
    { t: 0.25, c: { "sky-1": "#5fb4e6", "sky-2": "#a8dcf2", "sky-3": "#e6f5f2", "hill-far": "#b9dcd6", "hill-mid": "#8cc4b4", "hill-near": "#5fa596", city: "#6f9fa6", "sea-1": "#7fd0dc", "sea-2": "#2a8fa8", struct: "#2b4a63", fore: "#1d3a4d", "sun-color": "#fff0b8" } },
    { t: 0.5, c: { "sky-1": "#3e9fe0", "sky-2": "#8fd1f2", "sky-3": "#ddf3f7", "hill-far": "#b4dccb", "hill-mid": "#7fbf9c", "hill-near": "#4e9a7a", city: "#5f93a0", "sea-1": "#58c2d6", "sea-2": "#1e7f9c", struct: "#25435c", fore: "#1a3447", "sun-color": "#fff4c2" } },
    { t: 0.75, c: { "sky-1": "#3a2a6e", "sky-2": "#c4517c", "sky-3": "#f7a066", "hill-far": "#a2608f", "hill-mid": "#7a4a86", "hill-near": "#4a2f66", city: "#5b3a78", "sea-1": "#d9637a", "sea-2": "#3a2a6e", struct: "#24173f", fore: "#170e2b", "sun-color": "#ff9a5a" } },
    { t: 1, c: { "sky-1": "#060a22", "sky-2": "#0d1740", "sky-3": "#1d2b66", "hill-far": "#1f2c68", "hill-mid": "#18235a", "hill-near": "#101a45", city: "#0d1538", "sea-1": "#152258", "sea-2": "#070c28", struct: "#070b20", fore: "#04071a", "sun-color": "#ff7a4a" } },
  ];
  // Pre-parse once; scroll frames only do arithmetic.
  const RGB = PALETTE.map((s) =>
    Object.fromEntries(Object.entries(s.c).map(([k, h]) => [k, [1, 3, 5].map((i) => parseInt(h.slice(i, i + 2), 16))])),
  );
  const KEYS = Object.keys(PALETTE[0].c);
  const clamp01 = (n: number) => Math.min(1, Math.max(0, n));

  function setupScene() {
    const scene = document.querySelector<HTMLElement>("[data-port-scene]");
    if (!scene || scene.dataset.ready) return;
    scene.dataset.ready = "1";

    const root = document.documentElement;
    const sun = scene.querySelector<HTMLElement>("[data-sun]")!;
    const moon = scene.querySelector<HTMLElement>("[data-moon]")!;
    const ship = scene.querySelector<HTMLElement>("[data-ship]")!;
    const glint = scene.querySelector<HTMLElement>("[data-glint]")!;
    const layers = Array.from(scene.querySelectorAll<HTMLElement>("[data-depth]"));
    const STAGE_W = Number(scene.dataset.stageW);
    const STAGE_H = Number(scene.dataset.stageH);
    const SKYLINE_Y = 96; // highest point of the artwork (mountain peaks, crane tips) on the stage
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    let vw = 0;
    let vh = 0;
    let scale = 1;
    let anchors: { y: number; t: number }[] = [];

    const measure = () => {
      vw = window.innerWidth;
      vh = window.innerHeight;
      // Fill the width, but keep the harbor between ~42% and ~60% of the screen height.
      scale = Math.min(Math.max(vw / STAGE_W, (vh * 0.42) / STAGE_H), (vh * 0.6) / STAGE_H);
      // Keep the artwork below the hero copy. If the screen is too short for that
      // without shrinking the harbor to a sliver, the copy gets a paper backing instead.
      const copy = document.querySelector<HTMLElement>("[data-hero-copy]");
      if (copy) {
        const room = vh - (copy.getBoundingClientRect().bottom + window.scrollY) - 20;
        const fit = room / (STAGE_H - SKYLINE_Y);
        const floor = scale * 0.62;
        root.classList.toggle("hero-backed", fit < floor);
        if (fit < scale) {
          scale = Math.max(fit, floor);
        } else {
          // Spare room (tall screens): grow the harbor into it, within reason.
          const roomy = (room - 48) / (STAGE_H - SKYLINE_Y);
          scale = Math.min(Math.max(scale, roomy), scale * 1.35);
        }
      }
      scene.style.setProperty("--s", scale.toFixed(4));

      anchors = Array.from(document.querySelectorAll<HTMLElement>("[data-time-stop]"))
        .map((el) => {
          const r = el.getBoundingClientRect();
          return { y: r.top + window.scrollY + r.height / 2, t: Number(el.dataset.timeStop) };
        })
        .sort((a, b) => a.y - b.y);
    };

    // Piecewise-linear time of day at the viewport centre.
    const timeAt = (y: number) => {
      if (anchors.length === 0) {
        const max = document.documentElement.scrollHeight - vh;
        return max > 0 ? clamp01(window.scrollY / max) : 0;
      }
      if (y <= anchors[0].y) return anchors[0].t;
      for (let i = 1; i < anchors.length; i++) {
        const [a, b] = [anchors[i - 1], anchors[i]];
        if (y <= b.y) return a.t + ((y - a.y) / (b.y - a.y)) * (b.t - a.t);
      }
      return anchors[anchors.length - 1].t;
    };

    let lastP = -1;
    let lastDark: boolean | null = null;
    let lastPhase = "";

    const paint = (force = false) => {
      const p = clamp01(timeAt(window.scrollY + vh / 2));
      if (!force && Math.abs(p - lastP) < 0.0006) return;
      lastP = p;

      // Light
      let i = 1;
      while (i < PALETTE.length - 1 && p > PALETTE[i].t) i++;
      const k = (p - PALETTE[i - 1].t) / (PALETTE[i].t - PALETTE[i - 1].t);
      for (const key of KEYS) {
        const [a, b] = [RGB[i - 1][key], RGB[i][key]];
        scene.style.setProperty(
          `--${key}`,
          `rgb(${Math.round(a[0] + (b[0] - a[0]) * k)} ${Math.round(a[1] + (b[1] - a[1]) * k)} ${Math.round(a[2] + (b[2] - a[2]) * k)})`,
        );
      }
      const night = clamp01((p - 0.7) / 0.25);
      scene.style.setProperty("--night", night.toFixed(3));

      // Sun: rises on the right, arcs over, sets behind the hills on the left.
      const day = clamp01(p / 0.84);
      const sunX = (0.8 - day * 0.62) * vw;
      const sunY = (0.66 - Math.sin(day * Math.PI) * 0.52 + night * 0.4) * vh;
      sun.style.transform = `translate3d(${sunX.toFixed(1)}px, ${sunY.toFixed(1)}px, 0)`;
      const moonX = 0.76 * vw;
      moon.style.transform = `translate3d(${moonX.toFixed(1)}px, ${((0.6 - night * 0.42) * vh).toFixed(1)}px, 0)`;

      // Reflection follows whichever is in the sky, in stage coordinates.
      const moonUp = night > 0.5;
      const orbX = moonUp ? moonX : sunX;
      glint.style.transform = `translate3d(${(STAGE_W / 2 + (orbX - vw / 2) / scale).toFixed(1)}px, 0, 0)`;
      glint.style.setProperty("--glint", moonUp ? "#e9e6d6" : "var(--sun-color)");
      glint.style.opacity = (moonUp ? (night - 0.5) * 0.9 : (1 - night * 2) * 0.55).toFixed(2);

      // Ship enters from the left at dawn and leaves to the right at night.
      ship.style.transform = `translate3d(${(-420 + p * 2240).toFixed(1)}px, 0, 0)`;

      // Parallax: nearer layers travel further.
      if (!reduceMotion) {
        for (const l of layers) l.style.transform = `translate3d(${(-p * 46 * Number(l.dataset.depth)).toFixed(1)}px, 0, 0)`;
      }

      const phase = night <= 0.02 ? "is-day" : night >= 0.98 ? "is-night" : "";
      if (phase !== lastPhase) {
        scene.classList.remove("is-day", "is-night");
        if (phase) scene.classList.add(phase);
        lastPhase = phase;
      }

      // Ink flips with the light so text stays readable. Not persisted: the
      // visitor's saved theme still applies on every other page.
      const dark = p > 0.62;
      if (dark !== lastDark) {
        root.classList.toggle("dark", dark);
        lastDark = dark;
      }
    };

    let queued = false;
    const onScroll = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => {
        queued = false;
        paint();
      });
    };
    const refresh = () => {
      measure();
      paint(true);
    };

    refresh();
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", refresh);
    window.addEventListener("load", refresh);
    // Layout shifts as images and fonts load; re-measure when the page height changes.
    let resizeQueued = false;
    new ResizeObserver(() => {
      if (resizeQueued) return;
      resizeQueued = true;
      requestAnimationFrame(() => {
        resizeQueued = false;
        refresh();
      });
    }).observe(document.body);
    // Nothing animates while the tab is in the background.
    document.addEventListener("visibilitychange", () => scene.classList.toggle("is-paused", document.hidden));
  }

  setupScene();
  document.addEventListener("astro:page-load", setupScene);
</script>
