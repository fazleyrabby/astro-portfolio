  @media (max-width: 900px) {
    /* The headline spans the full width here, so the sky stays empty behind it. */
    .port-scene .clouds,
    .port-scene .birds {
      display: none;
    }
  }

  /* Things that only exist at one end of the day are switched off at the other,
     so they stop animating and drop their layers. */
  .port-scene.is-day .stars,
  .port-scene.is-day .beam,
  .port-scene.is-day .moon,
  .port-scene.is-night .birds,
  .port-scene.is-night .sun {
