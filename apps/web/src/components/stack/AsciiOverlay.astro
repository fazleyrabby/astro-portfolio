---
---

<div class="ascii" data-ascii hidden aria-hidden="true">
  <canvas class="ascii__canvas" data-ascii-canvas></canvas>
  <p class="mono ascii__hint">ASCII MODE · press <kbd>A</kbd> or <kbd>Esc</kbd> to exit</p>
</div>

<script>
  import { createExhibit } from "../../stack/exhibits";
  import { getState } from "../../stack/store";

  const root = document.querySelector<HTMLElement>("[data-ascii]");
  const canvas = root?.querySelector<HTMLCanvasElement>("[data-ascii-canvas]");
  if (root && canvas) {
    let mounted = false;
    const show = () => {
      const s = getState();
      root.hidden = false;
      if (!mounted) {
        createExhibit("ascii").mount(canvas, {
          mode: "debug",
          reducedMotion: s.reducedMotion,
          lowPower: s.quality === "performance",
        });
        mounted = true;
      }
    };
    const hide = () => {
      root.hidden = true;
    };

    window.addEventListener("keydown", (event) => {
      const tag = (event.target as HTMLElement)?.tagName;
      if (tag === "INPUT" || tag === "TEXTAREA") return;
      if (event.key === "a" || event.key === "A") {
        if (event.metaKey || event.ctrlKey || event.altKey) return;
        event.preventDefault();
        root.hidden ? show() : hide();
      } else if (event.key === "Escape" && !root.hidden) {
        hide();
      }
    });

    root.addEventListener("click", (event) => {
      if ((event.target as HTMLElement).closest("[data-ascii]")) hide();
    });
  }
</script>

<style>
  .ascii[hidden] {
    display: none;
  }
  .ascii {
    position: fixed;
    inset: 0;
    z-index: 90;
    background: var(--void);
    cursor: pointer;
  }
  .ascii__canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
  .ascii__hint {
    position: fixed;
    bottom: var(--space-4);
    left: 50%;
    transform: translateX(-50%);
    color: var(--text-mid);
    margin: 0;
  }
</style>
