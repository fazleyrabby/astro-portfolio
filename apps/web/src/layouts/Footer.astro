---
import { getLangFromUrl, useTranslations, useTranslatedPath } from "../i18n/utils";
import VisitorCounter from "../components/VisitorCounter.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<footer class="site-footer">
  <div class="footer-inner">
    <!-- Top section -->
    <div class="footer-grid">
      <!-- Brand -->
      <div class="footer-brand">
        <a href={translatePath("/")} class="footer-logo">
          <span class="footer-logo-text">Fazley Rabbi</span><span class="footer-logo-dot">.</span>
        </a>
        <p class="footer-tagline">{t('footer.tagline') || "Building scalable systems, not just interfaces."}</p>
      </div>

      <!-- Navigation -->
      <div class="footer-col">
        <span class="footer-col-title">Navigate</span>
        <a href={translatePath("/")}>{t('nav.home') || "Home"}</a>
        <a href={translatePath("/projects/")}>{t('nav.projects') || "Projects"}</a>
        <a href={translatePath("/experiments/")}>{t('nav.experiments') || "Experiments"}</a>
        <a href={translatePath("/posts/")}>{t('nav.blog') || "Blog"}</a>
        <a href={translatePath("/resume/")}>{t('nav.resume') || "Resume"}</a>
      </div>

      <!-- More -->
      <div class="footer-col">
        <span class="footer-col-title">More</span>
        <a href={translatePath("/about/")}>{t('nav.about') || "About"}</a>
        <a href={translatePath("/journey/")}>{t('nav.journey') || "Journey"}</a>
        <a href={translatePath("/uses/")}>{t('nav.uses') || "Uses"}</a>
        <a href={translatePath("/gallery/")}>{t('nav.gallery') || "Gallery"}</a>
        <a href={translatePath("/resources/")}>{t('nav.resources') || "Resources"}</a>
      </div>

      <!-- Connect -->
      <div class="footer-col">
        <span class="footer-col-title">Connect</span>
        <a href="https://github.com/fazleyrabby" target="_blank" rel="noopener noreferrer">GitHub</a>
        <a href="https://linkedin.com/in/fazley-rabby" target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a href="https://x.com/itsfazley" target="_blank" rel="noopener noreferrer">Twitter / X</a>
        <a href="mailto:fazley111@gmail.com">Email</a>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="footer-bottom">
      <span class="footer-copy">© {new Date().getFullYear()} Fazley Rabbi</span>
      <div class="footer-meta">
        <VisitorCounter lang={lang} />
        <span class="footer-dot-sep" aria-hidden="true">•</span>
        <span class="footer-built">Built with Astro</span>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    border-top: 1px solid var(--border);
    background: var(--bg-base);
    margin-top: 56px;
    transition: background-color 260ms ease, border-color 260ms ease;
  }

  .footer-inner {
    width: min(900px, calc(100% - 48px));
    margin: 0 auto;
    padding: 48px 0 32px;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr;
    gap: 32px 24px;
  }

  @media (max-width: 768px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 28px 20px;
    }
    .footer-brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 480px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }

  /* Brand */
  .footer-logo {
    display: inline-flex;
    align-items: baseline;
    text-decoration: none;
  }
  .footer-logo-text {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 1.125rem;
    color: var(--text-primary);
    letter-spacing: -0.02em;
  }
  .footer-logo-dot {
    color: var(--accent-text);
    font-weight: 700;
    font-size: 1.25rem;
  }
  .footer-tagline {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    color: var(--text-secondary);
    margin: 0.5rem 0 0;
    max-width: 280px;
    line-height: 1.5;
  }

  /* Columns */
  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .footer-col-title {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 0.25rem;
  }
  .footer-col a {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 180ms ease;
  }
  .footer-col a:hover {
    color: var(--text-primary);
  }

  /* Bottom */
  .footer-bottom {
    margin-top: 40px;
    padding-top: 20px;
    border-top: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .footer-copy,
  .footer-built {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--text-muted);
  }
  .footer-meta {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .footer-dot-sep {
    color: var(--border);
    font-size: 0.75rem;
    user-select: none;
  }
  @media (max-width: 640px) {
    .footer-inner {
      width: calc(100% - 40px);
    }
    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }
  }
</style>
