---
import { getLangFromUrl } from "../i18n/utils";
const { title, description, ogTitle, ogDescription, ogImage, ogUrl, ogType, twitterCard, twitterImage, twitterTitle, twitterDescription, articlePublishedTime, articleModifiedTime, articleAuthor, articleTags, alternateUrl } = Astro.props;
const defaultTitle = "Fazley Rabbi — Backend Engineer (Laravel)";
const defaultDesc = "Laravel and backend engineer specializing in SaaS platforms, REST APIs, and payment integrations. Based in Bangladesh, available globally.";
const defaultOgImage = "https://fazleyrabbi.xyz/og.png";
const isProduction = import.meta.env.NODE_ENV === "production";
const umamiID = import.meta.env.UMAMI_ID;

const currentLang = getLangFromUrl(Astro.url);
const siteUrl = "https://fazleyrabbi.xyz";
const currentPathname = Astro.url.pathname;
// Remove trailing slash if exists (except for root)
const normalizedPath = currentPathname.endsWith('/') && currentPathname.length > 1 ? currentPathname.slice(0, -1) : currentPathname;

const defaultEnPath = currentLang === 'bn' ? normalizedPath.replace(/^\/bn/, '') || '/' : normalizedPath;
const defaultBnPath = currentLang === 'en' ? `/bn${normalizedPath === '/' ? '' : normalizedPath}` : normalizedPath;

const enHref = currentLang === 'bn' && alternateUrl ? alternateUrl : `${siteUrl}${defaultEnPath}`;
const bnHref = currentLang === 'en' && alternateUrl ? alternateUrl : `${siteUrl}${defaultBnPath}`;
---

<head>
    <meta charset="utf-8" />
    <title>{title ?? defaultTitle}</title>
    <link rel="alternate" href={enHref} hreflang="en" />
    <link rel="alternate" href={bnHref} hreflang="bn" />
    <link rel="alternate" href={enHref} hreflang="x-default" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="description" content={description ?? defaultDesc} />
    <meta property="og:title" content={ogTitle ?? title ?? defaultTitle} />
    <meta property="og:description" content={ogDescription ?? description ?? defaultDesc} />
    <meta property="og:image" content={ogImage ?? defaultOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={ogUrl ?? `https://fazleyrabbi.xyz${Astro.url.pathname}`} />
    <meta property="og:type" content={ogType ?? 'website'} />
    <meta property="og:locale" content={currentLang === 'bn' ? 'bn_BD' : 'en_US'} />
    <meta property="og:locale:alternate" content={currentLang === 'en' ? 'bn_BD' : 'en_US'} />
    <meta name="twitter:card" content={twitterCard ?? 'summary_large_image'} />
    <meta name="twitter:title" content={twitterTitle ?? ogTitle ?? title ?? defaultTitle} />
    <meta name="twitter:description" content={twitterDescription ?? ogDescription ?? description ?? defaultDesc} />
    <meta name="twitter:image" content={twitterImage ?? ogImage ?? defaultOgImage} />
    {articlePublishedTime && <meta property="article:published_time" content={articlePublishedTime} />}
    {articleModifiedTime && <meta property="article:modified_time" content={articleModifiedTime} />}
    {articleAuthor && <meta property="article:author" content={articleAuthor} />}
    {articleTags && articleTags.map((tag: string) => <meta property="article:tag" content={tag} />)}
    <link rel="canonical" href={ogUrl ?? `https://fazleyrabbi.xyz${Astro.url.pathname}`} />

    {(ogType ?? 'website') !== 'article' && (
        <script type="application/ld+json" set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@graph": [
                {
                    "@type": "Person",
                    "@id": `${siteUrl}/#person`,
                    "name": "Md Fazley Rabbi",
                    "alternateName": "Fazley Rabbi",
                    "url": siteUrl,
                    "image": defaultOgImage,
                    "jobTitle": "Backend Engineer (Laravel)",
                    "description": defaultDesc,
                    "email": "mailto:fazley111@gmail.com",
                    "worksFor": { "@type": "Organization", "name": "Electronic First" },
                    "alumniOf": { "@type": "CollegeOrUniversity", "name": "Port City International University" },
                    "knowsAbout": ["Laravel", "PHP", "MySQL", "ClickHouse", "REST APIs", "Backend Architecture", "Payment Systems"],
                    "address": { "@type": "PostalAddress", "addressLocality": "Chittagong", "addressCountry": "BD" },
                    "sameAs": [
                        "https://github.com/fazleyrabby",
                        "https://www.linkedin.com/in/fazley-rabby/"
                    ]
                },
                {
                    "@type": "WebSite",
                    "@id": `${siteUrl}/#website`,
                    "url": siteUrl,
                    "name": defaultTitle,
                    "description": defaultDesc,
                    "inLanguage": currentLang === 'bn' ? 'bn-BD' : 'en-US',
                    "publisher": { "@id": `${siteUrl}/#person` }
                }
            ]
        })} />
    )}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Spectral:ital,wght@0,400;0,500;0,600;1,400&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Spectral:ital,wght@0,400;0,500;0,600;1,400&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Spectral:ital,wght@0,400;0,500;0,600;1,400&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
      />
    </noscript>
    {
        isProduction && (
            <script
                async
                src="https://us.umami.is/script.js"
                data-website-id={umamiID}
            />
        )
    }
    {
        isProduction && (
            <Fragment>
                <script is:inline>
                    window.addEventListener('load', () => {
                        const script = document.createElement('script');
                        script.async = true;
                        script.src = 'https://www.googletagmanager.com/gtag/js?id=G-0LV5YH8TE8';
                        document.head.appendChild(script);

                        window.dataLayer = window.dataLayer || [];
                        function gtag(){dataLayer.push(arguments);}
                        gtag('js', new Date());
                        gtag('config', 'G-0LV5YH8TE8');
                    });
                </script>
            </Fragment>
        )
    }
    <script is:inline>
      // Color mode loader
      ;(function() {
        var mode = localStorage.getItem("color-mode");
        if (!mode) {
          mode = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        }
        if (mode === "dark") {
          document.documentElement.classList.add("dark");
        } else {
          document.documentElement.classList.remove("dark");
        }
      })();
    </script>

    <style is:inline>
      :root {
        --bg-base: #fafaf9;
        --text-primary: #1c1917;
        --accent: #ea580c;
        --font-display: "Spectral", serif;
        --font-sans: "Geist", system-ui, -apple-system, sans-serif;
        --font-mono: "IBM Plex Mono", monospace;
      }
      .dark {
        --bg-base: #0a0a0a;
        --text-primary: #f4f4f5;
      }
      body {
        background-color: var(--bg-base);
        color: var(--text-primary);
        margin: 0;
      }
    </style>
</head>
