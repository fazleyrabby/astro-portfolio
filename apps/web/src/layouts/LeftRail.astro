---
import { getLangFromUrl, useTranslations, useTranslatedPath } from "../i18n/utils";
import LangToggle from "@components/LangToggle.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const currentPathname = Astro.url.pathname;

const navItems = [
    { 
      href: translatePath("/"), 
      label: "Home", 
      icon: `<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25"/></svg>`,
      active: currentPathname === translatePath("/") || currentPathname === `${translatePath("/")}/`
    },
    { 
      href: translatePath("/projects/"), 
      label: "Projects", 
      icon: `<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14.25 9.75L16.5 12l-2.25 2.25m-4.5 0L7.5 12l2.25-2.25M6 20.25h12A2.25 2.25 0 0020.25 18V6A2.25 2.25 0 0018 3.75H6A2.25 2.25 0 003.75 6v12A2.25 2.25 0 006 20.25z"/></svg>`,
      active: currentPathname.includes("/projects")
    },
    { 
      href: translatePath("/posts/"), 
      label: "Writing", 
      icon: `<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z"/></svg>`,
      active: currentPathname.includes("/posts")
    },
    { 
      href: translatePath("/about/"), 
      label: "About", 
      icon: `<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"/></svg>`,
      active: currentPathname.includes("/about") && !currentPathname.includes("contact")
    },
    { 
      href: translatePath("/uses/"), 
      label: "Uses", 
      icon: `<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>`,
      active: currentPathname.includes("/uses")
    },
    { 
      href: translatePath("/resume/"), 
      label: "Resume", 
      icon: `<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 9h3.75M15 12h3.75M15 15h3.75M4.5 19.5h15a2.25 2.25 0 002.25-2.25V6.75A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25v10.5A2.25 2.25 0 004.5 19.5zm6-10.125a1.875 1.875 0 11-3.75 0 1.875 1.875 0 013.75 0zm1.294 6.336a6.721 6.721 0 01-3.17.789 6.721 6.721 0 01-3.168-.789 3.376 3.376 0 016.338 0z"/></svg>`,
      active: currentPathname.includes("/resume")
    }
];

const bottomNavItems = [
    { 
      href: translatePath("/gallery/"), 
      label: "Photography", 
      icon: `<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 001.5-1.5V6a1.5 1.5 0 00-1.5-1.5H3.75A1.5 1.5 0 002.25 6v12a1.5 1.5 0 001.5 1.5zm10.5-11.25h.008v.008h-.008V8.25zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z"/></svg>`,
      active: currentPathname.includes("/gallery")
    },
    { 
      href: translatePath("/resources/"), 
      label: "Resources", 
      icon: `<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-16.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-16.25v16.25"/></svg>`,
      active: currentPathname.includes("/resources")
    }
];

const socialItems = [
    {
      href: "https://github.com/fazleyrabby",
      label: "GitHub",
      icon: `<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 17.25v1.007a3 3 0 01-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0115 18.257V17.25m6-12V15a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 15V5.25M12 17.25h.008v.008H12v-.008zM21 5.25a2.25 2.25 0 00-2.25-2.25H5.25A2.25 2.25 0 003 5.25v9.75h18V5.25z"/></svg>`
    },
    {
      href: "https://www.linkedin.com/in/fazley-rabby/",
      label: "LinkedIn",
      icon: `<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 011.242 7.244l-4.5 4.5a4.5 4.5 0 01-6.364-6.364l1.757-1.757m13.35-.622l1.757-1.757a4.5 4.5 0 00-6.364-6.364l-4.5 4.5a4.5 4.5 0 001.242 7.244"/></svg>`
    },
    {
      href: "https://x.com/fazley111",
      label: "Twitter",
      icon: `<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"/></svg>`
    },
    {
      href: "https://www.facebook.com/Fazley111Rabby/",
      label: "Facebook",
      icon: `<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/></svg>`
    },
    {
      href: "mailto:fazley111@gmail.com",
      label: "Contact",
      icon: `<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/></svg>`
    }
];
---

<aside class="v2-left-rail flex-col justify-between items-stretch bg-base border-r border-[var(--grid-line-strong)] py-6 z-40 w-[var(--rail-w)] shrink-0 h-screen sticky top-0 overflow-y-auto select-none">
  <!-- Top Section: Logo, Status, Navigation, and Socials stacked -->
  <div class="flex flex-col items-stretch w-full gap-6">
    <!-- Logo -->
    <div class="px-4 flex items-center justify-between gap-2">
      <a href={translatePath("/")} class="v2-rail-logo flex items-center gap-3 w-full" aria-label="Fazley Rabbi - Home">
        <div class="w-9 h-9 rounded-md bg-color-mix flex items-center justify-center border border-[var(--grid-line)] shrink-0">
          <span class="font-display font-bold text-lg text-[var(--text-primary)]">F</span>
          <span class="text-[var(--accent)] font-bold">.</span>
        </div>
        <span class="font-display font-bold text-sm text-[var(--text-primary)] whitespace-nowrap">
          Fazley Rabbi
        </span>
      </a>
      <button id="v2-desktop-sidebar-toggle-aside" class="p-1 rounded text-[var(--text-secondary)] hover:text-[var(--accent)] hover:bg-[var(--accent-dim)] transition-colors border border-transparent hover:border-[var(--border)] shrink-0 hidden md:block" title="Collapse Sidebar">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5"/>
        </svg>
      </button>
    </div>
    


    <!-- Main Navigation Items Stacked -->
    <nav class="flex flex-col gap-1 w-full px-3" aria-label="Main Workstation Navigation">
      {navItems.map((item) => (
        <a href={item.href} 
           class={`v2-rail-btn group/btn flex items-center gap-3 px-3 py-2 rounded text-[var(--text-secondary)] hover:text-[var(--accent)] hover:bg-[var(--accent-dim)] transition-all relative ${item.active ? 'v2-rail-btn--active text-[var(--accent)] bg-[var(--accent-dim)] font-semibold' : ''}`}
           aria-label={item.label}>
          <span class="v2-rail-active-indicator" aria-hidden="true"></span>
          <div class="shrink-0 flex items-center justify-center text-[var(--text-muted)] group-hover/btn:text-[var(--accent)] transition-colors">
            <Fragment set:html={item.icon} />
          </div>
          <span class="font-sans text-sm text-theme-secondary group-hover/btn:text-[var(--accent)] transition-colors whitespace-nowrap flex-1">
            {item.label}
          </span>
        </a>
      ))}
    </nav>

    <!-- Separator Line -->
    <div class="px-4">
      <div class="h-[1px] bg-[var(--grid-line-strong)] w-full"></div>
    </div>

    <!-- Social Links Stacked -->
    <nav class="flex flex-col gap-1 w-full px-3" aria-label="Social Links">
      <span class="font-mono text-[10px] text-theme-muted uppercase tracking-wider px-3 mb-1">Socials</span>
      {socialItems.map((item) => (
        <a href={item.href} 
           target={item.href.startsWith("http") ? "_blank" : undefined}
           rel={item.href.startsWith("http") ? "noopener noreferrer" : undefined}
           class="v2-rail-btn group/btn flex items-center gap-3 px-3 py-2 rounded text-[var(--text-secondary)] hover:text-[var(--accent)] hover:bg-[var(--accent-dim)] transition-all relative"
           aria-label={item.label}>
          <div class="shrink-0 flex items-center justify-center text-[var(--text-muted)] group-hover/btn:text-[var(--accent)] transition-colors">
            <Fragment set:html={item.icon} />
          </div>
          <span class="font-sans text-sm text-theme-secondary group-hover/btn:text-[var(--accent)] transition-colors whitespace-nowrap">
            {item.label}
          </span>
        </a>
      ))}
    </nav>
  </div>

  <!-- Bottom Links: Gallery and Resources -->
  <div class="flex flex-col gap-1 w-full px-3 mt-auto mb-3">
    {bottomNavItems.map((item) => (
      <a href={item.href} 
         class={`v2-rail-btn group/btn flex items-center gap-3 px-3 py-2 rounded text-[var(--text-secondary)] hover:text-[var(--accent)] hover:bg-[var(--accent-dim)] transition-all relative ${item.active ? 'v2-rail-btn--active text-[var(--accent)] bg-[var(--accent-dim)] font-semibold' : ''}`}
         aria-label={item.label}>
        <span class="v2-rail-active-indicator" aria-hidden="true"></span>
        <div class="shrink-0 flex items-center justify-center text-[var(--text-muted)] group-hover/btn:text-[var(--accent)] transition-colors">
          <Fragment set:html={item.icon} />
        </div>
        <span class="font-sans text-sm text-theme-secondary group-hover/btn:text-[var(--accent)] transition-colors whitespace-nowrap flex-1">
          {item.label}
        </span>
      </a>
    ))}
  </div>

  <!-- Bottom: Lang Switcher & Mode info -->
  <div class="w-full px-4 pt-4 border-t border-[var(--grid-line)]">
    <div class="flex items-center justify-between w-full">
      <!-- Clean ☀️ Light / 🌙 Dark Toggle -->
      <button id="v2-theme-toggle" class="flex items-center gap-1.5 p-1 rounded hover:bg-[var(--accent-dim)] text-[var(--text-secondary)] hover:text-[var(--accent)] transition-colors" title="Toggle Light/Dark Theme">
        <svg class="w-3.5 h-3.5 dark:hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
        <svg class="w-3.5 h-3.5 hidden dark:block" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"></path></svg>
        <span class="font-sans text-[11px] text-theme-muted">Theme</span>
      </button>

      <!-- Language Switcher -->
      <div>
        <LangToggle />
      </div>
    </div>
  </div>
</aside>

<script>
  // Simple Light / Dark theme toggle listener
  const toggleBtn = document.getElementById("v2-theme-toggle");
  toggleBtn?.addEventListener("click", () => {
    if (typeof (window as any).__toggleThemeWithWave === "function") {
      (window as any).__toggleThemeWithWave();
    } else {
      const isDark = document.documentElement.classList.contains("dark");
      if (isDark) {
        document.documentElement.classList.remove("dark");
        localStorage.setItem("color-mode", "light");
      } else {
        document.documentElement.classList.add("dark");
        localStorage.setItem("color-mode", "dark");
      }
    }
  });
</script>

<style>
  .v2-left-rail {
    background: var(--bg-base);
    display: flex;
  }
  @media (max-width: 900px) {
    .v2-left-rail {
      display: none !important;
    }
  }

  .bg-color-mix {
    background: color-mix(in srgb, var(--text-primary) 3%, var(--bg-base));
  }

  .v2-rail-btn--active {
    background: var(--accent-dim);
  }

  .v2-rail-active-indicator {
    position: absolute;
    left: 0;
    top: 4px;
    bottom: 4px;
    width: 3px;
    border-radius: 0 4px 4px 0;
    background-color: var(--accent);
    opacity: 0;
    transform: scaleY(0.4);
    transition: opacity var(--t-fast) ease, transform var(--t-fast) var(--ease-out-expo);
  }

  .v2-rail-btn--active .v2-rail-active-indicator {
    opacity: 1;
    transform: scaleY(1);
  }
</style>
