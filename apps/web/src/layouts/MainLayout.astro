---
import Head from "./Head.astro";
import Navigation from "./Navigation.astro";
import Footer from "./Footer.astro";
import "../styles/global.css";
import ThemeWaveTransition from "@components/ThemeWaveTransition.astro";
import ScrollToTop from "@components/ScrollToTop.astro";
import BuyMeCoffee from "@components/BuyMeCoffee.astro";
import Analytics from "@vercel/analytics/astro";
import { getLangFromUrl } from "../i18n/utils";

const {
  title,
  description,
  ogTitle,
  ogDescription,
  ogImage,
  ogUrl,
  ogType,
  twitterCard,
  twitterImage,
  twitterTitle,
  twitterDescription,
  articlePublishedTime,
  articleModifiedTime,
  articleAuthor,
  articleTags,
  lang = getLangFromUrl(Astro.url),
  altUrl,
} = Astro.props;
---

<html lang={lang}>
  <Head
    {title}
    {description}
    {ogTitle}
    {ogDescription}
    {ogImage}
    {ogUrl}
    {ogType}
    {twitterCard}
    {twitterImage}
    {twitterTitle}
    {twitterDescription}
    {articlePublishedTime}
    {articleModifiedTime}
    {articleAuthor}
    {articleTags}
  />
  <body
    class="font-sans min-h-screen relative bg-[var(--bg-base)] text-[var(--text-primary)] antialiased"
    data-api-url={import.meta.env.PUBLIC_API_URL || "https://cms.fazleyrabbi.xyz"}
  >
    <Analytics />

    <div id="rain-wet-content" class="rain-wet-content min-h-screen flex flex-col">
      <!-- Navigation -->
      <Navigation altUrl={altUrl} />

      <!-- Main content -->
      <div class="pt-16 min-h-screen flex flex-col">
        <div class="flex-1">
          <slot />
        </div>

        <!-- Footer -->
        <Footer />
      </div>

      <ScrollToTop />
      <BuyMeCoffee />
    </div>

    <ThemeWaveTransition />

    <script>
      const initAnimations = async () => {
        // Native, lightweight IntersectionObserver for scroll reveals
        const revealEls = document.querySelectorAll(".reveal");
        if (revealEls.length > 0) {
          if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
            revealEls.forEach((el) => el.classList.add("is-visible"));
          } else {
            const observer = new IntersectionObserver(
              (entries, obs) => {
                entries.forEach((entry) => {
                  if (entry.isIntersecting) {
                    entry.target.classList.add("is-visible");
                    obs.unobserve(entry.target);
                  }
                });
              },
              { threshold: 0.05, rootMargin: "0px 0px 50px 0px" }
            );

            revealEls.forEach((el) => {
              const rect = el.getBoundingClientRect();
              if (rect.top < window.innerHeight) {
                el.classList.add("is-visible");
              } else {
                observer.observe(el);
              }
            });
          }
        }

        // Initialize Lenis smooth scroll on desktop only (don't hijack mobile touch momentum)
        if (
          window.innerWidth >= 1024 &&
          !window.matchMedia("(prefers-reduced-motion: reduce)").matches
        ) {
          try {
            const { default: Lenis } = await import("lenis");
            const lenis = new Lenis({
              duration: 1.2,
              easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
            });

            function raf(time: number) {
              lenis.raf(time);
              requestAnimationFrame(raf);
            }
            requestAnimationFrame(raf);
          } catch {
            // Fallback gracefully
          }
        }
      };

      if (window.requestIdleCallback) {
        requestIdleCallback(() => initAnimations());
      } else {
        setTimeout(initAnimations, 100);
      }
      document.addEventListener("astro:page-load", () => {
        if (window.requestIdleCallback) {
          requestIdleCallback(() => initAnimations());
        } else {
          setTimeout(initAnimations, 100);
        }
      });
    </script>

    <script>
      import { collectVisitorTelemetry } from "../lib/fingerprint";

      const trackVisitor = async () => {
        // Exclude admin, owner, or explicitly ignored sessions
        try {
          if (
            localStorage.getItem("cms_token") ||
            localStorage.getItem("ignore_stats") === "true" ||
            localStorage.getItem("admin_mode") === "true"
          ) {
            return;
          }
        } catch (_) {}

        const sessionKey = "portfolio_visitor_tracked";
        if (sessionStorage.getItem(sessionKey)) return;

        try {
          const telemetry = await collectVisitorTelemetry();

          // Primary: Vercel serverless function on same origin (100% serverless, zero VPS required)
          let res = await fetch("/api/track", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(telemetry),
            keepalive: true,
          }).catch(() => null);

          // Fallback if local dev or different environment
          if (!res || !res.ok) {
            const apiUrl =
              document.body?.getAttribute("data-api-url") ||
              "https://cms.fazleyrabbi.xyz";
            res = await fetch(`${apiUrl}/track`, {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify(telemetry),
              keepalive: true,
            }).catch(() => null);
          }

          if (res && res.ok) {
            sessionStorage.setItem(sessionKey, "true");
          }
        } catch (_) {}
      };

      if (window.requestIdleCallback) {
        requestIdleCallback(trackVisitor);
      } else {
        window.addEventListener("load", trackVisitor);
      }

      document.addEventListener("astro:page-load", () => {
        if (!sessionStorage.getItem("portfolio_visitor_tracked")) {
          if (window.requestIdleCallback) {
            requestIdleCallback(trackVisitor);
          } else {
            setTimeout(trackVisitor, 100);
          }
        }
      });
    </script>
  </body>
</html>
