---
import Head from "./Head.astro";
import Navigation from "./Navigation.astro";
import Footer from "./Footer.astro";
import "../styles/global.css";
import ScrollToTop from "@components/ScrollToTop.astro";
import Analytics from "@vercel/analytics/astro";
import { getLangFromUrl } from "../i18n/utils";

const {
  title,
  description,
  ogTitle,
  ogDescription,
  ogImage,
  ogUrl,
  ogType,
  twitterCard,
  twitterImage,
  twitterTitle,
  twitterDescription,
  articlePublishedTime,
  articleModifiedTime,
  articleAuthor,
  articleTags,
  lang = getLangFromUrl(Astro.url),
  altUrl,
} = Astro.props;
---

<html lang={lang}>
  <Head
    {title}
    {description}
    {ogTitle}
    {ogDescription}
    {ogImage}
    {ogUrl}
    {ogType}
    {twitterCard}
    {twitterImage}
    {twitterTitle}
    {twitterDescription}
    {articlePublishedTime}
    {articleModifiedTime}
    {articleAuthor}
    {articleTags}
  />
  <body
    class="font-sans min-h-screen relative bg-[var(--bg-base)] text-[var(--text-primary)] antialiased"
  >
    <Analytics />

    <!-- Navigation -->
    <Navigation altUrl={altUrl} />

    <!-- Main content -->
    <div class="pt-16 min-h-screen flex flex-col">
      <div class="flex-1">
        <slot />
      </div>

      <!-- Footer -->
      <Footer />
    </div>

    <ScrollToTop />

    <script>
      const initAnimations = async () => {
        // Native, lightweight IntersectionObserver for scroll reveals
        const revealEls = document.querySelectorAll(".reveal");
        if (revealEls.length > 0) {
          if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
            revealEls.forEach((el) => el.classList.add("is-visible"));
          } else {
            const observer = new IntersectionObserver(
              (entries, obs) => {
                entries.forEach((entry) => {
                  if (entry.isIntersecting) {
                    entry.target.classList.add("is-visible");
                    obs.unobserve(entry.target);
                  }
                });
              },
              { threshold: 0.05, rootMargin: "0px 0px 50px 0px" }
            );

            revealEls.forEach((el) => {
              const rect = el.getBoundingClientRect();
              if (rect.top < window.innerHeight) {
                el.classList.add("is-visible");
              } else {
                observer.observe(el);
              }
            });
          }
        }

        // Initialize Lenis smooth scroll on desktop only (don't hijack mobile touch momentum)
        if (
          window.innerWidth >= 1024 &&
          !window.matchMedia("(prefers-reduced-motion: reduce)").matches
        ) {
          try {
            const { default: Lenis } = await import("lenis");
            const lenis = new Lenis({
              duration: 1.2,
              easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
            });

            function raf(time: number) {
              lenis.raf(time);
              requestAnimationFrame(raf);
            }
            requestAnimationFrame(raf);
          } catch {
            // Fallback gracefully
          }
        }
      };

      if (window.requestIdleCallback) {
        requestIdleCallback(() => initAnimations());
      } else {
        setTimeout(initAnimations, 100);
      }
      document.addEventListener("astro:page-load", () => {
        if (window.requestIdleCallback) {
          requestIdleCallback(() => initAnimations());
        } else {
          setTimeout(initAnimations, 100);
        }
      });
    </script>

    <script
      is:inline
      define:vars={{
        apiUrl: import.meta.env.PUBLIC_API_URL || "https://cms.fazleyrabbi.xyz",
      }}
    >
      const trackVisitor = () => {
        if (!sessionStorage.getItem("visitor_ip")) {
          fetch(`${apiUrl}/track`, {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify({
              platform: navigator.platform,
              language: navigator.language,
              screen: window.screen.width + "x" + window.screen.height,
              path: window.location.pathname,
            }),
            keepalive: true,
          })
            .then((res) => {
              if (!res.ok) return null;
              return res.json();
            })
            .then((data) => {
              if (data && data.ip) {
                sessionStorage.setItem("visitor_ip", data.ip);
              }
            })
            .catch(() => {});
        }
      };

      if (window.requestIdleCallback) {
        requestIdleCallback(trackVisitor);
      } else {
        window.addEventListener("load", trackVisitor);
      }
    </script>
  </body>
</html>
