---
import MainLayout from "@layouts/MainLayout.astro";
import Github from "@components/Icons/Github.astro";
import Youtube from "@components/Icons/Youtube.astro";
import Email from "@components/Icons/Email.astro";
import Codepen from "@components/Icons/Codepen.astro";
import Linkedin from "@components/Icons/Linkedin.astro";
import { Content as AboutEn } from "../content/about.md";
import { Content as AboutBn } from "../content/about-bn.md";
import ContactForm from "@components/ContactForm.astro";
import { getLangFromUrl, useTranslations, useTranslatedPath } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<MainLayout title={t('about.title')}>
  <main class="about-page">
    <div class="about-container">
      <!-- Header -->
      <header class="about-header reveal">
        <h1 class="page-title">About</h1>
      </header>

      <!-- Content -->
      <div class="about-content reveal">
        <article class="prose prose-neutral dark:prose-invert max-w-none">
          {lang === 'bn' ? <AboutBn /> : <AboutEn />}
        </article>
      </div>

      <!-- Journey Banner Card -->
      <div class="about-journey-card reveal">
        <div class="about-journey-inner">
          <div class="about-journey-text">
            <span class="journey-kicker">{t('about.journey.kicker')}</span>
            <h3 class="journey-card-title">{t('about.journey.title')}</h3>
            <p class="journey-card-desc">{t('about.journey.desc')}</p>
          </div>
          <a href={translatePath("/journey/")} class="journey-card-btn">
            <span>{t('about.journey.btn')}</span>
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"></path></svg>
          </a>
        </div>
      </div>

      <!-- Contact section -->
      <section id="contact" class="about-contact reveal">
        <div class="about-contact-head">
          <span class="page-kicker">{t('about.contact.label')}</span>
          <h2 class="about-contact-title">{t('about.contact.title')}</h2>
          <p class="about-contact-sub">{t('about.contact.subtitle')}</p>
        </div>
        <div class="about-contact-form">
          <ContactForm />
        </div>
      </section>

      <!-- Social links -->
      <div class="about-socials reveal">
        <span class="about-socials-label">{t('about.social')}</span>
        <div class="about-socials-icons">
          <a href="https://github.com/fazleyrabby" target="_blank" aria-label="GitHub"><Github /></a>
          <a href="https://linkedin.com/in/fazley-rabby" target="_blank" aria-label="LinkedIn"><Linkedin /></a>
          <a href="https://youtube.com/@fazleyrabby" target="_blank" aria-label="YouTube"><Youtube /></a>
          <a href="mailto:fazley111@gmail.com" aria-label="Email"><Email /></a>
          <a href="https://codepen.io/fazleyrabby" target="_blank" aria-label="Codepen"><Codepen /></a>
        </div>
      </div>
    </div>
  </main>
</MainLayout>

<style>
  .about-page {
    padding: clamp(2rem, 5vw, 4rem) 0;
  }
  .about-container {
    max-width: 720px;
    margin: 0 auto;
    padding: 0 clamp(1.25rem, 4vw, 2rem);
  }

  .about-header {
    margin-bottom: 2.5rem;
  }

  /* Prose styling */
  .about-content :global(.prose) {
    font-size: 1rem;
    color: var(--text-secondary);
  }
  .about-content :global(.prose p) {
    margin: 1rem 0;
    line-height: 1.75;
  }
  .about-content :global(.prose h2) {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 500;
    color: var(--text-primary);
    margin: 2.5rem 0 1rem;
    letter-spacing: -0.01em;
  }
  .about-content :global(.prose h2:first-child) { margin-top: 0; }
  .about-content :global(.prose h3) {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 500;
    color: var(--text-primary);
    margin: 1.5rem 0 0.75rem;
  }
  .about-content :global(.prose ul) { margin: 1rem 0; padding-left: 1.25rem; }
  .about-content :global(.prose li) { margin: 0.375rem 0; line-height: 1.7; }
  .about-content :global(.prose strong) { color: var(--text-primary); font-weight: 600; }
  .about-content :global(.prose a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 4px;
    transition: color 0.2s ease;
  }
  .about-content :global(.prose a:hover) {
    color: var(--text-primary);
  }

  /* Journey Banner Card */
  .about-journey-card {
    margin-top: 2.5rem;
    padding: 1.75rem 2rem;
    border-radius: 12px;
    border: 1px solid var(--border);
    background: var(--bg-card);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .about-journey-card:hover {
    border-color: color-mix(in srgb, var(--accent) 40%, var(--border));
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.05);
  }
  .about-journey-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }
  @media (max-width: 640px) {
    .about-journey-inner {
      flex-direction: column;
      align-items: flex-start;
    }
  }
  .journey-kicker {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    display: block;
    margin-bottom: 0.25rem;
  }
  .journey-card-title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--text-primary);
    margin: 0 0 0.5rem 0;
  }
  .journey-card-desc {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0;
    max-width: 520px;
  }
  .journey-card-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 1.25rem;
    border-radius: 8px;
    background: var(--text-primary);
    color: var(--bg-base);
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    transition: all 0.2s ease;
    flex-shrink: 0;
  }
  .journey-card-btn:hover {
    background: var(--accent);
    color: #ffffff;
    transform: translateY(-1px);
  }

  /* Contact */
  .about-contact {
    margin-top: 3rem;
    padding-top: 3rem;
    border-top: 1px solid var(--border);
  }
  .about-contact-head {
    margin-bottom: 1.5rem;
  }
  .about-contact-title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.5rem;
    color: var(--text-primary);
    margin: 0.25rem 0 0;
    letter-spacing: -0.01em;
  }
  .about-contact-sub {
    font-size: 0.9375rem;
    color: var(--text-muted);
    margin: 0.25rem 0 0;
  }

  /* Socials */
  .about-socials {
    margin-top: 2rem;
    padding: 2rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    align-items: center;
  }
  .about-socials-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .about-socials-icons {
    display: flex;
    gap: 1.25rem;
  }
  .about-socials-icons a {
    color: var(--text-secondary);
    transition: color 0.2s ease, transform 0.2s ease;
  }
  .about-socials-icons a:hover { color: var(--accent); transform: translateY(-2px); }
</style>
