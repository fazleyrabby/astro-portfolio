---
import { getCollection, type CollectionEntry } from 'astro:content';
import MainLayout from '@layouts/MainLayout.astro';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../../../i18n/utils';
import { Image } from 'astro:assets';

export async function getStaticPaths() {
  const all = await getCollection('projects');
  const bn = all.filter(p => p.data.lang === 'bn' && !p.data.hidden && p.data.type !== 'frontend');
  return bn.map(project => ({
    params: { slug: project.slug.replace(/-bn$/, '') },
    props: { project },
  }));
}

type Props = { project: CollectionEntry<'projects'> };
const { project } = Astro.props;
const activeData = project.data;
const activeSlug = project.slug.replace(/-bn$/, '');

const lang = 'bn' as const;
const t = useTranslations(lang);
const tp = useTranslatedPath(lang);

const baseSlug = project.slug.replace(/-bn$/, '');
const all = await getCollection('projects');
const hasEn = all.some(p => p.slug === baseSlug && (p.data.lang || 'en') === 'en');
const altUrl = hasEn ? `/projects/${baseSlug}` : undefined;

const projects = all.filter(
  (p) => (p.data.lang || "en") === lang && !p.data.hidden && p.data.type !== "frontend",
);
projects.sort((a, b) => (a.data.position || 0) - (b.data.position || 0));

const hasCaseStudy = !!(activeData.problem || (activeData.highlights && activeData.highlights.length));

// Architectural diagnostic mapper helper
const getProjectMeta = (slug: string) => {
  const s = slug.replace(/-bn$/, '');
  let arch = "Monolithic MVC";
  let infra = "VPS Linux";
  
  if (s === "electronic-first") {
    arch = "Transactional Engine";
    infra = "Read Replicas";
  } else if (s === "signalstack") {
    arch = "Event-Driven Feed";
    infra = "Redis Queue";
  } else if (s === "hujjah") {
    arch = "Semantic Vector Search";
    infra = "Supabase pgvector";
  } else if (s === "litepos") {
    arch = "Multi-Business POS";
    infra = "Isolated DBs";
  } else if (s === "larabrix") {
    arch = "CMS Framework Component";
    infra = "CI/CD Pipeline";
  } else if (s === "lenden" || s === "e-bank") {
    arch = "Ledger Transaction";
    infra = "Stripe / Gateways";
  }
  return { arch, infra };
};

const { arch, infra } = getProjectMeta(activeSlug);
---

<MainLayout 
  title={`${activeData.title} — ফজলে রাব্বি`}
  description={activeData.description}
  ogTitle={activeData.title}
  ogDescription={activeData.description}
  ogImage={activeData.thumbnail}
  ogUrl={`https://fazleyrabbi.xyz/bn/projects/${activeSlug}`}
  ogType="article"
  twitterCard="summary_large_image"
  twitterImage={activeData.thumbnail}
  altUrl={altUrl}
>
  <!-- Mobile Navigation Toggle Bar -->
  <div class="v3-mobile-toggle-bar border-b border-[var(--border)] px-4 py-2.5 flex items-center bg-[var(--bg-base)] hover:bg-[var(--accent-dim)] transition-colors cursor-pointer">
    <button id="v3-mobile-explorer-trigger" class="w-full flex items-center justify-between font-sans text-xs font-bold text-theme-primary uppercase text-left">
      <div class="flex items-center gap-2">
        <svg class="w-4 h-4 text-[var(--accent)]" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"/>
        </svg>
        <span>প্রজেক্ট তালিকা</span>
      </div>
      <span class="font-mono text-[9px] px-1.5 py-0.5 rounded bg-[var(--accent-dim)] text-[var(--accent)] border border-[var(--accent)] uppercase animate-pulse">সাইডবার খুলুন</span>
    </button>
  </div>

  <main class="v3-workbench-container">
    <div id="v3-explorer-backdrop" class="v3-explorer-backdrop"></div>
    
    <!-- LEFT SIDEBAR: System Explorer -->
    <aside class="v3-explorer-rail">
      <div class="v3-explorer-header">
        <h2 class="v3-explorer-title font-sans">প্রজেক্টসমূহ</h2>
        
        <!-- Search bar -->
        <div class="v3-explorer-search">
          <input type="text" id="proj-search" placeholder="অনুসন্ধান..." />
          <svg width="11" height="11" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
        </div>

        <!-- Filter tabs -->
        <div class="v3-explorer-tabs">
          <button class="filter-tab active" data-filter="all">সব</button>
          <button class="filter-tab" data-filter="backend">ব্যাকএন্ড</button>
          <button class="filter-tab" data-filter="frontend">ফ্রন্টএন্ড</button>
        </div>
      </div>

      <!-- Projects list explorer -->
      <nav class="v3-explorer-list" id="explorer-list" data-lenis-prevent>
        {projects.map((p) => {
          const s = p.slug.replace(/-bn$/, '');
          const isSelected = s === activeSlug;
          return (
            <a 
              href={tp(`/projects/${s}`)}
              class={`explorer-item ${isSelected ? 'active' : ''}`}
              data-title={p.data.title}
              data-desc={p.data.description}
              data-type={p.data.type || 'backend'}
              data-tags={JSON.stringify(p.data.tech || [])}
            >
              <span class="explorer-item-title font-sans font-bold text-sm text-theme-primary transition-colors">{p.data.title}</span>
              <p class="explorer-item-desc text-theme-muted text-xs line-clamp-1 mt-1">{p.data.description}</p>
              <div class="explorer-item-footer mt-1.5 flex items-center gap-2 font-mono text-[10px]">
                <span class="text-theme-muted uppercase">{p.data.type || 'backend'}</span>
                <span class="text-theme-muted opacity-40">|</span>
                <span class="text-theme-muted uppercase">{p.data.status || 'stable'}</span>
              </div>
            </a>
          );
        })}
      </nav>
    </aside>

    <!-- RIGHT PANEL: System Specs Workbench -->
    <section class="v3-workbench-panel">
      <div class="v3-workbench-scroll" data-lenis-prevent>
        <div class="v3-content-wrapper max-w-[720px]">
          <!-- Workbench Header (Project Hero) -->
          <div class="v3-panel-header pb-6 border-b border-[var(--grid-line)]">
            <div class="flex items-start justify-between gap-4 flex-wrap w-full">
              <div class="flex flex-col gap-1">
                <div class="flex items-center gap-2 flex-wrap">
                  <span class="v3-panel-status font-mono text-tiny text-theme-muted uppercase tracking-wider">
                    {activeData.type || 'BACKEND'} // {activeData.status || 'PRODUCTION'}
                  </span>
                </div>
                <h1 class="v3-panel-title font-serif font-bold text-3xl text-theme-primary">{activeData.title}</h1>
              </div>

              <!-- Action buttons -->
              <div class="v3-panel-actions flex gap-2 font-mono text-xs">
                {activeData.live && (
                  <a href={activeData.live} target="_blank" rel="noreferrer" class="px-3 py-1.5 rounded bg-[var(--accent)] text-[#080808] font-bold uppercase tracking-wider hover:opacity-90 transition-opacity flex items-center gap-1">
                    লাইভ ডেমো ↗
                  </a>
                )}
                {activeData.github && (
                  <a href={activeData.github} target="_blank" rel="noreferrer" class="px-3 py-1.5 rounded bg-[var(--grid-line)] text-theme-primary font-bold uppercase tracking-wider border border-[var(--border)] hover:border-[var(--accent)] hover:text-[var(--accent)] transition-all flex items-center gap-1">
                    কোডবেস ↗
                  </a>
                )}
              </div>
            </div>

            <p class="v3-panel-subtitle text-theme-secondary text-base leading-relaxed mt-4">{activeData.description}</p>
          </div>

          <!-- Typography-based lightweight specs bar (Instead of bordered boxes) -->
          <div class="v3-meta-specs-bar grid grid-cols-2 sm:grid-cols-4 gap-6 py-6 border-b border-[var(--grid-line)]">
            <div class="flex flex-col">
              <span class="font-mono text-tiny text-theme-muted uppercase tracking-wider mb-1">ভূমিকা</span>
              <span class="font-sans text-sm font-semibold text-theme-primary">{activeData.role || "Backend Architect"}</span>
            </div>
            <div class="flex flex-col">
              <span class="font-mono text-tiny text-theme-muted uppercase tracking-wider mb-1">আর্কিটেকচার</span>
              <span class="font-sans text-sm font-semibold text-theme-primary">{arch}</span>
            </div>
            <div class="flex flex-col">
              <span class="font-mono text-tiny text-theme-muted uppercase tracking-wider mb-1">ইনফ্রাস্ট্রাকচার</span>
              <span class="font-sans text-sm font-semibold text-theme-primary">{infra}</span>
            </div>
            <div class="flex flex-col">
              <span class="font-mono text-tiny text-theme-muted uppercase tracking-wider mb-1">কমিট</span>
              <span class="font-sans text-sm font-semibold text-theme-primary">{activeData.commits ? `${activeData.commits.toLocaleString()}+` : "100+"}</span>
            </div>
          </div>

          <!-- Inline SVG Architecture Diagram -->
          {activeSlug === 'electronic-first' && (
            <div class="case-section py-6 border-b border-[var(--grid-line)]">
              <h3 class="font-mono text-tiny text-theme-muted uppercase tracking-wider mb-4">SYSTEM ARCHITECTURE</h3>
              <svg viewBox="0 0 600 80" class="w-full text-theme-muted" fill="none" stroke="currentColor">
                <g class="font-mono text-[10px]" stroke-width="1">
                  <rect x="5" y="20" width="80" height="30" rx="4" class="fill-base stroke-theme-muted" />
                  <text x="45" y="38" text-anchor="middle" class="fill-theme-primary font-bold">USERS</text>
                  <path d="M 85 35 L 125 35" class="stroke-theme-muted" marker-end="url(#arrow)" />

                  <rect x="125" y="20" width="100" height="30" rx="4" class="fill-base stroke-theme-muted" />
                  <text x="175" y="38" text-anchor="middle" class="fill-theme-primary font-bold">CLOUDFLARE</text>
                  <path d="M 225 35 L 265 35" class="stroke-theme-muted" marker-end="url(#arrow)" />

                  <rect x="265" y="20" width="100" height="30" rx="4" class="fill-base stroke-[var(--accent)]" />
                  <text x="315" y="38" text-anchor="middle" class="fill-[var(--accent)] font-bold">LARAVEL API</text>
                  <path d="M 365 35 L 405 35" class="stroke-theme-muted" marker-end="url(#arrow)" />

                  <rect x="405" y="20" width="105" height="30" rx="4" class="fill-base stroke-theme-muted" />
                  <text x="457" y="38" text-anchor="middle" class="fill-theme-primary font-bold">REDIS / MYSQL</text>
                  <path d="M 510 35 L 530 35" class="stroke-theme-muted" />
                  <path d="M 530 35 L 530 50 L 405 50" class="stroke-theme-muted" />
                  
                  <rect x="300" y="55" width="105" height="20" rx="4" class="fill-base stroke-theme-muted" />
                  <text x="352" y="67" text-anchor="middle" class="fill-theme-muted">CLICKHOUSE (LOGS)</text>
                </g>
                <defs>
                  <marker id="arrow" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
                    <path d="M 0 2 L 8 5 L 0 8 z" class="fill-theme-muted" />
                  </marker>
                </defs>
              </svg>
            </div>
          )}

          {activeSlug === 'signalstack' && (
            <div class="case-section py-6 border-b border-[var(--grid-line)]">
              <h3 class="font-mono text-tiny text-theme-muted uppercase tracking-wider mb-4">SYSTEM ARCHITECTURE</h3>
              <svg viewBox="0 0 600 80" class="w-full text-theme-muted" fill="none" stroke="currentColor">
                <g class="font-mono text-[10px]" stroke-width="1">
                  <rect x="5" y="20" width="90" height="30" rx="4" class="fill-base stroke-theme-muted" />
                  <text x="50" y="38" text-anchor="middle" class="fill-theme-primary font-bold">CLIENT FEED</text>
                  <path d="M 95 35 L 135 35" class="stroke-theme-muted" marker-end="url(#arrow)" />

                  <rect x="135" y="20" width="100" height="30" rx="4" class="fill-base stroke-[var(--accent)]" />
                  <text x="185" y="38" text-anchor="middle" class="fill-[var(--accent)] font-bold">FASTAPI INGEST</text>
                  <path d="M 235 35 L 275 35" class="stroke-theme-muted" marker-end="url(#arrow)" />

                  <rect x="275" y="20" width="100" height="30" rx="4" class="fill-base stroke-theme-muted" />
                  <text x="325" y="38" text-anchor="middle" class="fill-theme-primary font-bold">REDIS QUEUE</text>
                  <path d="M 375 35 L 415 35" class="stroke-theme-muted" marker-end="url(#arrow)" />

                  <rect x="415" y="20" width="100" height="30" rx="4" class="fill-base stroke-theme-muted" />
                  <text x="465" y="38" text-anchor="middle" class="fill-theme-primary font-bold">WORKERS (AI)</text>
                </g>
                <defs>
                  <marker id="arrow" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
                    <path d="M 0 2 L 8 5 L 0 8 z" class="fill-theme-muted" />
                  </marker>
                </defs>
              </svg>
            </div>
          )}

          {activeSlug !== 'electronic-first' && activeSlug !== 'signalstack' && (
            <div class="case-section py-6 border-b border-[var(--grid-line)]">
              <h3 class="font-mono text-tiny text-theme-muted uppercase tracking-wider mb-4">SYSTEM ARCHITECTURE</h3>
              <svg viewBox="0 0 600 80" class="w-full text-theme-muted" fill="none" stroke="currentColor">
                <g class="font-mono text-[10px]" stroke-width="1">
                  <rect x="5" y="20" width="90" height="30" rx="4" class="fill-base stroke-theme-muted" />
                  <text x="50" y="38" text-anchor="middle" class="fill-theme-primary font-bold">CLIENT</text>
                  <path d="M 95 35 L 155 35" class="stroke-theme-muted" marker-end="url(#arrow)" />

                  <rect x="155" y="20" width="120" height="30" rx="4" class="fill-base stroke-[var(--accent)]" />
                  <text x="215" y="38" text-anchor="middle" class="fill-[var(--accent)] font-bold">APPLICATION LAYER</text>
                  <path d="M 275 35 L 335 35" class="stroke-theme-muted" marker-end="url(#arrow)" />

                  <rect x="335" y="20" width="120" height="30" rx="4" class="fill-base stroke-theme-muted" />
                  <text x="395" y="38" text-anchor="middle" class="fill-theme-primary font-bold">MYSQL / DATABASE</text>
                </g>
                <defs>
                  <marker id="arrow" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
                    <path d="M 0 2 L 8 5 L 0 8 z" class="fill-theme-muted" />
                  </marker>
                </defs>
              </svg>
            </div>
          )}

          {activeData.thumbnail && (
            <div class="v3-panel-thumbnail mt-6 rounded overflow-hidden border border-[var(--border)] max-h-[360px] flex items-center justify-center bg-black/10">
              <img
                src={activeData.thumbnail}
                alt={`${activeData.title} screenshot`}
                class="w-full h-auto object-cover"
                loading="eager"
              />
            </div>
          )}

          <!-- Main Case Study Content (Storytelling order) -->
          <div class="v3-case-body mt-6 space-y-6">
            {activeData.problem && (
              <div class="case-section">
                <h3 class="font-mono text-tiny text-theme-muted uppercase tracking-wider mb-2">চ্যালেঞ্জ</h3>
                <p class="text-theme-secondary text-base leading-relaxed">{activeData.problem}</p>
              </div>
            )}

            {activeData.solution && (
              <div class="case-section">
                <h3 class="font-mono text-tiny text-[var(--accent)] uppercase tracking-wider mb-2">পদ্ধতি ও সমাধান</h3>
                <p class="text-theme-secondary text-base leading-relaxed">{activeData.solution}</p>
              </div>
            )}

            <!-- Scope Checklist -->
            {activeData.scope && activeData.scope.length > 0 && (
              <div class="case-section pt-6 border-t border-[var(--grid-line)]">
                <h3 class="font-mono text-tiny text-theme-muted uppercase tracking-wider mb-3">আমার অবদান</h3>
                <ul class="font-mono text-xs space-y-2 text-theme-secondary">
                  {activeData.scope.map((item) => (
                    <li class="flex items-center gap-2">
                      <span class="text-[var(--accent)] font-bold shrink-0">→</span>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            <!-- Technologies Used -->
            {activeData.tech && activeData.tech.length > 0 && (
              <div class="case-section pt-6 border-t border-[var(--grid-line)]">
                <h3 class="font-mono text-tiny text-theme-muted uppercase tracking-wider mb-3">ব্যবহৃত প্রযুক্তি</h3>
                <div class="flex flex-wrap gap-1.5">
                  {activeData.tech.map((s) => (
                    <span class="font-mono text-tiny px-2 py-0.5 rounded bg-[var(--grid-line)] text-theme-primary border border-[var(--border)]">{s}</span>
                  ))}
                </div>
              </div>
            )}

            {activeData.impact && (
              <div class="case-section pt-6 border-t border-[var(--grid-line)]">
                <h3 class="font-mono text-tiny text-[var(--accent)] uppercase tracking-wider mb-2">ফলাফল ও প্রভাব</h3>
                <div class="bg-[var(--accent-dim)] border border-[var(--accent)]/10 rounded-md p-4">
                  <p class="text-theme-primary font-medium text-sm leading-relaxed">{activeData.impact}</p>
                </div>
              </div>
            )}

            <!-- Highlights -->
            {activeData.highlights && activeData.highlights.length > 0 && (
              <div class="case-section pt-6 border-t border-[var(--grid-line)]">
                <h3 class="font-mono text-tiny text-theme-muted uppercase tracking-wider mb-3">ইঞ্জিনিয়ারিং সিদ্ধান্ত ও হাইলাইটস</h3>
                <ul class="space-y-2 font-sans text-sm text-theme-secondary pl-4 list-disc marker:text-[var(--accent)]">
                  {activeData.highlights.map((h) => <li>{h}</li>)}
                </ul>
              </div>
            )}
          </div>
        </div>
      </div>
    </section>

  </main>
</MainLayout>

<script is:inline>
  (function() {
    const searchInput = document.getElementById("proj-search");
    const tabButtons = document.querySelectorAll(".filter-tab");
    const projectItems = document.querySelectorAll(".explorer-item");

    let currentSearch = "";
    let currentTab = localStorage.getItem("projects-filter") || "all";

    // Set correct active tab class on load
    tabButtons.forEach((btn) => {
      if (btn.getAttribute("data-filter") === currentTab) {
        btn.classList.add("active");
      } else {
        btn.classList.remove("active");
      }
    });

    function filterProjects() {
      projectItems.forEach((item) => {
        const title = item.getAttribute("data-title")?.toLowerCase() || "";
        const description = item.getAttribute("data-desc")?.toLowerCase() || "";
        const type = item.getAttribute("data-type")?.toLowerCase() || "";
        const tags = item.getAttribute("data-tags")?.toLowerCase() || "";

        const matchesSearch = title.includes(currentSearch) || description.includes(currentSearch) || tags.includes(currentSearch);
        
        let matchesTab = true;
        if (currentTab === "backend") {
          matchesTab = type !== "frontend";
        } else if (currentTab === "frontend") {
          matchesTab = type === "frontend";
        }

        if (matchesSearch && matchesTab) {
          item.style.display = "flex";
        } else {
          item.style.display = "none";
        }
      });
    }

    // Run initial filter on load
    filterProjects();

    searchInput?.addEventListener("input", (e) => {
      currentSearch = e.target.value.toLowerCase();
      filterProjects();
    });

    tabButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        tabButtons.forEach((b) => b.classList.remove("active"));
        btn.classList.add("active");
        currentTab = btn.getAttribute("data-filter") || "all";
        localStorage.setItem("projects-filter", currentTab);
        filterProjects();
      });
    });

    // Mobile Drawer Toggle logic
    const mobileTrigger = document.getElementById("v3-mobile-explorer-trigger");
    const explorerRail = document.querySelector(".v3-explorer-rail");
    const backdrop = document.getElementById("v3-explorer-backdrop");
    const explorerItems = document.querySelectorAll(".explorer-item");

    if (mobileTrigger && explorerRail && backdrop) {
      mobileTrigger.addEventListener("click", () => {
        explorerRail.classList.toggle("v3-mobile-open");
        backdrop.classList.toggle("active");
      });

      backdrop.addEventListener("click", () => {
        explorerRail.classList.remove("v3-mobile-open");
        backdrop.classList.remove("active");
      });

      explorerItems.forEach(item => {
        item.addEventListener("click", () => {
          explorerRail.classList.remove("v3-mobile-open");
          backdrop.classList.remove("active");
        });
      });
    }
  })();
</script>

<style>
  /* Override shell padding for workbench pages — must fill flush */
  :global(.workspace-shell) {
    padding: 0 !important;
    max-width: none !important;
    display: flex;
    flex-direction: column;
    height: 100%;
  }
  :global(.scroll-container) {
    overflow: hidden !important;
  }

  .v3-workbench-container {
    display: grid;
    grid-template-columns: 24vw 1fr;
    width: 100%;
    height: 100%;
    flex: 1;
    background: var(--bg-base);
    overflow: hidden;
  }

  /* LEFT Explorer Sidebar styles */
  .v3-explorer-rail {
    display: flex;
    flex-direction: column;
    border-right: 1px solid var(--grid-line-strong);
    background: color-mix(in srgb, var(--text-primary) 1.5%, var(--bg-base));
    height: 100%;
    overflow: hidden;
  }

  .v3-explorer-header {
    padding: 12px 16px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    border-bottom: 1px solid var(--grid-line-strong);
  }

  .v3-explorer-title {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
  }

  .v3-explorer-search {
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
  }

  .v3-explorer-search input {
    background: var(--bg-base);
    border: 1px solid var(--border);
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    padding: 4px 8px 4px 22px;
    width: 100%;
    outline: none;
    border-radius: 6px;
  }

  .v3-explorer-search input:focus {
    border-color: var(--accent);
  }

  .v3-explorer-search svg {
    position: absolute;
    left: 6px;
    color: var(--text-muted);
    pointer-events: none;
  }

  .v3-explorer-tabs {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 4px;
  }

  .filter-tab {
    font-family: var(--font-sans);
