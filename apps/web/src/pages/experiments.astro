---
import { getCollection } from "astro:content";
import MainLayout from "@layouts/MainLayout.astro";
import { getLangFromUrl, useTranslations, useTranslatedPath } from "@i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const tp = useTranslatedPath(lang);

const all = await getCollection("projects");
const experiments = all.filter(
  (p) => (p.data.lang || "en") === lang && p.data.category === "experimental" && !p.data.hidden,
);
experiments.sort((a, b) => (a.data.position || 0) - (b.data.position || 0));

const categories = [
  { id: "all", label: "All Experiments" },
  { id: "game", label: "Games" },
  { id: "3d", label: "3D & WebGL" },
  { id: "creative", label: "Creative Tech" },
  { id: "web", label: "Web & Apps" },
];
---

<MainLayout
  title="Experiments & Creative Lab — Fazley Rabbi"
  description="Playable games, interactive 3D simulations, WebGL shaders, and creative coding experiments built for the web."
  ogTitle="Experiments & Creative Lab — Fazley Rabbi"
  ogDescription="Explore interactive 3D worlds, browser games, creative shaders, and playful web experiments built from scratch."
>
  <main class="experiments-page">
    <div class="experiments-container">

      <!-- Header -->
      <header class="experiments-header reveal">

        <h1 class="page-title">Experiments</h1>
        <p class="page-subtitle">
          Playable games, real-time 3D environments, generative math shaders, and tinkering projects exploring the edge of modern web capabilities.
        </p>

        <!-- AI-Assisted Workflow Callout -->
        <div class="ai-callout">
          <div class="ai-callout-icon" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/>
            </svg>
          </div>
          <div class="ai-callout-content">
            <span class="ai-callout-title">AI-Assisted Development:</span>
            <span class="ai-callout-desc">
              I actively use and experiment with modern AI-assisted coding tools, agentic workflows, and LLMs across these projects — accelerating procedural math, shader development, engine physics, asset generation, and rapid browser prototyping.
            </span>
          </div>
        </div>

        <!-- Stats Bar -->
        <div class="experiments-stats">
          <div class="stat-pill">
            <span class="stat-num">{experiments.length}</span>
            <span class="stat-label">Projects</span>
          </div>
          <span class="stat-divider">/</span>
          <div class="stat-pill">
            <span class="stat-num">WebGL & Canvas</span>
            <span class="stat-label">Graphics</span>
          </div>
          <span class="stat-divider">/</span>
          <div class="stat-pill">
            <span class="stat-num">Three.js & PixiJS</span>
            <span class="stat-label">Engines</span>
          </div>
          <span class="stat-divider">/</span>
          <div class="stat-pill">
            <span class="stat-num">AI Pair-Programmed</span>
            <span class="stat-label">Workflow</span>
          </div>
        </div>
      </header>

      <!-- Filter Controls -->
      <div class="filter-wrapper reveal">
        <div class="filter-chips" role="tablist" aria-label="Filter experiments by category">
          {categories.map((cat, idx) => (
            <button
              class:list={["filter-chip", { "is-active": idx === 0 }]}
              data-filter={cat.id}
              role="tab"
              aria-selected={idx === 0 ? "true" : "false"}
            >
              {cat.label}
            </button>
          ))}
        </div>
        <div class="filter-count" id="filter-count">
          Showing <span id="visible-count">{experiments.length}</span> of {experiments.length}
        </div>
      </div>

      <!-- Experiments Grid -->
      <div class="experiments-grid" id="experiments-grid">
        {experiments.map((item) => {
          const { title, description, type, status, tech, live, github, thumbnail, views_project } = item.data;
          const normType = (type || "").toLowerCase();
          
          let filterCat = "other";
          if (normType.includes("game")) filterCat = "game";
          else if (normType.includes("3d")) filterCat = "3d";
          else if (normType.includes("creative") || normType.includes("shader") || normType.includes("math")) filterCat = "creative";
          else if (normType.includes("web") || normType.includes("app") || normType.includes("archive")) filterCat = "web";

          const primaryLink = live || github || "#";

          return (
            <article
              class="experiment-card reveal"
              data-category={filterCat}
              data-title={title.toLowerCase()}
            >
              {/* Thumbnail Container */}
              <div class="card-thumb-container">
                <a
                  href={primaryLink}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="card-thumb-link"
                  tabindex="-1"
                  aria-label={`Open ${title}`}
                >
                  {thumbnail ? (
                    <img
                      src={thumbnail}
                      alt={title}
                      loading="lazy"
                      width="720"
                      height="405"
                      class="card-thumb-img"
                    />
                  ) : (
                    <div class="card-thumb-placeholder">
                      <span class="placeholder-icon">⚡</span>
                      <span class="placeholder-title">{title}</span>
                    </div>
                  )}
                  <div class="card-thumb-overlay">
                    <span class="overlay-action">
                      {live ? "Launch Demo ↗" : "View Source ↗"}
                    </span>
                  </div>
                </a>
              </div>

              {/* Card Body */}
              <div class="card-body">
                {/* Meta Header */}
                <div class="card-meta">
                  <span class="meta-tag meta-type">{type || "EXPERIMENT"}</span>
                  <span class="meta-dot">·</span>
                  <span class="meta-status">
                    <span class="status-indicator"></span>
                    {status || "ACTIVE"}
                  </span>
                  {views_project && (
                    <>
                      <span class="meta-dot">·</span>
                      <span class="meta-views" data-views-project={views_project} title="Live Views">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="views-icon"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                        <span class="views-count">--</span>
                      </span>
                    </>
                  )}
                </div>

                {/* Title */}
                <h2 class="card-title">
                  <a href={primaryLink} target="_blank" rel="noopener noreferrer">
                    {title}
                  </a>
                </h2>

                {/* Description */}
                <p class="card-desc">{description}</p>

                {/* Tech Pills */}
                {tech && tech.length > 0 && (
                  <div class="card-tags">
                    {tech.map((t) => (
                      <span class="tech-pill">{t}</span>
                    ))}
                  </div>
                )}

                {/* Footer Links */}
                <div class="card-footer">
                  {live && (
                    <a
                      href={live}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="action-btn action-btn--primary"
                    >
                      <span>Play / Launch</span>
                      <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/>
                      </svg>
                    </a>
                  )}
                  {github && (
                    <a
                      href={github}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="action-btn action-btn--ghost"
                    >
                      <svg width="14" height="14" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
                      </svg>
                      <span>Code</span>
                    </a>
                  )}
                </div>
              </div>
            </article>
          );
        })}
      </div>

      <!-- CTA -->
      <div class="experiments-cta reveal">
        <p>Want to build something like this? Hit me up on <a href="https://x.com/itsfazley" target="_blank" rel="noopener noreferrer">X&nbsp;↗</a> or email me at <a href="mailto:fazley111@gmail.com">fazley111@gmail.com</a></p>
      </div>

    </div>
  </main>
</MainLayout>

<script>
  function setupFilter() {
    const chips = document.querySelectorAll(".filter-chip");
    const cards = document.querySelectorAll<HTMLElement>(".experiment-card");
    const visibleCountEl = document.getElementById("visible-count");

    chips.forEach((chip) => {
      chip.addEventListener("click", () => {
        chips.forEach((c) => {
          c.classList.remove("is-active");
          c.setAttribute("aria-selected", "false");
        });
        chip.classList.add("is-active");
        chip.setAttribute("aria-selected", "true");

        const filter = chip.getAttribute("data-filter");
        let visible = 0;

        cards.forEach((card) => {
          const category = card.getAttribute("data-category");
          if (filter === "all" || category === filter) {
            card.style.display = "";
            card.style.opacity = "1";
            card.style.transform = "scale(1)";
            visible++;
          } else {
            card.style.display = "none";
          }
        });

        if (visibleCountEl) {
          visibleCountEl.textContent = String(visible);
        }
      });
    });
  }

  let viewsInterval;

  async function fetchViews() {
    const viewElements = document.querySelectorAll('.meta-views');
    if (!viewElements.length) return;

    for (const el of viewElements) {
      const project = el.getAttribute('data-views-project');
      if (!project) continue;

      const cacheKey = `views_cache_${project}`;
      const countEl = el.querySelector('.views-count');

      // 1. Show cached data immediately if available
      if (countEl && countEl.textContent === '--') {
        const cached = localStorage.getItem(cacheKey);
        if (cached) countEl.textContent = Number(cached).toLocaleString();
      }

      // 2. Fetch live data silently
      try {
        const res = await fetch(`https://views.fazleyrabbi.xyz/api/get?project=${project}&key=visitors`, { signal: AbortSignal.timeout(4000) });
        if (res.ok) {
          const data = await res.json();
          if (data && typeof data.views === 'number') {
            if (countEl) countEl.textContent = data.views.toLocaleString();
            localStorage.setItem(cacheKey, data.views.toString()); // Update cache
          }
        }
      } catch (e) {
        // Fail silently; cached data remains on screen
      }
    }
  }

  function initPage() {
    setupFilter();
    fetchViews();
    // Clear any existing interval to prevent duplicates during view transitions
    if (viewsInterval) clearInterval(viewsInterval);
    // Poll for live updates every 15 seconds
    viewsInterval = setInterval(fetchViews, 15000);
  }

  document.addEventListener("DOMContentLoaded", initPage);
  document.addEventListener("astro:page-load", initPage);
</script>

<style>
  .experiments-page {
    padding: clamp(2rem, 5vw, 4rem) 0 6rem;
  }

  .experiments-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 clamp(1.25rem, 4vw, 2rem);
  }

  /* Header */
  .experiments-header {
    margin-bottom: 3rem;
  }

  .header-badges {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }

  .header-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent);
  }

  .header-badge--ai {
    background: color-mix(in srgb, #8b5cf6 12%, transparent);
    border-color: color-mix(in srgb, #8b5cf6 30%, transparent);
  }

  .header-badge--ai .badge-label {
    color: #a78bfa;
  }

  .ai-sparkle-icon {
    color: #a78bfa;
  }

  .pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 8px var(--accent);
    animation: pulseGlow 2s infinite ease-in-out;
  }

  @keyframes pulseGlow {
    0%, 100% { opacity: 0.6; transform: scale(0.9); }
    50% { opacity: 1; transform: scale(1.2); }
  }

  .badge-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .page-title {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    margin: 0 0 1rem;
    line-height: 1.1;
  }

  .page-subtitle {
    font-family: var(--font-sans);
    font-size: clamp(1rem, 2vw, 1.125rem);
    color: var(--text-secondary);
    line-height: 1.6;
    max-width: 680px;
    margin: 0;
  }

  /* AI Callout */
  .ai-callout {
    display: flex;
    align-items: flex-start;
    gap: 0.875rem;
    padding: 0.875rem 1.25rem;
    border-radius: 12px;
    background: color-mix(in srgb, var(--accent) 5%, var(--bg-surface));
    border: 1px solid color-mix(in srgb, var(--accent) 20%, var(--border));
    margin: 1.5rem 0 1.75rem;
    max-width: 820px;
    backdrop-filter: blur(8px);
  }

  .ai-callout-icon {
    width: 28px;
    height: 28px;
    border-radius: 8px;
    background: color-mix(in srgb, var(--accent) 15%, transparent);
    color: var(--accent);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .ai-callout-content {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .ai-callout-title {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .ai-callout-desc {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    color: var(--text-secondary);
    line-height: 1.55;
  }

  .experiments-stats {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border);
  }

  .stat-pill {
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
  }

  .stat-num {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 0.875rem;
    color: var(--text-primary);
  }

  .stat-label {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .stat-divider {
    color: var(--border);
    font-size: 0.75rem;
    user-select: none;
  }

  /* Filters */
  .filter-wrapper {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 2.25rem;
    flex-wrap: wrap;
  }

  .filter-chips {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .filter-chip {
    padding: 0.4rem 0.85rem;
    border-radius: 9999px;
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--text-secondary);
    background: var(--bg-surface, rgba(255, 255, 255, 0.03));
    border: 1px solid var(--border);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .filter-chip:hover {
    color: var(--text-primary);
    border-color: var(--border-hover);
    background: color-mix(in srgb, var(--accent) 8%, var(--bg-surface));
  }

  .filter-chip.is-active {
    color: #ffffff;
    background: var(--accent);
    border-color: var(--accent);
    box-shadow: 0 4px 14px color-mix(in srgb, var(--accent) 35%, transparent);
  }

  .filter-count {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  /* Grid */
  .experiments-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
    gap: clamp(1.5rem, 3vw, 2.25rem);
  }

  @media (max-width: 640px) {
    .experiments-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Card */
  .experiment-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg, 14px);
    background: color-mix(in srgb, var(--bg-surface, #141419) 70%, var(--bg-base));
    overflow: hidden;
    transition: border-color 0.3s ease, transform 0.3s var(--ease-out-expo), box-shadow 0.3s ease;
    position: relative;
  }

  .experiment-card:hover {
    border-color: var(--border-hover);
    transform: translateY(-4px);
    box-shadow: 0 16px 36px -10px rgba(0, 0, 0, 0.35);
  }

  /* Thumbnail */
  .card-thumb-container {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
    background: var(--bg-surface);
  }

  .card-thumb-link {
    display: block;
    width: 100%;
    height: 100%;
    text-decoration: none;
    position: relative;
  }

  .card-thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s var(--ease-out-expo);
  }

  .experiment-card:hover .card-thumb-img {
    transform: scale(1.04);
  }

  .card-thumb-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    color: var(--text-muted);
  }

  .placeholder-icon {
    font-size: 2rem;
  }

  .placeholder-title {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 500;
  }

  .card-thumb-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(2px);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  .experiment-card:hover .card-thumb-overlay {
    opacity: 1;
  }

  .overlay-action {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.5rem 1rem;
    border-radius: 9999px;
    background: var(--accent);
    color: #ffffff;
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 600;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.4);
    transform: translateY(6px);
    transition: transform 0.25s ease;
  }

  .experiment-card:hover .overlay-action {
    transform: translateY(0);
  }

  /* Body */
  .card-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .meta-tag {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
  }

  .meta-dot {
    color: var(--text-muted);
    opacity: 0.4;
  }

  .meta-status {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .status-indicator {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 6px #10b981;
  }

  .meta-views {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: var(--text-muted);
  }

  .views-icon {
    opacity: 0.7;
  }

  .views-count {
    letter-spacing: 0.05em;
  }

  .card-title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0 0 0.5rem;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  .card-title a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .experiment-card:hover .card-title a {
    color: var(--accent);
  }

  .card-desc {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0 0 1.25rem;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Tags */
  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-bottom: 1.5rem;
  }

  .tech-pill {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--text-muted);
    background: var(--bg-surface, rgba(255, 255, 255, 0.04));
    border: 1px solid var(--border);
    padding: 0.2rem 0.5rem;
    border-radius: 6px;
    transition: all 0.15s ease;
  }

  .experiment-card:hover .tech-pill {
    border-color: var(--border-hover);
    color: var(--text-secondary);
  }

  /* Footer Actions */
  .card-footer {
