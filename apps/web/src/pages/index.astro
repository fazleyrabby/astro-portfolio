---
import MainLayout from "@layouts/MainLayout.astro";
import "../styles/modern-home.css";
import ModernHero from "@components/home/ModernHero.astro";
import ProjectsGrid from "@components/home/ProjectsGrid.astro";
import ExperienceTimeline from "@components/home/ExperienceTimeline.astro";
import SkillsSection from "@components/home/SkillsSection.astro";
import LatestNotes from "@components/home/LatestNotes.astro";
import ContactCTA from "@components/ContactCTA.astro";
import RequestRule from "@components/home/RequestRule.astro";
import HarborStrip from "@components/home/HarborStrip.astro";
---

<MainLayout title="Fazley Rabbi — Backend Engineer (Laravel)" bodyClass="modern-home" designContract="THESIS: Work within easy reach; compact split intro replaces the full-height harbor. OWN-WORLD: Cool white and charcoal surfaces, Bricolage Grotesque, sea teal actions, flat project captions, 14px imagery corners. STORY: Understand the engineer, inspect real projects, explore career and capabilities, read four posts, contact. FIRST VIEWPORT: 900px centered canvas; compact greeting and 104px portrait; work starts within the first viewport. FORM: User-approved reference synthesis: compact portfolio, fine system lines, charcoal dark mode; seed d1e1a1e0 overridden by pinned direction. FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, DESIGN.md, and every shipping raster carrying its provenance">
  <main class="port-home">
    <ModernHero />
    <RequestRule />

    <div id="cargo" class="home-sheet production-sheet">
      <div id="work"><ProjectsGrid /></div>

    </div>

    <div id="capabilities" class="home-sheet capabilities-sheet">
      <SkillsSection />
    </div>

    <div id="learning-to-ship" class="home-sheet career-sheet">
      <ExperienceTimeline />
    </div>

    <div id="lights-on" class="home-sheet writing-sheet">
      <LatestNotes />
      <ContactCTA />
    </div>
    <div class="port-end"><HarborStrip /></div>
  </main>
</MainLayout>
