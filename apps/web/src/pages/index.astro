---
import MainLayout from "@layouts/MainLayout.astro";
import Hero from "@components/Hero.astro";
import ProjectsGrid from "@components/home/ProjectsGrid.astro";
import ExperienceCompact from "@components/home/ExperienceCompact.astro";
import LatestNotes from "@components/home/LatestNotes.astro";
import ContactCTA from "@components/ContactCTA.astro";
---

<MainLayout title="Fazley Rabbi — Senior Backend Engineer & Systems Architect">
  <main class="v3-editorial-home">
    
    <!-- Hero block -->
    <Hero />

    <!-- Featured Projects block -->
    <ProjectsGrid />

    <!-- Experience Timeline block -->
    <ExperienceCompact />

    <!-- Writing / Notes block -->
    <LatestNotes />

    <!-- Contact Block -->
    <ContactCTA />

  </main>
</MainLayout>

<style>
  .v3-editorial-home {
    display: flex;
    flex-direction: column;
    width: 100%;
    max-width: 960px;
    margin: 0 auto;
    padding-bottom: 64px;
  }
</style>
