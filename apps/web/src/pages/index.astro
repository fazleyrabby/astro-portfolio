---
import MainLayout from "@layouts/MainLayout.astro";
import Hero from "@components/Hero.astro";
import ProjectsGrid from "@components/home/ProjectsGrid.astro";
import ExperienceCompact from "@components/home/ExperienceCompact.astro";
import SkillsSection from "@components/home/SkillsSection.astro";
import LatestNotes from "@components/home/LatestNotes.astro";
import ContactCTA from "@components/ContactCTA.astro";
---

<MainLayout title="Fazley Rabbi — Senior Backend Engineer & Systems Architect">
  <main>

    <!-- Hero -->
    <Hero />

    <!-- Featured Projects -->
    <ProjectsGrid />

    <!-- Experience Timeline -->
    <ExperienceCompact />

    <!-- Technical Capabilities & Stack -->
    <SkillsSection />

    <!-- Writing / Notes -->
    <LatestNotes />

    <!-- Contact -->
    <ContactCTA />

  </main>
</MainLayout>
