---
import MainLayout from "@layouts/MainLayout.astro";
import { Content as JourneyMarkdown } from "../content/journey.md";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<MainLayout 
  title="My Journey — Fazley Rabbi" 
  description="From early computing memories and custom ROM tinkering to backend engineering with Laravel — my personal and professional tech journey."
  ogImage="/images/journey-hero.png"
>
  <main class="journey-page">
    <div class="journey-container">
      <header class="journey-header reveal">
        <h1 class="page-title">My Journey</h1>
      </header>

      <!-- Hero Graphic -->
      <div class="journey-hero reveal">
        <img 
          src="/images/journey-hero.png" 
          alt="My Journey — From 2001 First Computer to Backend Developer"
          class="journey-hero-img"
          loading="eager"
          decoding="async"
        />
      </div>

      <div class="journey-content reveal">
        <article class="prose prose-neutral dark:prose-invert max-w-none">
          <JourneyMarkdown />
        </article>
      </div>
    </div>
  </main>
</MainLayout>

<style>
  .journey-page {
    padding: clamp(2rem, 5vw, 4rem) 0;
  }
  .journey-container {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 clamp(1.25rem, 4vw, 2rem);
  }
  .journey-header {
    margin-bottom: 2rem;
  }

  .journey-hero {
    margin-bottom: 2.5rem;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--bg-card);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
  }
  .journey-hero-img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  .journey-content :global(.prose) {
    font-size: 1rem;
    color: var(--text-secondary);
  }
  .journey-content :global(.prose h2) {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 500;
    color: var(--text-primary);
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    letter-spacing: -0.01em;
  }
  .journey-content :global(.prose h3) {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-style: italic;
    font-weight: 500;
    color: var(--text-primary);
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
  }
  .journey-content :global(.prose p) {
    font-family: var(--font-sans);
    font-size: 1rem;
    line-height: 1.75;
    color: var(--text-secondary);
    margin: 0.75rem 0;
  }
  .journey-content :global(.prose ul) {
    list-style-type: disc;
    padding-left: 1.25rem;
    margin: 0.75rem 0;
  }
  .journey-content :global(.prose li) {
    font-family: var(--font-sans);
    font-size: 1rem;
    line-height: 1.75;
    color: var(--text-secondary);
    margin: 0.375rem 0;
  }
  .journey-content :global(.prose strong) {
    color: var(--text-primary);
    font-weight: 600;
  }
  .journey-content :global(.prose hr) {
    border: none;
    border-top: 1px solid var(--border);
    margin: 2rem 0;
  }
  .journey-content :global(.prose blockquote) {
    border-left: 2px solid var(--accent);
    padding-left: 1rem;
    font-style: italic;
    color: var(--text-muted);
  }
</style>
