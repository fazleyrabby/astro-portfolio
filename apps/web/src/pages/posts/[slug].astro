---
// src/pages/posts/[slug].astro
import MainLayout from "@layouts/MainLayout.astro";
import TableOfContents from "@components/TableOfContents.astro";
import { getPostSlugs, getAllPosts, getFallbackPost, getTranslationPost } from "@lib/supabase-cache";
import { marked } from "marked";
import {
  getLangFromUrl,
  useTranslations,
  useTranslatedPath,
} from "../../i18n/utils";

const renderer = new marked.Renderer();
renderer.heading = function({ text, depth }) {
  const id = text.toLowerCase().replace(/[^\w]+/g, '-');
  return `<h${depth} id="${id}">${text}</h${depth}>`;
};
marked.use({ renderer });

export async function getStaticPaths() {
  const posts = await getPostSlugs();
  
  return posts.map((post) => ({
    params: { slug: post.slug },
  }));
}

const rawSlug = Astro.params.slug;
const activeSlug = rawSlug ? decodeURIComponent(rawSlug) : '';
const currentLang = Astro.url.pathname.startsWith('/bn/') ? 'bn' : 'en';
const lang = currentLang;
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const allPosts = await getAllPosts(lang);

let publishedPosts: any[] = [];
if (allPosts) {
  if (lang === "bn") {
    const bnPosts = allPosts.filter((p) => p.lang === "bn");
    const translatedEnIds = new Set(
      bnPosts.map((p) => p.translation_of).filter(Boolean),
    );
    publishedPosts = allPosts.filter((p) => {
      if (p.lang === "bn") return true;
      if (p.lang === "en" && !translatedEnIds.has(p.id)) return true;
      return false;
    });
  } else {
    publishedPosts = allPosts.filter((p) => p.lang === "en");
  }
}

// Find active post
let activePost = publishedPosts.find((p) => p.slug === activeSlug);

// Fallback to EN if BN version is not found
if (!activePost && currentLang === 'bn') {
  const fallback = await getFallbackPost(activeSlug);
  if (fallback) {
    activePost = fallback;
  }
}

if (!activePost) {
  return Astro.redirect('/404');
}

const seoDescription = activePost.description || activePost.title;
const activeContent = await marked.parse(activePost.content);

// Resolve alternate URL for LangToggle
let altUrl = undefined;
if (currentLang === 'en') {
  const altPost = await getTranslationPost(activePost.id, undefined, 'en');
  if (altPost) {
    altUrl = `/bn/posts/${altPost.slug}`;
  }
} else {
  if (activePost.lang === 'bn' && activePost.translation_of) {
    const altPost = await getTranslationPost(activePost.id, activePost.translation_of, 'bn');
    if (altPost) {
      altUrl = `/posts/${altPost.slug}`;
    }
  }
}

// Estimate reading time
const wordCount = activePost.content.split(/\s+/).length;
const readingTime = Math.max(1, Math.ceil(wordCount / 200));

// Prepare JSON-LD structured data
const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": activePost.title,
  "description": seoDescription,
  "image": activePost.cover_image || undefined,
  "datePublished": activePost.published_at || undefined,
  "dateModified": activePost.updated_at || activePost.published_at || undefined,
  "author": {
    "@type": "Person",
    "name": "Fazley Rabbi",
    "url": "https://fazleyrabbi.xyz"
  },
  "publisher": {
    "@type": "Person",
    "name": "Fazley Rabbi",
    "url": "https://fazleyrabbi.xyz"
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": `https://fazleyrabbi.xyz/posts/${activePost.slug}`
  },
  "wordCount": wordCount,
  "keywords": activePost.tags?.join(", ") || undefined
});
---

<MainLayout 
  title={`${activePost.title} — Fazley Rabbi`}
  description={seoDescription}
  ogTitle={activePost.title}
  ogDescription={seoDescription}
  ogImage={activePost.cover_image}
  ogUrl={`https://fazleyrabbi.xyz/posts/${activePost.slug}`}
  ogType="article"
  twitterCard="summary_large_image"
  twitterImage={activePost.cover_image}
  articlePublishedTime={activePost.published_at || undefined}
  articleModifiedTime={activePost.updated_at || activePost.published_at || undefined}
  articleAuthor="Fazley Rabbi"
  articleTags={activePost.tags || []}
  altUrl={altUrl}
>
  <script type="application/ld+json" set:html={jsonLd} />

  <article class="article-page">
    <div class="article-container">

      <!-- Back link -->
      <nav class="article-nav reveal">
        <a href={translatePath("/posts/")} class="article-back">
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18"/></svg>
          Back to Writing
        </a>
      </nav>

      <!-- Article Header -->
      <header class="article-header reveal">
        <div class="article-meta">
          <span class="article-date">
            {activePost.published_at
              ? new Date(activePost.published_at).toLocaleDateString(lang === "bn" ? "bn-BD" : "en-US", {
                  month: "long",
                  day: "numeric",
                  year: "numeric",
                })
              : "Draft"}
          </span>
          <span class="article-meta-dot">·</span>
          <span class="article-readtime">{readingTime} min read</span>
        </div>

        <h1 class="article-title">{activePost.title}</h1>

        {activePost.description && (
          <p class="article-subtitle">{activePost.description}</p>
        )}

        {activePost.tags && activePost.tags.length > 0 && (
          <div class="article-tags">
            {activePost.tags.map((tag: string) => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        )}
      </header>

      {/* Cover Image */}
      {activePost.cover_image && (
        <div class="article-cover reveal">
          <img src={activePost.cover_image} alt={activePost.title} loading="eager" />
        </div>
      )}

      <!-- Table of Contents -->
      <TableOfContents content={activePost.content} />

      <!-- Article Content -->
      <div class="article-body reveal" id="article-content" set:html={activeContent} />

      <!-- Article Footer -->
      <footer class="article-footer reveal">
        <div class="article-author">
          <img src="/me.webp" alt="Fazley Rabbi" class="author-avatar" width="48" height="48" />
          <div>
            <span class="author-name">Fazley Rabbi</span>
            <span class="author-bio">Backend engineer building scalable systems and production infrastructure.</span>
          </div>
        </div>
      </footer>

    </div>
  </article>

  <!-- Script for Code Block copy button, modal, and enhancement -->
  <script is:inline>
    (function () {
      function enhanceCodeBlocks() {
        const article = document.getElementById("article-content");
        if (!article) return;

        const pres = article.querySelectorAll("pre");
        pres.forEach((pre) => {
          if (pre.closest(".code-block-wrapper")) return;

          const wrapper = document.createElement("div");
          wrapper.className = "code-block-wrapper";

          const header = document.createElement("div");
          header.className = "code-block-header";

          const dots = document.createElement("div");
          dots.className = "code-block-dots";
          dots.innerHTML = '<span class="dot dot-red"></span><span class="dot dot-yellow"></span><span class="dot dot-green"></span>';

          const rightSection = document.createElement("div");
          rightSection.className = "code-block-right";

          const codeEl = pre.querySelector("code");
          const langClass = codeEl ? Array.from(codeEl.classList).find(c => c.startsWith("language-")) : "";
          const langName = langClass ? langClass.replace("language-", "") : "code";

          const langBadge = document.createElement("span");
          langBadge.className = "code-block-lang";
          langBadge.textContent = langName;

          const copyBtn = document.createElement("button");
          copyBtn.className = "code-block-copy";
          copyBtn.setAttribute("type", "button");
          copyBtn.innerHTML = `
            <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
            <span class="copy-text">Copy</span>
          `;

          copyBtn.addEventListener("click", async () => {
            const textToCopy = pre.innerText || pre.textContent;
            try {
              await navigator.clipboard.writeText(textToCopy);
              const copyText = copyBtn.querySelector(".copy-text");
              if (copyText) copyText.textContent = "Copied!";
              copyBtn.classList.add("copied");
              setTimeout(() => {
                if (copyText) copyText.textContent = "Copy";
                copyBtn.classList.remove("copied");
              }, 2000);
            } catch (err) {}
          });

          rightSection.appendChild(langBadge);
          rightSection.appendChild(copyBtn);

          header.appendChild(dots);
          header.appendChild(rightSection);

          pre.parentNode.insertBefore(wrapper, pre);
          wrapper.appendChild(header);
          wrapper.appendChild(pre);
        });
      }

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", enhanceCodeBlocks);
      } else {
        enhanceCodeBlocks();
      }
    })();
  </script>
</MainLayout>

<style>
  .article-page {
    padding: clamp(2rem, 5vw, 4rem) 0;
  }
  .article-container {
    max-width: 840px;
    margin: 0 auto;
    padding: 0 clamp(1.25rem, 4vw, 2rem);
  }

  .article-nav {
    margin-bottom: 2rem;
  }
  .article-back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .article-back:hover {
    color: var(--accent);
  }

  /* Header */
  .article-header {
    margin-bottom: 2.5rem;
  }

  .article-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
    margin-bottom: 1rem;
  }
  .article-meta-dot { opacity: 0.4; }

  .article-title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.625rem, 3vw, 2.25rem);
    line-height: 1.15;
    color: var(--text-primary);
    margin: 0 0 1rem;
    letter-spacing: -0.02em;
  }

  .article-subtitle {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.25rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin: 0 0 1.25rem;
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  /* Cover */
  .article-cover {
    margin-bottom: 2.5rem;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--border);
  }
  .article-cover img {
    width: 100%;
    height: auto;
    display: block;
  }

  /* Body */
  .article-body {
    margin-top: 2rem;
  }

  /* Footer Author */
  .article-footer {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }

  .article-author {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .author-avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--border);
    filter: grayscale(0.8);
  }
  .author-name {
    display: block;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.125rem;
    color: var(--text-primary);
  }
  .author-bio {
    display: block;
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    color: var(--text-muted);
    margin-top: 0.125rem;
  }
</style>
