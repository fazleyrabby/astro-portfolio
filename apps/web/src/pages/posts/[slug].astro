---
// src/pages/posts/[slug].astro
import MainLayout from "@layouts/MainLayout.astro";
import TableOfContents from "@components/TableOfContents.astro";
import { supabase } from "@lib/supabase";
import { marked } from "marked";
import {
  getLangFromUrl,
  useTranslations,
  useTranslatedPath,
} from "../../i18n/utils";

const renderer = new marked.Renderer();
renderer.heading = function({ text, depth }) {
  const id = text.toLowerCase().replace(/[^\w]+/g, '-');
  return `<h${depth} id="${id}">${text}</h${depth}>`;
};
marked.use({ renderer });

export async function getStaticPaths() {
  const { data: posts } = await supabase
    .from('posts')
    .select('slug')
    .eq('status', 'published');
  
  return (posts || []).map((post) => ({
    params: { slug: post.slug },
  }));
}

const rawSlug = Astro.params.slug;
const activeSlug = rawSlug ? decodeURIComponent(rawSlug) : '';
const currentLang = Astro.url.pathname.startsWith('/bn/') ? 'bn' : 'en';
const lang = currentLang;
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

// Fetch all posts for the explorer list
const { data: allPosts } = await supabase
  .from("posts")
  .select("*")
  .eq("status", "published")
  .in("lang", ["en", lang])
  .order("published_at", { ascending: false });

let publishedPosts: any[] = [];
if (allPosts) {
  if (lang === "bn") {
    const bnPosts = allPosts.filter((p) => p.lang === "bn");
    const translatedEnIds = new Set(
      bnPosts.map((p) => p.translation_of).filter(Boolean),
    );
    publishedPosts = allPosts.filter((p) => {
      if (p.lang === "bn") return true;
      if (p.lang === "en" && !translatedEnIds.has(p.id)) return true;
      return false;
    });
  } else {
    publishedPosts = allPosts.filter((p) => p.lang === "en");
  }
}

// Find active post
let activePost = publishedPosts.find((p) => p.slug === activeSlug);

// Fallback to EN if BN version is not found
if (!activePost && currentLang === 'bn') {
  const fallback = await supabase
    .from('posts')
    .select('*')
    .eq('slug', activeSlug)
    .eq('lang', 'en')
    .maybeSingle();
    
  if (fallback.data) {
    activePost = fallback.data;
  }
}

if (!activePost) {
  return Astro.redirect('/404');
}

const seoDescription = activePost.description || activePost.title;
const activeContent = await marked.parse(activePost.content);

// Resolve alternate URL for LangToggle
let altUrl = undefined;
if (currentLang === 'en') {
  const { data: altPost } = await supabase
    .from('posts')
    .select('slug')
    .eq('translation_of', activePost.id)
    .single();
  if (altPost) {
    altUrl = `/bn/posts/${altPost.slug}`;
  }
} else {
  if (activePost.lang === 'bn' && activePost.translation_of) {
    const { data: altPost } = await supabase
      .from('posts')
      .select('slug')
      .eq('id', activePost.translation_of)
      .single();
    if (altPost) {
      altUrl = `/posts/${altPost.slug}`;
    }
  }
}

// Estimate reading time
const wordCount = activePost.content.split(/\s+/).length;
const readingTime = Math.max(1, Math.ceil(wordCount / 200));

// Prepare JSON-LD structured data
const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": activePost.title,
  "description": seoDescription,
  "image": activePost.cover_image || undefined,
  "datePublished": activePost.published_at || undefined,
  "dateModified": activePost.updated_at || activePost.published_at || undefined,
  "author": {
    "@type": "Person",
    "name": "Fazley Rabbi",
    "url": "https://fazleyrabbi.xyz"
  },
  "publisher": {
    "@type": "Person",
    "name": "Fazley Rabbi",
    "url": "https://fazleyrabbi.xyz"
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": `https://fazleyrabbi.xyz/posts/${activePost.slug}`
  },
  "wordCount": wordCount,
  "keywords": activePost.tags?.join(", ") || undefined
});
---

<MainLayout 
  title={`${activePost.title} — Fazley Rabbi`}
  description={seoDescription}
  ogTitle={activePost.title}
  ogDescription={seoDescription}
  ogImage={activePost.cover_image}
  ogUrl={`https://fazleyrabbi.xyz/posts/${activePost.slug}`}
  ogType="article"
  twitterCard="summary_large_image"
  twitterImage={activePost.cover_image}
  articlePublishedTime={activePost.published_at || undefined}
  articleModifiedTime={activePost.updated_at || activePost.published_at || undefined}
  articleAuthor="Fazley Rabbi"
  articleTags={activePost.tags || []}
  altUrl={altUrl}
>
  <!-- Mobile Navigation Toggle Bar -->
  <div class="v3-mobile-toggle-bar border-b border-[var(--border)] px-4 py-2.5 flex items-center bg-[var(--bg-base)]">
    <button id="v3-mobile-explorer-trigger" class="flex items-center gap-2 font-sans text-xs font-bold text-theme-primary uppercase">
      <svg class="w-4 h-4 text-[var(--accent)]" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"/>
      </svg>
      <span>Select Article</span>
    </button>
  </div>

  <main class="v3-workbench-container">
    <div id="v3-explorer-backdrop" class="v3-explorer-backdrop"></div>
    
    <!-- LEFT SIDEBAR: Article Explorer -->
    <aside class="v3-explorer-rail">
      <div class="v3-explorer-header">
        <h2 class="v3-explorer-title font-sans">Writing</h2>
        
        <!-- Search bar -->
        <div class="v3-explorer-search">
          <input type="text" id="post-search" placeholder="Search articles..." />
          <svg width="11" height="11" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
        </div>
      </div>

      <!-- Articles list explorer -->
      <nav class="v3-explorer-list" id="explorer-list" data-lenis-prevent>
        {publishedPosts.map((p) => {
          const isSelected = p.slug === activeSlug;
          return (
            <a 
              href={translatePath(`/posts/${p.slug}`)}
              class={`explorer-item ${isSelected ? 'active' : ''}`}
              data-title={p.title}
              data-desc={p.description}
            >
              <span class="explorer-item-title font-sans font-bold text-sm text-theme-primary transition-colors">{p.title}</span>
              <p class="explorer-item-desc text-theme-muted text-xs line-clamp-1 mt-1">{p.description}</p>
              <div class="explorer-item-footer mt-1.5 flex items-center gap-2 font-mono text-[10px] text-theme-muted">
                <span>
                  {p.published_at
                    ? new Date(p.published_at).toLocaleDateString(lang === "bn" ? "bn-BD" : "en-US", {
                        month: "short",
                        day: "numeric",
                        year: "numeric"
                      })
                    : "Draft"}
                </span>
              </div>
            </a>
          );
        })}
      </nav>
    </aside>

    <!-- RIGHT PANEL: Article Reader -->
    <section class="v3-workbench-panel">
      <div class="v3-workbench-scroll" data-lenis-prevent>
        <article class="v3-content-wrapper max-w-[720px] mx-auto">
          {activePost.cover_image && (
            <div class="relative w-full rounded border border-[var(--border)] bg-[var(--bg-card)] mb-6 overflow-hidden flex justify-center items-center h-[260px]">
              <img 
                src={activePost.cover_image} 
                alt={activePost.title} 
                class="w-full h-full object-cover" 
                loading="eager"
              />
            </div>
          )}

          <!-- Article Header -->
          <div class="pb-6 border-b border-[var(--grid-line)] mb-6">
            <div class="flex items-center gap-2 mb-2 font-mono text-tiny text-theme-muted">
              <span>
                {activePost.published_at
                  ? new Date(activePost.published_at).toLocaleDateString(lang === "bn" ? "bn-BD" : "en-US", {
                      month: "long",
                      day: "numeric",
                      year: "numeric"
                    })
                  : "Draft"}
              </span>
              <span>•</span>
              <span>{readingTime} min read</span>
            </div>
            <h1 class="font-serif font-bold text-3xl md:text-4xl text-theme-primary leading-tight mb-4">{activePost.title}</h1>
            <p class="text-theme-secondary text-base leading-relaxed italic mb-6">{activePost.description}</p>

            <!-- Inline Bulletproof Share Buttons (Never gets hidden) -->
            <div class="flex items-center gap-2 pt-3 border-t border-[var(--grid-line)] border-dashed">
              <span class="font-mono text-[10px] text-theme-muted uppercase tracking-wider mr-2">Share:</span>
              
              <a href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(activePost.title)}&url=${encodeURIComponent(`https://fazleyrabbi.xyz/posts/${activePost.slug}`)}`}
                 target="_blank" rel="noopener noreferrer"
                 class="p-2 rounded bg-[var(--grid-line)] text-theme-primary hover:text-[var(--accent)] hover:bg-[var(--accent-dim)] border border-[var(--border)] transition-colors flex items-center justify-center"
                 title="Share on X">
                <svg class="w-[14px] h-[14px]" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                </svg>
              </a>

              <a href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(`https://fazleyrabbi.xyz/posts/${activePost.slug}`)}`}
                 target="_blank" rel="noopener noreferrer"
                 class="p-2 rounded bg-[var(--grid-line)] text-theme-primary hover:text-[var(--accent)] hover:bg-[var(--accent-dim)] border border-[var(--border)] transition-colors flex items-center justify-center"
                 title="Share on Facebook">
                <svg class="w-[14px] h-[14px]" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                </svg>
              </a>

              <a href={`https://www.linkedin.com/shareArticle?mini=true&url=${encodeURIComponent(`https://fazleyrabbi.xyz/posts/${activePost.slug}`)}&title=${encodeURIComponent(activePost.title)}`}
                 target="_blank" rel="noopener noreferrer"
                 class="p-2 rounded bg-[var(--grid-line)] text-theme-primary hover:text-[var(--accent)] hover:bg-[var(--accent-dim)] border border-[var(--border)] transition-colors flex items-center justify-center"
                 title="Share on LinkedIn">
                <svg class="w-[14px] h-[14px]" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                </svg>
              </a>

              <button id="share-copy-inline" class="p-2 rounded bg-[var(--grid-line)] text-theme-primary hover:text-[var(--accent)] hover:bg-[var(--accent-dim)] border border-[var(--border)] transition-colors flex items-center justify-center" aria-label="Copy link" title="Copy link">
                <svg class="w-[14px] h-[14px] share-copy-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/>
                </svg>
                <svg class="w-[14px] h-[14px] share-check-icon hidden text-[#22c55e]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                </svg>
              </button>
            </div>
          </div>

          <!-- Article Body content -->
          <div id="article-content" class="prose prose-neutral dark:prose-invert max-w-none font-sans text-base leading-relaxed text-theme-secondary" set:html={activeContent} />
        </article>
      </div>
    </section>

  </main>

  <TableOfContents />

  <script type="application/ld+json" set:html={jsonLd} />
</MainLayout>

<script is:inline>
  (function() {
    const searchInput = document.getElementById("post-search");
    const projectItems = document.querySelectorAll(".explorer-item");

    let currentSearch = "";

    function filterPosts() {
      projectItems.forEach((item) => {
        const title = item.getAttribute("data-title")?.toLowerCase() || "";
        const description = item.getAttribute("data-desc")?.toLowerCase() || "";

        const matchesSearch = title.includes(currentSearch) || description.includes(currentSearch);
        
        if (matchesSearch) {
          item.style.display = "flex";
        } else {
          item.style.display = "none";
        }
      });
    }

    searchInput?.addEventListener("input", (e) => {
      currentSearch = e.target.value.toLowerCase();
      filterPosts();
    });

    // Copy inline link handler
    const copyBtn = document.getElementById("share-copy-inline");
    copyBtn?.addEventListener("click", () => {
      navigator.clipboard.writeText(window.location.href).then(() => {
        const copyIcon = copyBtn.querySelector(".share-copy-icon");
        const checkIcon = copyBtn.querySelector(".share-check-icon");
        copyIcon?.classList.add("hidden");
        checkIcon?.classList.remove("hidden");
        
        setTimeout(() => {
          copyIcon?.classList.remove("hidden");
          checkIcon?.classList.add("hidden");
        }, 2000);
      });
    });

    // Mobile Drawer Toggle logic
    const mobileTrigger = document.getElementById("v3-mobile-explorer-trigger");
    const explorerRail = document.querySelector(".v3-explorer-rail");
    const backdrop = document.getElementById("v3-explorer-backdrop");
    const explorerItems = document.querySelectorAll(".explorer-item");

    if (mobileTrigger && explorerRail && backdrop) {
      mobileTrigger.addEventListener("click", () => {
        explorerRail.classList.toggle("v3-mobile-open");
        backdrop.classList.toggle("active");
      });

      backdrop.addEventListener("click", () => {
        explorerRail.classList.remove("v3-mobile-open");
        backdrop.classList.remove("active");
      });

      explorerItems.forEach(item => {
        item.addEventListener("click", () => {
          explorerRail.classList.remove("v3-mobile-open");
          backdrop.classList.remove("active");
        });
      });
    }
  })();
</script>

<style>
  /* Override shell padding for workbench pages — must fill flush */
  :global(.workspace-shell) {
    padding: 0 !important;
    max-width: none !important;
    display: flex;
    flex-direction: column;
    height: 100%;
  }
  :global(.scroll-container) {
    overflow: hidden !important;
  }

  .v3-workbench-container {
    display: grid;
    grid-template-columns: 24vw 1fr;
    width: 100%;
    height: 100%;
    flex: 1;
    background: var(--bg-base);
    overflow: hidden;
  }

  /* LEFT Explorer Sidebar styles */
  .v3-explorer-rail {
    display: flex;
    flex-direction: column;
    border-right: 1px solid var(--grid-line-strong);
    background: color-mix(in srgb, var(--text-primary) 1.5%, var(--bg-base));
    height: 100%;
    overflow: hidden;
  }

  .v3-explorer-header {
    padding: 12px 16px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    border-bottom: 1px solid var(--grid-line-strong);
  }

  .v3-explorer-title {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
  }

  .v3-explorer-search {
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
  }

  .v3-explorer-search input {
    background: var(--bg-base);
    border: 1px solid var(--border);
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    padding: 4px 8px 4px 22px;
    width: 100%;
    outline: none;
    border-radius: 6px;
  }

  .v3-explorer-search input:focus {
    border-color: var(--accent);
  }

  .v3-explorer-search svg {
    position: absolute;
    left: 6px;
    color: var(--text-muted);
    pointer-events: none;
  }

  .v3-explorer-list {
    flex: 1;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    padding: 4px 0;
  }

  .explorer-item {
    display: flex;
    flex-direction: column;
    padding: 10px 16px;
    border-left: 2px solid transparent;
    border-bottom: 1px solid var(--grid-line);
    text-decoration: none;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .explorer-item:hover {
    background: color-mix(in srgb, var(--text-primary) 2%, transparent);
  }

  .explorer-item.active {
    background: color-mix(in srgb, var(--accent) 5%, var(--bg-base));
    border-left-color: var(--accent);
  }

  .explorer-item.active .explorer-item-title {
    color: var(--accent);
    font-weight: 700;
  }

  /* RIGHT Content Panel styles */
  .v3-workbench-panel {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    background: var(--bg-base);
  }

  .v3-workbench-scroll {
    flex: 1;
    overflow-y: auto;
    padding: 24px 32px;
  }

  /* Mobile Drawer Toggle styles */
  .v3-mobile-toggle-bar {
    z-index: 45;
    position: sticky;
    top: 0;
    display: none;
  }
  
  .v3-explorer-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.4);
    z-index: 50;
    display: none;
  }
  .v3-explorer-backdrop.active {
    display: block;
  }

  @media (max-width: 900px) {
    .v3-mobile-toggle-bar {
      display: flex !important;
    }
    .v3-workbench-container {
      grid-template-columns: 1fr;
      height: 100% !important;
      overflow: hidden !important;
      position: relative;
    }
    .v3-explorer-rail {
      position: absolute;
      left: 0;
      top: 0;
      bottom: 0;
      width: 280px;
      height: 100% !important;
      z-index: 55;
      transform: translateX(-100%);
      transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
      box-shadow: 8px 0 24px rgba(0, 0, 0, 0.15);
      border-right: 1px solid var(--grid-line-strong);
      border-bottom: none;
    }
    .v3-explorer-rail.v3-mobile-open {
      transform: translateX(0);
    }
    .v3-workbench-panel {
      height: 100% !important;
      overflow: hidden !important;
    }
    .v3-workbench-scroll {
      height: calc(100% - 40px) !important;
      overflow-y: auto !important;
      padding: 16px;
    }
  }
</style>
