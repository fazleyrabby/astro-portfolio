---
import MainLayout from "@layouts/MainLayout.astro";
import { getAllPosts } from "@lib/supabase-cache";
import { marked } from "marked";
import {
  getLangFromUrl,
  useTranslations,
  useTranslatedPath,
} from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const allPosts = await getAllPosts(lang);

let publishedPosts: any[] = [];
if (allPosts) {
  if (lang === "bn") {
    const bnPosts = allPosts.filter((p) => p.lang === "bn");
    const translatedEnIds = new Set(
      bnPosts.map((p) => p.translation_of).filter(Boolean),
    );
    publishedPosts = allPosts.filter((p) => {
      if (p.lang === "bn") return true;
      if (p.lang === "en" && !translatedEnIds.has(p.id)) return true;
      return false;
    });
  } else {
    publishedPosts = allPosts.filter((p) => p.lang === "en");
  }
}

// Select latest post as active default for reader
const activePost = publishedPosts[0];
const activeContent = activePost ? await marked.parse(activePost.content) : "";
const wordCount = activePost ? activePost.content.split(/\s+/).length : 0;
const readingTime = Math.max(1, Math.ceil(wordCount / 200));

const allTags = [
  ...new Set(publishedPosts.flatMap((post: any) => post.tags || [])),
].sort();
---

<MainLayout title="Engineering Journal & Notes — Fazley Rabbi">
  <!-- Mobile Navigation Toggle Bar -->
  <div class="v3-mobile-toggle-bar border-b border-[var(--border)] px-4 py-2.5 flex items-center bg-[var(--bg-base)] hover:bg-[var(--accent-dim)] transition-colors cursor-pointer">
    <button id="v3-mobile-explorer-trigger" class="w-full flex items-center justify-between font-sans text-xs font-bold text-theme-primary uppercase text-left">
      <div class="flex items-center gap-2">
        <svg class="w-4 h-4 text-[var(--accent)]" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"/>
        </svg>
        <span>Select Article</span>
      </div>
      <span class="font-mono text-[9px] px-1.5 py-0.5 rounded bg-[var(--accent-dim)] text-[var(--accent)] border border-[var(--accent)] uppercase animate-pulse">Open Sidebar</span>
    </button>
  </div>

  <main class="v3-workbench-container">
    <div id="v3-explorer-backdrop" class="v3-explorer-backdrop"></div>
    
    <!-- LEFT SIDEBAR: Article Explorer -->
    <aside class="v3-explorer-rail">
      <div class="v3-explorer-header">
        <h2 class="v3-explorer-title font-sans">Writing</h2>
        
        <!-- Search bar -->
        <div class="v3-explorer-search">
          <input type="text" id="post-search" placeholder="Search articles..." />
          <svg width="11" height="11" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
        </div>
      </div>

      <!-- Articles list explorer -->
      <nav class="v3-explorer-list" id="explorer-list" data-lenis-prevent>
        {publishedPosts.map((p) => {
          const isSelected = activePost && p.slug === activePost.slug;
          return (
            <a 
              href={translatePath(`/posts/${p.slug}`)}
              class={`explorer-item ${isSelected ? 'active' : ''}`}
              data-title={p.title}
              data-desc={p.description}
            >
              <span class="explorer-item-title font-sans font-bold text-sm text-theme-primary transition-colors">{p.title}</span>
              <p class="explorer-item-desc text-theme-muted text-xs line-clamp-1 mt-1">{p.description}</p>
              <div class="explorer-item-footer mt-1.5 flex items-center gap-2 font-mono text-[10px] text-theme-muted">
                <span>
                  {p.published_at
                    ? new Date(p.published_at).toLocaleDateString(lang === "bn" ? "bn-BD" : "en-US", {
                        month: "short",
                        day: "numeric",
                        year: "numeric"
                      })
                    : "Draft"}
                </span>
              </div>
            </a>
          );
        })}
      </nav>
    </aside>

    <!-- RIGHT PANEL: Article Reader -->
    <section class="v3-workbench-panel">
      {activePost ? (
        <div class="v3-workbench-scroll" data-lenis-prevent>
          <article class="v3-content-wrapper max-w-[720px] mx-auto">
            {activePost.cover_image && (
              <div class="relative w-full rounded border border-[var(--border)] bg-[var(--bg-card)] mb-6 overflow-hidden flex justify-center items-center h-[260px]">
                <img 
                  src={activePost.cover_image} 
                  alt={activePost.title} 
                  class="w-full h-full object-cover" 
                  loading="eager"
                />
              </div>
            )}

            <!-- Article Header -->
            <div class="pb-6 border-b border-[var(--grid-line)] mb-6">
              <div class="flex items-center gap-2 mb-2 font-mono text-tiny text-theme-muted">
                <span>
                  {activePost.published_at
                    ? new Date(activePost.published_at).toLocaleDateString(lang === "bn" ? "bn-BD" : "en-US", {
                        month: "long",
                        day: "numeric",
                        year: "numeric"
                      })
                    : "Draft"}
                </span>
                <span>•</span>
                <span>{readingTime} min read</span>
              </div>
              <h1 class="font-serif font-bold text-2xl md:text-3xl text-theme-primary leading-tight mb-4">{activePost.title}</h1>
              <p class="text-theme-secondary text-base leading-relaxed italic">{activePost.description}</p>
            </div>

            <!-- Article Body content -->
            <div class="prose prose-neutral dark:prose-invert max-w-none font-sans text-base leading-relaxed text-theme-secondary" set:html={activeContent} />
          </article>
        </div>
      ) : (
        <div class="v3-workbench-empty flex flex-col items-center justify-center h-full text-center p-8">
          <span class="font-mono text-xs text-theme-muted uppercase tracking-widest mb-2">No Articles Deployed</span>
          <p class="text-theme-secondary text-sm">Write your first markdown post in the admin panel to telemetry active feed.</p>
        </div>
      )}
    </section>

  </main>
</MainLayout>

<script is:inline define:vars={{ txtCopy: t('blog.copy'), txtCopied: t('blog.copied') }}>
  (function() {
    // Wrap code blocks
    document.querySelectorAll('#article-content pre').forEach(pre => {
      const code = pre.querySelector('code');
      if (!code) return;
      
      const langClass = Array.from(code.classList).find(c => c.startsWith('language-'));
      const lang = langClass ? langClass.replace('language-', '') : 'text';
      const displayLang = lang.toUpperCase();
      
      const wrapper = document.createElement('div');
      wrapper.className = 'code-block-wrapper group relative my-6 rounded-lg overflow-hidden';
      wrapper.style.cssText = 'background-color:#1e1e2e;border:1px solid rgba(255,255,255,0.08);box-shadow:0 10px 30px rgba(0,0,0,0.2);';
      
      const header = document.createElement('div');
      header.className = 'code-header flex items-center justify-between px-4 py-2 border-b';
      header.style.cssText = 'background-color:#181825;border-bottom-color:rgba(255,255,255,0.08);';
      header.innerHTML = `
        <div class="flex items-center gap-2">
          <span class="text-[0.65rem] font-mono font-semibold px-2 py-0.5 rounded bg-[var(--accent)]/10 text-[var(--accent)]">${displayLang}</span>
        </div>
        <button class="copy-btn text-[0.65rem] font-mono px-2 py-0.5 rounded border border-[rgba(255,255,255,0.12)] text-[rgba(255,255,255,0.5)] hover:text-white hover:border-[var(--accent)] transition-all opacity-0 group-hover:opacity-100" style="background:transparent;">${txtCopy}</button>
      `;
      
      pre.parentNode.insertBefore(wrapper, pre);
      wrapper.appendChild(header);
      wrapper.appendChild(pre);
      pre.className = '!mt-0 !rounded-none !border-0 overflow-x-auto p-4 text-sm leading-relaxed';
      pre.style.cssText = 'background-color:#1e1e2e!important;color:#cdd6f4!important;margin:0!important;border:none!important;border-radius:0!important;';
      
      // Also force all code/span children to use light text
      code.style.cssText = 'color:#cdd6f4;background:transparent;';
      code.querySelectorAll('span').forEach(span => {
        span.style.color = '#cdd6f4';
        span.style.backgroundColor = 'transparent';
      });
      
      const btn = header.querySelector('.copy-btn');
      btn.addEventListener('click', async () => {
        await navigator.clipboard.writeText(code.textContent || '');
        btn.textContent = txtCopied;
        setTimeout(() => btn.textContent = txtCopy, 2000);
      });
    });

    const searchInput = document.getElementById("post-search");
    const projectItems = document.querySelectorAll(".explorer-item");

    let currentSearch = "";

    function filterPosts() {
      projectItems.forEach((item) => {
        const title = item.getAttribute("data-title")?.toLowerCase() || "";
        const description = item.getAttribute("data-desc")?.toLowerCase() || "";

        const matchesSearch = title.includes(currentSearch) || description.includes(currentSearch);
        
        if (matchesSearch) {
          item.style.display = "flex";
        } else {
          item.style.display = "none";
        }
      });
    }

    searchInput?.addEventListener("input", (e) => {
      currentSearch = e.target.value.toLowerCase();
      filterPosts();
    });

    // Mobile Drawer Toggle logic
    const mobileTrigger = document.getElementById("v3-mobile-explorer-trigger");
    const explorerRail = document.querySelector(".v3-explorer-rail");
    const backdrop = document.getElementById("v3-explorer-backdrop");
    const explorerItems = document.querySelectorAll(".explorer-item");

    if (mobileTrigger && explorerRail && backdrop) {
      mobileTrigger.addEventListener("click", () => {
        explorerRail.classList.toggle("v3-mobile-open");
        backdrop.classList.toggle("active");
      });

      backdrop.addEventListener("click", () => {
        explorerRail.classList.remove("v3-mobile-open");
        backdrop.classList.remove("active");
      });

      explorerItems.forEach(item => {
        item.addEventListener("click", () => {
          explorerRail.classList.remove("v3-mobile-open");
          backdrop.classList.remove("active");
        });
      });
    }
  })();
</script>

<style>
  /* Override shell padding for workbench pages — must fill flush */
  :global(.workspace-shell) {
    padding: 0 !important;
    max-width: none !important;
    display: flex;
    flex-direction: column;
    height: 100%;
  }
  :global(.scroll-container) {
    overflow: hidden !important;
  }

  .v3-workbench-container {
    display: grid;
    grid-template-columns: 24vw 1fr;
    width: 100%;
    height: 100%;
    flex: 1;
    background: var(--bg-base);
    overflow: hidden;
  }

  /* LEFT Explorer Sidebar styles */
  .v3-explorer-rail {
    display: flex;
    flex-direction: column;
    border-right: 1px solid var(--grid-line-strong);
    background: color-mix(in srgb, var(--text-primary) 1.5%, var(--bg-base));
    height: 100%;
    overflow: hidden;
  }

  .v3-explorer-header {
    padding: 12px 16px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    border-bottom: 1px solid var(--grid-line-strong);
  }

  .v3-explorer-title {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
  }

  .v3-explorer-search {
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
  }

  .v3-explorer-search input {
    background: var(--bg-base);
    border: 1px solid var(--border);
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    padding: 4px 8px 4px 22px;
    width: 100%;
    outline: none;
    border-radius: 6px;
  }

  .v3-explorer-search input:focus {
    border-color: var(--accent);
  }

  .v3-explorer-search svg {
    position: absolute;
    left: 6px;
    color: var(--text-muted);
    pointer-events: none;
  }

  .v3-explorer-list {
    flex: 1;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    padding: 4px 0;
  }

  .explorer-item {
    display: flex;
    flex-direction: column;
    padding: 10px 16px;
    border-left: 2px solid transparent;
    border-bottom: 1px solid var(--grid-line);
    text-decoration: none;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .explorer-item:hover {
    background: color-mix(in srgb, var(--text-primary) 2%, transparent);
  }

  .explorer-item.active {
    background: color-mix(in srgb, var(--accent) 5%, var(--bg-base));
    border-left-color: var(--accent);
  }

  .explorer-item.active .explorer-item-title {
    color: var(--accent);
    font-weight: 700;
  }

  /* RIGHT Content Panel styles */
  .v3-workbench-panel {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    background: var(--bg-base);
  }

  .v3-workbench-scroll {
    flex: 1;
    overflow-y: auto;
    padding: 24px 32px;
  }

  /* Mobile Drawer Toggle styles */
  .v3-mobile-toggle-bar {
    z-index: 45;
    position: sticky;
    top: 0;
    display: none;
  }
  
  .v3-explorer-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.4);
    z-index: 50;
    display: none;
  }
  .v3-explorer-backdrop.active {
    display: block;
  }

  @media (max-width: 900px) {
    .v3-mobile-toggle-bar {
      display: flex !important;
    }
    .v3-workbench-container {
      grid-template-columns: 1fr;
      height: 100% !important;
      overflow: hidden !important;
      position: relative;
    }
    .v3-explorer-rail {
      position: absolute;
      left: 0;
      top: 0;
      bottom: 0;
      width: 280px;
      height: 100% !important;
      z-index: 55;
      transform: translateX(-100%);
      transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
      box-shadow: 8px 0 24px rgba(0, 0, 0, 0.15);
      border-right: 1px solid var(--grid-line-strong);
      border-bottom: none;
    }
    .v3-explorer-rail.v3-mobile-open {
      transform: translateX(0);
    }
    .v3-workbench-panel {
      height: 100% !important;
      overflow: hidden !important;
    }
    .v3-workbench-scroll {
      height: calc(100% - 40px) !important;
      overflow-y: auto !important;
      padding: 16px;
    }
  }
</style>
