---
import MainLayout from "@layouts/MainLayout.astro";
import PortBanner from "@components/port/PortBanner.astro";
import { getAllPosts } from "@lib/supabase-cache";
import {
  getLangFromUrl,
  useTranslations,
  useTranslatedPath,
} from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const allPosts = await getAllPosts(lang);

let publishedPosts: any[] = [];
if (allPosts) {
  if (lang === "bn") {
    const bnPosts = allPosts.filter((p) => p.lang === "bn");
    const translatedEnIds = new Set(
      bnPosts.map((p) => p.translation_of).filter(Boolean),
    );
    publishedPosts = allPosts.filter((p) => {
      if (p.lang === "bn") return true;
      if (p.lang === "en" && !translatedEnIds.has(p.id)) return true;
      return false;
    });
  } else {
    publishedPosts = allPosts.filter((p) => p.lang === "en");
  }
}

const featuredPost = publishedPosts[0];
const archivePosts = publishedPosts.slice(1);
---

<MainLayout title="Engineering Journal & Notes — Fazley Rabbi">
  <PortBanner
    title="Blog"
    kicker="The lighthouse"
    lede="Notes on backend engineering, written down as I learn."
    motif="lighthouse"
  />
  <main class="posts-page">
    <div class="posts-container">

      {publishedPosts.length === 0 ? (
        <div class="posts-empty">{t("posts.emptyMsg") || "Synchronizing brain dump... no articles found yet."}</div>
      ) : (
        <div class="posts-layout">

          <!-- Featured post -->
          {featuredPost && (
            <article class="post-featured reveal">
              <div class="post-featured-body">
                <div class="post-meta">
                  <span class="post-badge">Featured Article</span>
                  <span class="post-date">
                    {featuredPost.published_at
                      ? new Date(featuredPost.published_at).toLocaleDateString(lang === "bn" ? "bn-BD" : "en-US", {
                          month: "long",
                          day: "numeric",
                          year: "numeric"
                        })
                      : "Draft"}
                  </span>
                </div>

                <h2 class="post-featured-title">
                  <a href={translatePath(`/posts/${featuredPost.slug}`)}>{featuredPost.title}</a>
                </h2>

                <p class="post-featured-desc">{featuredPost.description}</p>

                {featuredPost.tags && featuredPost.tags.length > 0 && (
                  <div class="post-tags">
                    {featuredPost.tags.map((tag: string) => (
                      <span class="tag">{tag}</span>
                    ))}
                  </div>
                )}

                <a href={translatePath(`/posts/${featuredPost.slug}`)} class="post-read-link">
                  Read Article
                  <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/></svg>
                </a>
              </div>
            </article>
          )}

          <!-- Archive list -->
          {archivePosts.length > 0 && (
            <div class="posts-archive reveal">
              <h2 class="archive-heading">All Articles</h2>
              <div class="archive-list">
                {archivePosts.map((post: any) => (
                  <article class="archive-item">
                    <div class="archive-main">
                      <h3 class="archive-title">
                        <a href={translatePath(`/posts/${post.slug}`)}>{post.title}</a>
                      </h3>
                      <p class="archive-desc">{post.description}</p>
                    </div>

                    <div class="archive-meta">
                      <span class="archive-date">
                        {post.published_at
                          ? new Date(post.published_at).toLocaleDateString(lang === "bn" ? "bn-BD" : "en-US", {
                              month: "short",
                              year: "numeric"
                            })
                          : "Draft"}
                      </span>
                    </div>
                  </article>
                ))}
              </div>
            </div>
          )}

        </div>
      )}

    </div>
  </main>
</MainLayout>

<style>
  .posts-page {
    padding: 48px 0 64px;
  }
  .posts-container {
    width: min(900px, calc(100% - 48px));
    margin: 0 auto;
  }

  .posts-empty {
    text-align: center;
    padding: 4rem 0;
    font-family: var(--font-sans);
    color: var(--text-muted);
  }

  .posts-layout {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  /* Featured Article */
  .post-featured {
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--bg-surface);
    padding: clamp(1.5rem, 3.5vw, 2.25rem);
    transition: border-color 180ms ease;
  }
  .post-featured:hover {
    border-color: var(--border-hover);
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }
  .post-badge {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-text);
    background: var(--accent-dim);
    padding: 3px 8px;
    border-radius: 6px;
  }
  .post-date {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-muted);
  }

  .post-featured-title {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: clamp(1.4rem, 2.5vw, 1.85rem);
    color: var(--text-primary);
    line-height: 1.25;
    margin: 0 0 0.75rem;
    letter-spacing: -0.025em;
  }
  .post-featured-title a {
    color: inherit;
    text-decoration: none;
    transition: color 180ms ease;
  }
  .post-featured-title a:hover {
    color: var(--accent-text);
  }

  .post-featured-desc {
    font-family: var(--font-sans);
    font-size: 15px;
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0 0 1.25rem;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 1.25rem;
  }

  .post-read-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 600;
    color: var(--accent-text);
    text-decoration: none;
    transition: color 180ms ease;
  }
  .post-read-link:hover {
    color: var(--accent-hover);
  }

  /* Archive */
  .archive-heading {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 22px;
    color: var(--text-primary);
    margin: 0 0 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border);
    letter-spacing: -0.02em;
  }

  .archive-list {
    display: flex;
    flex-direction: column;
  }

  .archive-item {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1.5rem;
    padding: 16px 0;
    border-bottom: 1px solid var(--border);
  }
  @media (max-width: 600px) {
    .archive-item {
      flex-direction: column;
      gap: 0.35rem;
    }
  }

  .archive-main {
    flex: 1;
  }
  .archive-title {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 16px;
    color: var(--text-primary);
    margin: 0 0 0.25rem;
    line-height: 1.35;
  }
  .archive-title a {
    color: inherit;
    display: inline-block;
    text-decoration: none;
  }
  .archive-title a:hover {
    color: var(--accent-text);
  }

  .archive-desc {
    font-family: var(--font-sans);
    font-size: 14px;
    color: var(--text-secondary);
    line-height: 1.55;
    margin: 0;
  }

  .archive-meta {
    white-space: nowrap;
    flex-shrink: 0;
  }
  .archive-date {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-muted);
  }

  @media (max-width: 640px) {
    .posts-page { padding: 36px 0 48px; }
    .posts-container { width: calc(100% - 40px); }
  }
</style>
