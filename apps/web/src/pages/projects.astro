---
import { getCollection } from "astro:content";
import MainLayout from "@layouts/MainLayout.astro";
import { getLangFromUrl, useTranslations, useTranslatedPath } from "@i18n/utils";
import { Image } from "astro:assets";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const tp = useTranslatedPath(lang);

const all = await getCollection("projects");
const projects = all.filter(
  (p) => (p.data.lang || "en") === lang && !p.data.hidden,
);
projects.sort((a, b) => (a.data.position || 0) - (b.data.position || 0));
---

<MainLayout title="Projects — Fazley Rabbi">
  <main class="projects-page">
    <div class="projects-page-container">

      <!-- Header -->
      <header class="projects-page-header reveal">
        <span class="page-kicker">Projects</span>
        <h1 class="page-title">Engineering Portfolio</h1>
        <p class="page-sub">Production systems, SaaS platforms, and backend infrastructure built for scale.</p>
      </header>

      <!-- Filter tabs -->
      <div class="projects-filters reveal">
        <button class="filter-pill active" data-filter="all">All</button>
        <button class="filter-pill" data-filter="backend">Backend</button>
        <button class="filter-pill" data-filter="frontend">Frontend</button>
      </div>

      <!-- Project Grid -->
      <div class="projects-grid" id="projects-grid">
        {projects.map((project) => {
          const { title, description, type, status, tech, live, github, thumbnail, problem, highlights } = project.data;
          const baseSlug = project.slug.replace(/-bn$/, "");
          const hasCase = !!(problem || (highlights && highlights.length));
          const href = hasCase ? tp(`/projects/${baseSlug}`) : (live || github || "#");

          return (
            <article
              class="project-card-editorial reveal"
              data-type={type || "backend"}
              data-title={title.toLowerCase()}
            >
              {/* Thumbnail */}
              <a href={href} class="project-card-thumb">
                {thumbnail ? (
                  <img
                    src={thumbnail}
                    alt={title}
                    loading="lazy"
                    width="600"
                    height="338"
                  />
                ) : (
                  <div class="project-card-placeholder">
                    <span>{title}</span>
                  </div>
                )}
              </a>

              {/* Content */}
              <div class="project-card-body">
                <div class="project-card-meta">
                  <span class="project-card-type">{type?.toUpperCase() || 'BACKEND'}</span>
                  <span class="project-card-dot">·</span>
                  <span class="project-card-status">{status?.toUpperCase() || 'ACTIVE'}</span>
                </div>

                <h2 class="project-card-title">
                  <a href={href}>{title}</a>
                </h2>

                <p class="project-card-desc">{description}</p>

                {/* Tech stack */}
                {tech && tech.length > 0 && (
                  <div class="project-card-tags">
                    {tech.slice(0, 5).map((t) => (
                      <span class="tag">{t}</span>
                    ))}
                    {tech.length > 5 && <span class="tag">+{tech.length - 5}</span>}
                  </div>
                )}

                {/* Links */}
                <div class="project-card-links">
                  {hasCase && (
                    <a href={href} class="project-card-link project-card-link--primary">
                      Case Study
                      <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/></svg>
                    </a>
                  )}
                  {live && (
                    <a href={live} target="_blank" rel="noreferrer" class="project-card-link">Live ↗</a>
                  )}
                  {github && (
                    <a href={github} target="_blank" rel="noreferrer" class="project-card-link">GitHub ↗</a>
                  )}
                </div>
              </div>
            </article>
          );
        })}
      </div>

    </div>
  </main>
</MainLayout>

<script is:inline>
  (function() {
    const tabs = document.querySelectorAll(".filter-pill");
    const cards = document.querySelectorAll(".project-card-editorial");

    let currentFilter = localStorage.getItem("projects-filter") || "all";

    // Set initial active tab
    tabs.forEach((tab) => {
      if (tab.getAttribute("data-filter") === currentFilter) {
        tab.classList.add("active");
      } else {
        tab.classList.remove("active");
      }
    });

    function applyFilter() {
      cards.forEach((card) => {
        const type = card.getAttribute("data-type") || "backend";
        let show = true;
        if (currentFilter === "backend") show = type !== "frontend";
        else if (currentFilter === "frontend") show = type === "frontend";
        card.style.display = show ? "" : "none";
      });
    }

    applyFilter();

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        tabs.forEach((t) => t.classList.remove("active"));
        tab.classList.add("active");
        currentFilter = tab.getAttribute("data-filter") || "all";
        localStorage.setItem("projects-filter", currentFilter);
        applyFilter();
      });
    });
  })();
</script>

<style>
  .projects-page {
    padding: clamp(2rem, 5vw, 4rem) 0;
  }
  .projects-page-container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 clamp(1.25rem, 4vw, 2rem);
  }

  .projects-page-header {
    margin-bottom: 2rem;
  }

  /* Filters */
  .projects-filters {
    display: flex;
    gap: 0.5rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
    flex-wrap: wrap;
  }
  .filter-pill {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 500;
    padding: 0.5rem 1rem;
    border-radius: 9999px;
    border: 1px solid var(--border);
    background: transparent;
    color: var(--text-secondary);
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .filter-pill:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .filter-pill.active {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }

  /* Grid */
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: clamp(1.5rem, 3vw, 2rem);
  }

  @media (max-width: 768px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Card */
  .project-card-editorial {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: border-color 0.3s ease, transform 0.3s var(--ease-out-expo);
  }
  .project-card-editorial:hover {
    border-color: var(--border-hover);
    transform: translateY(-2px);
  }

  .project-card-thumb {
    display: block;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
  }
  .project-card-thumb img {
    width: 100%;
    height: auto;
    aspect-ratio: 16/9;
    object-fit: cover;
    transition: transform 0.5s var(--ease-out-expo);
  }
  .project-card-editorial:hover .project-card-thumb img {
    transform: scale(1.03);
  }

  .project-card-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 16/9;
    background: var(--bg-surface);
    font-family: var(--font-display);
    font-size: 1.125rem;
    color: var(--text-muted);
    font-style: italic;
  }

  .project-card-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
  }

  .project-card-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }
  .project-card-type,
  .project-card-status {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .project-card-type { color: var(--text-muted); }
  .project-card-status { color: var(--accent); }
  .project-card-dot { color: var(--text-muted); opacity: 0.4; }

  .project-card-title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.25rem;
    color: var(--text-primary);
    margin: 0 0 0.5rem;
    letter-spacing: -0.01em;
    line-height: 1.2;
  }
  .project-card-title a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .project-card-editorial:hover .project-card-title a {
    color: var(--accent);
  }

  .project-card-desc {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0 0 1rem;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .project-card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-bottom: 1rem;
  }

  .project-card-links {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: auto;
  }
  .project-card-link {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.2s ease;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }
  .project-card-link:hover { color: var(--text-primary); }
  .project-card-link--primary { color: var(--accent); }
  .project-card-link--primary:hover { opacity: 0.8; }
</style>
