---
import { getCollection } from "astro:content";
import MainLayout from "@layouts/MainLayout.astro";
import PortBanner from "@components/port/PortBanner.astro";
import { getLangFromUrl, useTranslations, useTranslatedPath } from "@i18n/utils";
import { Image } from "astro:assets";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const tp = useTranslatedPath(lang);

const all = await getCollection("projects");
const projects = all.filter(
  (p) => (p.data.lang || "en") === lang && !p.data.hidden,
);
projects.sort((a, b) => (a.data.position || 0) - (b.data.position || 0));

const mainProjects = projects.filter((p) => p.data.category !== "experimental");

// Container paint colors, cycled across the cards.
const PAINT = ["#e8604c", "#f4b63f", "#2d8f8a", "#3f6fb5", "#f08a4b", "#7fb069"];
---

<MainLayout title="Projects — Fazley Rabbi">
  <PortBanner
    title="Projects"
    kicker="The container yard"
    lede="Production systems and products I've designed, built and kept running."
    motif="yard"
  />
  <main class="projects-page">
    <div class="projects-page-container">

      <!-- Projects Grid -->
      <div class="projects-grid">
        {mainProjects.map((project, index) => {
          const { title, description, type, status, tech, live, github, thumbnail, problem, highlights } = project.data;
          const baseSlug = project.slug.replace(/-bn$/, "");
          const hasCase = !!(problem || (highlights && highlights.length));
          const href = hasCase ? tp(`/projects/${baseSlug}`) : (live || github || "#");

          return (
            <article
              class="project-card-modern reveal"
              data-type={type || "backend"}
              data-title={title.toLowerCase()}
            >
              {/* Thumbnail */}
              <a href={href} class="project-thumb-frame">
                {thumbnail ? (
                  <img
                    src={thumbnail}
                    alt={title}
                    loading="lazy"
                    width="600"
                    height="338"
                  />
                ) : (
                  <div class="project-thumb-placeholder">
                    <span>{title}</span>
                  </div>
                )}
              </a>

              {/* Content */}
              <div class="project-card-body">
                <div class="project-card-meta">
                  <span class="project-card-type">{type?.toUpperCase() || 'BACKEND'}</span>
                  <span class="project-card-dot">·</span>
                  <span class="project-card-status">{status?.toUpperCase() || 'PRODUCTION'}</span>
                </div>

                <h2 class="project-card-title">
                  <a href={href}>{title}</a>
                </h2>

                <p class="project-card-desc">{description}</p>

                {/* Tech stack */}
                {tech && tech.length > 0 && (
                  <div class="project-card-tags">
                    {tech.slice(0, 5).map((t) => (
                      <span class="tag">{t}</span>
                    ))}
                    {tech.length > 5 && <span class="tag">+{tech.length - 5}</span>}
                  </div>
                )}

                {/* Links */}
                <div class="project-card-links">
                  {hasCase && (
                    <a href={href} class="project-card-link project-card-link--primary">
                      Case Study
                      <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/></svg>
                    </a>
                  )}
                  {live && (
                    <a href={live} target="_blank" rel="noreferrer" class="project-card-link">Live ↗</a>
                  )}
                  {github && (
                    <a href={github} target="_blank" rel="noreferrer" class="project-card-link">GitHub ↗</a>
                  )}
                </div>
              </div>
            </article>
          );
        })}
      </div>

    </div>
  </main>
</MainLayout>



<style>
  .projects-page {
    padding: 48px 0 64px;
  }
  .projects-page-container {
    width: min(900px, calc(100% - 48px));
    margin: 0 auto;
  }

  /* Grid */
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px 24px;
  }

  @media (max-width: 640px) {
    .projects-page { padding: 36px 0 48px; }
    .projects-page-container { width: calc(100% - 40px); }
    .projects-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }

  /* Card */
  .project-card-modern {
    display: flex;
    flex-direction: column;
    background: transparent;
    border: 0;
  }

  .project-thumb-frame {
    display: block;
    aspect-ratio: 1.8;
    padding: 16px;
    background: var(--bg-surface);
    border-radius: 14px;
    overflow: hidden;
    text-decoration: none;
    transition: transform 280ms var(--ease-out-expo);
  }
  .project-thumb-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    border-radius: 7px;
    transition: transform 300ms var(--ease-out-expo);
  }
  .project-thumb-frame:hover {
    transform: translateY(-3px);
  }
  .project-thumb-frame:hover img {
    transform: scale(1.025);
  }

  .project-thumb-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    border-radius: 7px;
    background: var(--bg-card);
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 600;
    color: var(--text-muted);
  }

  .project-card-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 16px 0 0;
  }

  .project-card-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }
  .project-card-type,
  .project-card-status {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .project-card-type { color: var(--text-muted); }
  .project-card-status { color: var(--accent-text); }
  .project-card-dot { color: var(--text-muted); opacity: 0.4; }

  .project-card-title {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 18px;
    color: var(--text-primary);
    margin: 0 0 6px;
    line-height: 1.25;
  }
  .project-card-title a {
    color: inherit;
    text-decoration: none;
    transition: color 180ms ease;
  }
  .project-card-title a:hover {
    color: var(--accent-text);
  }

  .project-card-desc {
    font-family: var(--font-sans);
    font-size: 14px;
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0 0 12px;
    max-width: 60ch;
  }

  .project-card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 12px;
  }

  .project-card-links {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: auto;
  }
  .project-card-link {
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 500;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 180ms ease;
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
  .project-card-link svg {
    transition: transform 220ms var(--ease-out-expo);
  }
  .project-card-link:hover { color: var(--text-primary); }
  .project-card-link:hover svg { transform: translateX(4px); }
  .project-card-link--primary { color: var(--accent-text); font-weight: 600; }
  .project-card-link--primary:hover { color: var(--accent-hover); }

  @media (prefers-reduced-motion: reduce) {
    .project-thumb-frame:hover, .project-thumb-frame:hover img { transform: none !important; }
    .project-card-link:hover svg { transform: none !important; }
  }
</style>
