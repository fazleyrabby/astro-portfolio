---
import { getCollection, type CollectionEntry } from 'astro:content';
import MainLayout from '@layouts/MainLayout.astro';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../../i18n/utils';

export async function getStaticPaths() {
  const all = await getCollection('projects');
  const en = all.filter(p => (p.data.lang || 'en') === 'en' && !p.data.hidden);
  return en.map(project => ({
    params: { slug: project.slug.replace(/-bn$/, '') },
    props: { project },
  }));
}

type Props = { project: CollectionEntry<'projects'> };
const { project } = Astro.props;
const activeData = project.data;
const activeSlug = project.slug.replace(/-bn$/, '');

const lang = 'en' as const;
const t = useTranslations(lang);
const tp = useTranslatedPath(lang);

// Resolve BN alt URL if a translation exists
const all = await getCollection('projects');
const bnSlug = project.slug + '-bn';
const hasBn = all.some(p => p.slug === bnSlug && p.data.lang === 'bn');
const altUrl = hasBn ? `/bn/projects/${activeSlug}` : undefined;

// Architectural diagnostic mapper helper
const getProjectMeta = (slug: string) => {
  const s = slug.replace(/-bn$/, '');
  let arch = "Monolithic MVC";
  let infra = "VPS Linux";
  
  if (s === "electronic-first") {
    arch = "Transactional Engine";
    infra = "Read Replicas";
  } else if (s === "signalstack") {
    arch = "Event-Driven Feed";
    infra = "Redis Queue";
  } else if (s === "hujjah") {
    arch = "Semantic Vector Search";
    infra = "Supabase pgvector";
  } else if (s === "litepos") {
    arch = "Multi-Business POS";
    infra = "Isolated DBs";
  } else if (s === "larabrix") {
    arch = "CMS Framework Component";
    infra = "CI/CD Pipeline";
  } else if (s === "lenden" || s === "e-bank") {
    arch = "Ledger Transaction";
    infra = "Stripe / Gateways";
  }
  return { arch, infra };
};

const { arch, infra } = getProjectMeta(activeSlug);
---

<MainLayout 
  title={`${activeData.title} — Case Study — Fazley Rabbi`}
  description={activeData.description}
  ogTitle={activeData.title}
  ogDescription={activeData.description}
  ogImage={activeData.thumbnail}
  ogUrl={`https://fazleyrabbi.xyz/projects/${activeSlug}`}
  ogType="article"
  twitterCard="summary_large_image"
  twitterImage={activeData.thumbnail}
  altUrl={altUrl}
>
  <article class="case-study-page">
    <div class="case-study-container">

      <!-- Navigation back -->
      <nav class="case-nav reveal">
        <a href={tp("/projects/")} class="case-back">
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18"/></svg>
          Back to Projects
        </a>
      </nav>

      <!-- Case Study Header -->
      <header class="case-header reveal">
        <div class="case-meta">
          <span class="case-type">{activeData.type?.toUpperCase() || 'BACKEND'}</span>
          <span class="case-meta-dot">·</span>
          <span class="case-status">{activeData.status?.toUpperCase() || 'PRODUCTION'}</span>
        </div>

        <h1 class="case-title">{activeData.title}</h1>
        <p class="case-subtitle">{activeData.description}</p>

        <!-- Actions -->
        <div class="case-actions">
          {activeData.live && (
            <a href={activeData.live} target="_blank" rel="noreferrer" class="btn-primary">
              Live Demo
              <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/></svg>
            </a>
          )}
          {activeData.github && (
            <a href={activeData.github} target="_blank" rel="noreferrer" class="btn-ghost">
              Repository ↗
            </a>
          )}
        </div>
      </header>

      <!-- Specs Bar -->
      <div class="case-specs reveal">
        <div class="spec-item">
          <span class="spec-label">Role</span>
          <span class="spec-value">{activeData.role || "Backend Architect"}</span>
        </div>
        <div class="spec-item">
          <span class="spec-label">Architecture</span>
          <span class="spec-value">{arch}</span>
        </div>
        <div class="spec-item">
          <span class="spec-label">Infrastructure</span>
          <span class="spec-value">{infra}</span>
        </div>
        <div class="spec-item">
          <span class="spec-label">Commits</span>
          <span class="spec-value">{activeData.commits ? `${activeData.commits.toLocaleString()}+` : "100+"}</span>
        </div>
      </div>

      <!-- Thumbnail Image -->
      {activeData.thumbnail && (
        <div class="case-thumbnail reveal">
          <img src={activeData.thumbnail} alt={`${activeData.title} screenshot`} loading="eager" />
        </div>
      )}

      <!-- Main Case Content -->
      <div class="case-content">

        {/* Problem */}
        {activeData.problem && (
          <section class="case-block reveal">
            <h2 class="case-section-title">The Challenge</h2>
            <p class="case-text">{activeData.problem}</p>
          </section>
        )}

        {/* Solution */}
        {activeData.solution && (
          <section class="case-block reveal">
            <h2 class="case-section-title case-section-title--accent">The Approach & Solution</h2>
            <p class="case-text">{activeData.solution}</p>
          </section>
        )}

        {/* Impact */}
        {activeData.impact && (
          <section class="case-block reveal">
            <h2 class="case-section-title case-section-title--accent">Outcomes & Results</h2>
            <div class="case-impact-box">
              <p>{activeData.impact}</p>
            </div>
          </section>
        )}

        {/* Contributions / Scope */}
        {activeData.scope && activeData.scope.length > 0 && (
          <section class="case-block reveal">
            <h2 class="case-section-title">Scope of Work</h2>
            <ul class="case-bullets">
              {activeData.scope.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </section>
        )}

        {/* Tech Stack */}
        {activeData.tech && activeData.tech.length > 0 && (
          <section class="case-block reveal">
            <h2 class="case-section-title">Technologies Used</h2>
            <div class="case-tags">
              {activeData.tech.map((s) => (
                <span class="tag">{s}</span>
              ))}
            </div>
          </section>
        )}

        {/* Highlights */}
        {activeData.highlights && activeData.highlights.length > 0 && (
          <section class="case-block reveal">
            <h2 class="case-section-title">Engineering Highlights</h2>
            <ul class="case-bullets">
              {activeData.highlights.map((h) => (
                <li>{h}</li>
              ))}
            </ul>
          </section>
        )}

      </div>

    </div>
  </article>
</MainLayout>

<style>
  .case-study-page {
    padding: clamp(2rem, 5vw, 4rem) 0;
  }
  .case-study-container {
    max-width: 760px;
    margin: 0 auto;
    padding: 0 clamp(1.25rem, 4vw, 2rem);
  }

  .case-nav {
    margin-bottom: 2rem;
  }
  .case-back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .case-back:hover {
    color: var(--accent);
  }

  /* Header */
  .case-header {
    margin-bottom: 2.5rem;
  }

  .case-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }
  .case-type, .case-status {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .case-type { color: var(--text-muted); }
  .case-status { color: var(--accent); }
  .case-meta-dot { color: var(--text-muted); opacity: 0.4; }

  .case-title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.625rem, 3vw, 2.25rem);
    line-height: 1.15;
    color: var(--text-primary);
    margin: 0 0 1rem;
    letter-spacing: -0.02em;
  }

  .case-subtitle {
    font-family: var(--font-sans);
    font-size: 1.125rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0 0 1.5rem;
  }

  .case-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  /* Specs Bar */
  .case-specs {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    padding: 1.5rem 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    margin-bottom: 2.5rem;
  }
  @media (max-width: 600px) {
    .case-specs { grid-template-columns: repeat(2, 1fr); }
  }

  .spec-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .spec-label {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .spec-value {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  /* Thumbnail */
  .case-thumbnail {
    margin-bottom: 3rem;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--border);
  }
  .case-thumbnail img {
    width: 100%;
    height: auto;
    display: block;
  }

  /* Content blocks */
  .case-content {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .case-section-title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.5rem;
    color: var(--text-primary);
    margin: 0 0 1rem;
    letter-spacing: -0.01em;
  }
  .case-section-title--accent {
    color: var(--accent);
  }

  .case-text {
    font-family: var(--font-sans);
    font-size: 1rem;
    color: var(--text-secondary);
    line-height: 1.75;
    margin: 0;
  }

  .case-impact-box {
    background: var(--accent-dim);
    border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent);
    border-radius: var(--radius-lg);
    padding: 1.25rem 1.5rem;
  }
  .case-impact-box p {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--text-primary);
    line-height: 1.6;
    margin: 0;
  }

  .case-bullets {
    list-style: disc;
    padding-left: 1.25rem;
    margin: 0;
  }
  .case-bullets li {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.65;
    margin-bottom: 0.5rem;
  }
  .case-bullets li::marker {
    color: var(--accent);
  }

  .case-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
</style>
