---
import SheetLayout from "@layouts/SheetLayout.astro";
import PortBanner from "@components/sheet/PageHeader.astro";
import { getCollection } from "astro:content";

const allResources = await getCollection("resources");

const sections = [
    { id: "php-laravel",      title: "PHP & Laravel" },
    { id: "blogs-articles",   title: "Blogs & Articles" },
    { id: "portfolios",       title: "Portfolio & UI Inspirations" },
    { id: "javascript",       title: "JavaScript" },
    { id: "youtube-tutorials",title: "Youtube & Tutorials" },
    { id: "miscellaneous",    title: "Miscellaneous" },
];

const getResources = (id) => allResources.find((r) => r.id === id)?.data || [];
---

<SheetLayout title="Resources">
    <PortBanner title="Resources" kicker="The harbor library" lede="A curated collection of helpful resources and inspirations." motif="bay" />
    <main class="resources-container sheet-body">

        {sections.map((section) => (
            <section class="res-section">
                <h2 class="sheet-label">{section.title}</h2>
                <ul class="res-list">
                    {getResources(section.id).map((item) => (
                        <li><a href={item.link} target="_blank" rel="noopener noreferrer">{item.text}</a></li>
                    ))}
                </ul>
            </section>
        ))}
    </main>
</SheetLayout>

<style>
  .resources-container {
    width: min(900px, calc(100% - 48px));
    margin: 0 auto;
    padding: 48px 0 64px;
  }
  @media (max-width: 640px) {
    .resources-container {
      width: calc(100% - 40px);
      padding: 36px 0 48px;
    }
  }
</style>
