---
import MainLayout from '@layouts/MainLayout.astro';
---

<MainLayout title="Resume — Fazley Rabbi">
  <main class="resume-page">
    <div class="resume-container">

      <!-- Header -->
      <header class="resume-header reveal">
        <div>
          <h1 class="page-title">Resume</h1>
        </div>
        <div class="resume-actions">
          <button id="print-resume" class="btn-primary print-btn">
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H7a2 2 0 00-2 2v4h10z"/></svg>
            Print Resume
          </button>
        </div>
      </header>

      <!-- CV Paper Body -->
      <div class="cv-card reveal">

        <!-- Contact Header -->
        <div class="cv-header">
          <h2 class="cv-name">Md Fazley Rabbi</h2>
          <p class="cv-tagline">Backend Engineer | PHP / Laravel | APIs & E-commerce</p>
          <div class="cv-contacts">
            <a href="mailto:fazley111@gmail.com">fazley111@gmail.com</a>
            <span class="cv-sep">|</span>
            <a href="https://linkedin.com/in/fazley-rabby" target="_blank">linkedin.com/in/fazley-rabby</a>
            <span class="cv-sep">|</span>
            <a href="https://github.com/fazleyrabby" target="_blank">github.com/fazleyrabby</a>
            <span class="cv-sep">|</span>
            <a href="https://fazleyrabbi.xyz" target="_blank">fazleyrabbi.xyz</a>
          </div>
        </div>

        <div class="cv-body">

          <!-- Professional Summary -->
          <section class="cv-section">
            <h3 class="cv-section-title">Professional Summary</h3>
            <p class="cv-summary">
              Backend Engineer with 5+ years of professional experience building production e-commerce and digital marketplace systems using PHP, Laravel, MySQL, REST APIs, Redis, and third-party integrations. Experienced in payments, fraud detection, asynchronous processing, database optimization, and scalable backend architecture.
            </p>
          </section>

          <!-- Technical Skills & Core Competencies -->
          <section class="cv-section">
            <h3 class="cv-section-title">Technical Skills & Core Competencies</h3>
            <div class="cv-skills-grid">
              <span class="cv-skill-cat">Languages</span>
              <span class="cv-skill-val">PHP, SQL, JavaScript</span>

              <span class="cv-skill-cat">Backend</span>
              <span class="cv-skill-val">Laravel, REST APIs, Queues</span>

              <span class="cv-skill-cat">Databases</span>
              <span class="cv-skill-val">MySQL, ClickHouse, Redis</span>

              <span class="cv-skill-cat">Infrastructure</span>
              <span class="cv-skill-val">Docker, Linux, Nginx, Git</span>

              <span class="cv-skill-cat">Payments</span>
              <span class="cv-skill-val">PayPal, Stripe, Checkout.com, Webhooks</span>

              <span class="cv-skill-cat">Other</span>
              <span class="cv-skill-val">Fraud Detection, API Design, Database Optimization</span>
            </div>
          </section>

          <!-- Work Experience -->
          <section class="cv-section">
            <h3 class="cv-section-title">Work Experience</h3>
            <div class="cv-entries">

              <!-- Electronic First -->
              <div class="cv-entry">
                <div class="cv-entry-head">
                  <div class="cv-entry-title-group">
                    <h4 class="cv-entry-company">Electronic First FZ LLE</h4>
                    <span class="cv-entry-role">Software Engineer (Backend / Laravel)</span>
                  </div>
                  <div class="cv-entry-meta">
                    <span class="cv-entry-location">Remote, UAE</span>
                    <span class="cv-entry-date">Oct 2021 – Present</span>
                  </div>
                </div>
                <ul class="cv-list">
                  <li>Architect and maintain backend systems for a high-volume digital marketplace processing thousands of daily transactions and orders.</li>
                  <li>Engineered bundle product architectures and multi-gateway checkout with dynamic currency conversion, driving a 30%+ increase in sales and lifting Average Order Value (AOV).</li>
                  <li>Designed and deployed an automated checkout fraud detection engine using IP/card/email velocity checks, BIN/ASN validation, and risk scoring to mitigate payment chargebacks.</li>
                  <li>Built real-time dispute and chargeback webhook synchronization pipelines for PayPal and Checkout.com, eliminating manual financial reconciliation workflows.</li>
                  <li>Integrated global payment providers including Checkout.com, PayPal, Apple Pay, and Google Pay with idempotent webhook handlers and transaction logging.</li>
                  <li>Built ClickHouse-powered analytics pipelines delivering sub-second reporting for high-volume customer behavior, transaction fees, and revenue metrics.</li>
                  <li>Optimized backend scalability and database latency by introducing MySQL read replicas and Redis caching for heavy search and reporting workloads.</li>
                  <li>Designed versioned REST APIs powering web applications, mobile apps, and automated customer support services.</li>
                </ul>
                <p class="cv-tech">
                  <strong>Technologies:</strong> PHP, Laravel, MySQL, ClickHouse, Redis, REST APIs, Queue Workers, Docker, Linux, PayPal, Checkout.com
                </p>
              </div>

              <!-- AMCoders -->
              <div class="cv-entry">
                <div class="cv-entry-head">
                  <div class="cv-entry-title-group">
                    <h4 class="cv-entry-company">AMCoders</h4>
                    <span class="cv-entry-role">Laravel Developer</span>
                  </div>
                  <div class="cv-entry-meta">
                    <span class="cv-entry-location">Remote, Bangladesh</span>
                    <span class="cv-entry-date">Jan 2021 – Jul 2021</span>
                  </div>
                </div>
                <ul class="cv-list">
                  <li>Developed client web applications and RESTful APIs using Laravel, MySQL, and modern frontend integrations.</li>
                  <li>Built a Bus Ticket Booking platform with interactive reservation and automated ticket issuance using Laravel and Inertia.js.</li>
                  <li>Integrated multiple international and regional payment gateways including Stripe, PayPal, Razorpay, Flutterwave, Mollie, and Paystack.</li>
                  <li>Contributed to portfolio builder platforms, project management tools, and online banking modules.</li>
                </ul>
                <p class="cv-tech">
                  <strong>Technologies:</strong> Laravel, PHP, MySQL, Inertia.js, JavaScript, REST APIs, Git
                </p>
              </div>

              <!-- Freelance -->
              <div class="cv-entry">
                <div class="cv-entry-head">
                  <div class="cv-entry-title-group">
                    <h4 class="cv-entry-company">Freelance</h4>
                    <span class="cv-entry-role">Backend / Web Developer</span>
                  </div>
                  <div class="cv-entry-meta">
                    <span class="cv-entry-location">Self-Employed</span>
                    <span class="cv-entry-date">Jan 2020 – Present</span>
                  </div>
                </div>
                <ul class="cv-list">
                  <li>Delivered custom PHP and Laravel solutions including POS, ERP, Library Management, and CMS systems for business clients.</li>
                  <li>Designed relational database schemas, secure authentication workflows, role-based access control (RBAC), and REST APIs.</li>
                  <li>Conducted performance optimization, legacy code refactoring, and automated deployment maintenance.</li>
                </ul>
                <p class="cv-tech">
                  <strong>Technologies:</strong> PHP, Laravel, CodeIgniter, MySQL, REST APIs, JavaScript, Git
                </p>
              </div>

            </div>
          </section>

          <!-- Key Projects -->
          <section class="cv-section">
            <h3 class="cv-section-title">Key Projects</h3>
            <div class="cv-entries">
              <div class="cv-entry">
                <h4 class="cv-project-title">
                  <span class="cv-project-name">E-Bank</span>
                  <span class="cv-project-sub">— Online banking system with DPS, loan management & multi-gateway payments</span>
                </h4>
                <ul class="cv-list">
                  <li>Engineered core banking backend with Deposit Pension Schemes (DPS), automated loan schedules, and account transaction ledgers.</li>
                  <li>Integrated multi-gateway payment processing with automated webhook callbacks and double-entry balance verification.</li>
                </ul>
                <p class="cv-tech">
                  <strong>Technologies:</strong> PHP, Laravel, MySQL, JavaScript, REST APIs, Payment Gateways
                </p>
              </div>

              <div class="cv-entry">
                <h4 class="cv-project-title">
                  <span class="cv-project-name">Routine Management System</span>
                  <span class="cv-project-sub">— University scheduling & automated conflict-detection engine</span>
                </h4>
                <ul class="cv-list">
                  <li>Designed automated scheduling system modeling 15 interconnected entities (teachers, batches, rooms, courses, and time slots).</li>
                  <li>Eliminated scheduling double-booking with real-time conflict validation and dynamic PDF timetable generation.</li>
                </ul>
                <p class="cv-tech">
                  <strong>Technologies:</strong> PHP, Laravel, MySQL, jQuery, REST APIs
                </p>
              </div>
            </div>
          </section>

          <!-- Education & Languages -->
          <section class="cv-section cv-section--last">
            <h3 class="cv-section-title">Education &amp; Languages</h3>
            <div class="cv-edu-list">
              <div class="cv-edu-item">
                <div>
                  <h4 class="cv-edu-school">Port City International University</h4>
                  <span class="cv-edu-degree">B.Sc. in Computer Science & Engineering</span>
                </div>
                <span class="cv-edu-year">2020</span>
              </div>
              <div class="cv-edu-item">
                <div>
                  <h4 class="cv-edu-school">Daffodil Institute of IT</h4>
                  <span class="cv-edu-degree">Diploma in Computer Technology</span>
                </div>
                <span class="cv-edu-year">2016</span>
              </div>
            </div>
            <p class="cv-languages">
              <strong>Languages:</strong> Bengali (Native), English (Professional Working Proficiency)
            </p>
          </section>

        </div>
      </div>

    </div>
  </main>
</MainLayout>

<script>
  document.getElementById("print-resume")?.addEventListener("click", () => window.print());
</script>

<style>
  .resume-page {
    padding: clamp(2rem, 5vw, 4rem) 0;
  }
  .resume-container {
    max-width: 860px;
    margin: 0 auto;
    padding: 0 clamp(1.25rem, 4vw, 2rem);
  }

  .resume-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 2.5rem;
    gap: 1rem;
  }

  .resume-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .print-btn {
    padding: 0.5rem 1rem;
    font-size: 0.8125rem;
    border-radius: var(--radius);
  }

  /* CV Card Frame */
  .cv-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: clamp(1.5rem, 4vw, 3rem);
  }

  .cv-header {
    text-align: center;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 2rem;
  }
  .cv-name {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.5rem, 3vw, 2rem);
    color: var(--text-primary);
    margin: 0 0 0.25rem;
  }
  .cv-tagline {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--accent);
    margin: 0 0 0.75rem;
  }
  .cv-contacts {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.5rem 0.75rem;
    font-family: var(--font-sans);
    font-size: 0.875rem;
  }
  .cv-contacts a {
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .cv-contacts a:hover {
    color: var(--accent);
  }
  .cv-sep {
    color: var(--text-muted);
    opacity: 0.4;
  }

  .cv-body {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .cv-section {
    padding-bottom: 1.75rem;
    border-bottom: 1px solid var(--border);
  }
  .cv-section--last {
    padding-bottom: 0;
    border-bottom: none;
  }

  .cv-section-title {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 0.875rem;
  }

  .cv-summary {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  .cv-entries {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .cv-entry-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }
  .cv-entry-company {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.125rem;
    color: var(--text-primary);
    margin: 0;
  }
  .cv-entry-role {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--text-secondary);
    font-style: italic;
  }
  .cv-entry-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
  }
  @media (max-width: 600px) {
    .cv-entry-meta { align-items: flex-start; }
  }

  .cv-list {
    list-style: disc;
    padding-left: 1.25rem;
    margin: 0.5rem 0;
  }
  .cv-list li {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 0.375rem;
  }
  .cv-list li::marker {
    color: var(--accent);
  }

  .cv-tech {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    color: var(--text-muted);
    margin: 0.5rem 0 0;
  }
  .cv-tech strong {
    color: var(--text-secondary);
    font-weight: 600;
  }

  /* Projects */
  .cv-project-title {
    font-size: 0.9375rem;
    margin: 0 0 0.375rem;
  }
  .cv-project-name {
    font-family: var(--font-display);
    font-weight: 500;
    color: var(--text-primary);
  }
  .cv-project-sub {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--text-secondary);
    font-style: italic;
    font-weight: 400;
  }

  /* Skills Grid */
  .cv-skills-grid {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: 0.625rem 1rem;
    font-family: var(--font-sans);
    font-size: 0.875rem;
  }
  @media (max-width: 480px) {
    .cv-skills-grid { grid-template-columns: 1fr; }
  }
  .cv-skill-cat {
    font-weight: 600;
    color: var(--text-primary);
  }
  .cv-skill-val {
    color: var(--text-secondary);
  }

  /* Education */
  .cv-edu-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .cv-edu-item {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }
  .cv-edu-school {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1rem;
    color: var(--text-primary);
    margin: 0;
  }
  .cv-edu-degree {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--text-secondary);
    font-style: italic;
  }
  .cv-edu-year {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  /* Well-Balanced A4/Letter Print Stylesheet */
  @media print {
    @page {
      size: A4 portrait;
      margin: 7mm 11mm;
    }
    :global(html), :global(body) {
      background: #ffffff !important;
      color: #000000 !important;
      font-family: Georgia, serif !important;
      font-size: 8.55pt !important;
      line-height: 1.32 !important;
      width: 100% !important;
      margin: 0 !important;
      padding: 0 !important;
    }
    :global(header), :global(footer), :global(.site-nav), .resume-header, .print-btn, .case-nav, .article-nav, :global(.fixed) {
      display: none !important;
    }
    :global(.pt-16) {
      padding-top: 0 !important;
    }
    :global(.reveal) {
      opacity: 1 !important;
      transform: none !important;
    }
    .resume-page, .resume-container, .cv-card {
      padding: 0 !important;
      margin: 0 !important;
      max-width: 100% !important;
      width: 100% !important;
      border: none !important;
      box-shadow: none !important;
      background: transparent !important;
    }
    .cv-card,
    .cv-card *,
    .cv-card a,
    .cv-card span,
    .cv-card p,
    .cv-card h2,
    .cv-card h3,
    .cv-card h4,
    .cv-card li,
    .cv-name,
    .cv-tagline,
    .cv-summary,
    .cv-section-title,
    .cv-entry-company,
    .cv-entry-role,
    .cv-entry-meta,
    .cv-entry-location,
    .cv-entry-date,
    .cv-project-name,
    .cv-project-sub,
    .cv-edu-school,
    .cv-edu-degree,
    .cv-edu-year,
    .cv-skill-cat,
    .cv-skill-val,
    .cv-languages {
      font-family: Georgia, serif !important;
      color: #000000 !important;
    }
    .cv-header {
      padding-bottom: 5pt !important;
      margin-bottom: 5pt !important;
      border-bottom: 1.2pt solid #000000 !important;
      text-align: center !important;
      break-inside: avoid !important;
      page-break-inside: avoid !important;
    }
    .cv-name {
      font-size: 16.5pt !important;
      font-weight: 700 !important;
      color: #000000 !important;
      margin-bottom: 2pt !important;
      line-height: 1.1 !important;
    }
    .cv-tagline {
      font-size: 9.1pt !important;
      font-weight: 600 !important;
      color: #000000 !important;
      margin: 0 0 2.5pt !important;
    }
    .cv-contacts {
      font-size: 8.3pt !important;
      color: #000000 !important;
      gap: 2pt 7pt !important;
      justify-content: center !important;
    }
    .cv-contacts a {
      color: #000000 !important;
      text-decoration: none !important;
    }
    .cv-body {
      gap: 5pt !important;
    }
    .cv-section {
      padding-bottom: 4.5pt !important;
      border-bottom: 0.5pt solid #cccccc !important;
    }
    .cv-section--last {
      border-bottom: none !important;
      padding-bottom: 0 !important;
    }
    .cv-section-title {
      font-size: 9.1pt !important;
      color: #000000 !important;
      margin-bottom: 2.5pt !important;
      letter-spacing: 0.08em !important;
      font-weight: 700 !important;
    }
    .cv-summary {
      font-size: 8.5pt !important;
      line-height: 1.32 !important;
      color: #000000 !important;
      margin: 0 !important;
    }
    .cv-entries {
      gap: 4pt !important;
    }
    .cv-entry {
      page-break-inside: avoid !important;
      break-inside: avoid !important;
    }
    .cv-entry-head {
      margin-bottom: 0.8pt !important;
    }
    .cv-entry-company {
      font-size: 9.3pt !important;
      font-weight: 700 !important;
      color: #000000 !important;
    }
    .cv-entry-role {
      font-size: 8.5pt !important;
      color: #000000 !important;
    }
    .cv-entry-meta {
      font-size: 8.1pt !important;
      color: #000000 !important;
    }
    .cv-list {
      margin: 1.2pt 0 !important;
      padding-left: 11pt !important;
    }
    .cv-list li {
      font-size: 8.4pt !important;
      line-height: 1.30 !important;
      margin-bottom: 1.2pt !important;
      color: #000000 !important;
    }
    .cv-list li::marker {
      color: #000000 !important;
    }
    .cv-tech {
      font-size: 8.1pt !important;
      margin: 1.2pt 0 0 !important;
      color: #000000 !important;
      line-height: 1.26 !important;
    }
    .cv-project-title {
      margin-bottom: 0.8pt !important;
      font-size: 9.1pt !important;
    }
    .cv-project-name {
      font-weight: 700 !important;
      color: #000000 !important;
    }
    .cv-project-sub {
      font-size: 8.5pt !important;
    }
    .cv-skills-grid {
      grid-template-columns: 135px 1fr !important;
      gap: 1.8pt 7pt !important;
      font-size: 8.4pt !important;
      line-height: 1.30 !important;
      page-break-inside: avoid !important;
      break-inside: avoid !important;
    }
    .cv-skill-cat {
      font-weight: 700 !important;
      color: #000000 !important;
    }
    .cv-skill-val {
      color: #000000 !important;
    }
    .cv-edu-list {
      gap: 2pt !important;
    }
    .cv-edu-item {
      display: flex !important;
      justify-content: space-between !important;
      align-items: baseline !important;
      page-break-inside: avoid !important;
      break-inside: avoid !important;
    }
    .cv-edu-school {
      font-size: 8.9pt !important;
      font-weight: 700 !important;
      color: #000000 !important;
    }
    .cv-edu-degree {
      font-size: 8.4pt !important;
      color: #000000 !important;
    }
    .cv-edu-year {
      font-size: 8pt !important;
      color: #000000 !important;
    }
    .cv-languages {
      font-size: 8.4pt !important;
      margin: 2.5pt 0 0 !important;
      color: #000000 !important;
      line-height: 1.28 !important;
    }
  }
</style>
