---
import MainLayout from '@layouts/MainLayout.astro';
---

<MainLayout title="Resume — Fazley Rabbi">
  <main class="resume-page">
    <div class="resume-container">

      <!-- Header -->
      <header class="resume-header reveal">
        <div>
          <h1 class="page-title">Resume</h1>
        </div>
        <div class="resume-actions">
          <button id="print-resume" class="btn-primary print-btn">
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H7a2 2 0 00-2 2v4h10z"/></svg>
            Print Resume
          </button>
        </div>
      </header>

      <!-- CV Paper Body -->
      <div class="cv-card reveal">

        <!-- Contact Header -->
        <div class="cv-header">
          <h2 class="cv-name">Md Fazley Rabbi</h2>
          <div class="cv-contacts">
            <a href="mailto:fazley111@gmail.com">fazley111@gmail.com</a>
            <span class="cv-sep">|</span>
            <a href="https://linkedin.com/in/fazley-rabby" target="_blank">linkedin.com/in/fazley-rabby</a>
            <span class="cv-sep">|</span>
            <a href="https://github.com/fazleyrabby" target="_blank">github.com/fazleyrabby</a>
            <span class="cv-sep">|</span>
            <a href="https://fazleyrabbi.xyz" target="_blank">fazleyrabbi.xyz</a>
          </div>
        </div>

        <div class="cv-body">

          <!-- Work Experience -->
          <section class="cv-section">
            <h3 class="cv-section-title">Work Experience</h3>
            <div class="cv-entries">

              <!-- Electronic First -->
              <div class="cv-entry">
                <div class="cv-entry-head">
                  <div class="cv-entry-title-group">
                    <h4 class="cv-entry-company">Electronic First FZ LLE</h4>
                    <span class="cv-entry-role">Software Engineer (Laravel)</span>
                  </div>
                  <div class="cv-entry-meta">
                    <span class="cv-entry-location">Remote, UAE</span>
                    <span class="cv-entry-date">Oct 2021 – Present</span>
                  </div>
                </div>
                <ul class="cv-list">
                  <li>Develop and maintain backend systems for a high-volume digital marketplace processing thousands of daily orders.</li>
                  <li>Contributed to the architecture and implementation of bundle product features (category systems, currency-aware pricing, and multi-gateway checkout), driving at least 30% more sales and lifting Average Order Value (AOV).</li>
                  <li>Designed and implemented a configurable checkout fraud detection engine using IP, card, and email velocity checks, BIN/ASN validation, bot detection, and risk scoring to automate payment risk assessment.</li>
                  <li>Built real-time dispute and chargeback synchronization for PayPal and Checkout.com using webhooks, eliminating manual reconciliation workflows.</li>
                  <li>Designed versioned REST APIs powering web applications, mobile applications, and AI-assisted customer support services.</li>
                  <li>Built ClickHouse-powered analytics dashboards for customer behaviour, sales performance, payment gateway metrics, and operational reporting.</li>
                  <li>Improved backend scalability by introducing database read replicas for high-frequency search and reporting workloads.</li>
                  <li>Integrated multiple payment providers including Checkout.com, PayPal, Apple Pay, and Google Pay.</li>
                </ul>
                <p class="cv-tech">
                  <strong>Technologies:</strong> Laravel, PHP, MySQL, ClickHouse, Redis, Docker, Linux, REST APIs, PayPal, Checkout.com
                </p>
              </div>

              <!-- AMCoders -->
              <div class="cv-entry">
                <div class="cv-entry-head">
                  <div class="cv-entry-title-group">
                    <h4 class="cv-entry-company">AMCoders</h4>
                    <span class="cv-entry-role">Laravel Developer</span>
                  </div>
                  <div class="cv-entry-meta">
                    <span class="cv-entry-location">Remote, Bangladesh</span>
                    <span class="cv-entry-date">Jan 2021 – Jul 2021</span>
                  </div>
                </div>
                <ul class="cv-list">
                  <li>Developed client applications using Laravel and modern web technologies.</li>
                  <li>Built a Bus Ticket Booking platform with Laravel and Inertia.js.</li>
                  <li>Developed a Portfolio Builder and Project Management System.</li>
                  <li>Integrated multiple payment gateways including Stripe, PayPal, Razorpay, Flutterwave, Mollie, Paystack, Instamojo, ToyyibPay, and PayU.</li>
                  <li>Contributed to an online banking platform and business management systems.</li>
                </ul>
                <p class="cv-tech">
                  <strong>Technologies:</strong> Laravel, PHP, MySQL, Inertia.js, JavaScript, Git
                </p>
              </div>

              <!-- Freelance -->
              <div class="cv-entry">
                <div class="cv-entry-head">
                  <div class="cv-entry-title-group">
                    <h4 class="cv-entry-company">Freelance</h4>
                    <span class="cv-entry-role">Web Developer</span>
                  </div>
                  <div class="cv-entry-meta">
                    <span class="cv-entry-location">Self-Employed</span>
                    <span class="cv-entry-date">Jan 2020 – Present</span>
                  </div>
                </div>
                <ul class="cv-list">
                  <li>Delivered custom PHP and Laravel solutions for startups and local businesses.</li>
                  <li>Developed POS, Education Management, Library Management, CMS, and business management systems.</li>
                  <li>Built REST APIs, authentication systems, and administrative dashboards.</li>
                  <li>Performed application maintenance, feature development, and performance optimization.</li>
                </ul>
                <p class="cv-tech">
                  <strong>Technologies:</strong> PHP, Laravel, CodeIgniter, MySQL, REST APIs, JavaScript, jQuery
                </p>
              </div>

            </div>
          </section>

          <!-- Projects -->
          <section class="cv-section">
            <h3 class="cv-section-title">Projects</h3>
            <div class="cv-entries">
              <div class="cv-entry">
                <h4 class="cv-project-title">
                  <span class="cv-project-name">Electronic First Core Platform</span>
                  <span class="cv-project-sub">— High-volume digital retail marketplace processing thousands of daily orders</span>
                </h4>
                <ul class="cv-list">
                  <li>Built order checkout flows supporting card, PayPal, Coinbase, and internal e-wallet transactions.</li>
                  <li>Engineered bundle deals and bundle product systems with dynamic currency-aware pricing and multi-gateway checkout, achieving at least a 30% increase in sales.</li>
                  <li>Implemented Automated Gift Card and License Delivery flows using queue workers and stock syncing.</li>
                  <li>Developed business dashboard tools for tracking gate transaction fees, salary distributions, and store metrics.</li>
                </ul>
                <p class="cv-tech">
                  <strong>Technologies:</strong> Laravel, MySQL, ClickHouse, Queue Workers, Redis, Docker
                </p>
              </div>

              <div class="cv-entry">
                <h4 class="cv-project-title">
                  <span class="cv-project-name">SignalStack</span>
                  <span class="cv-project-sub">— Real-time feed ingestion and distillation pipeline</span>
                </h4>
                <ul class="cv-list">
                  <li>Designed an asynchronous data pipeline using queue architecture to handle high-volume feed processing.</li>
                  <li>Built a multi-provider failover chain (local → Groq → OpenRouter) to distill feeds at near-zero inference cost.</li>
                  <li>Implemented Redis caching and automated scoring workflows to filter and tag incoming signals.</li>
                </ul>
                <p class="cv-tech">
                  <strong>Technologies:</strong> Node.js, NestJS, Redis, Queue Systems, Groq, OpenRouter
                </p>
              </div>

              <p class="cv-other-projects">
                <strong>Other Projects:</strong> Hujjah (privacy-first Islamic research engine), LitePOS (POS + e-commerce), DailyLOG (personal Life OS), Larabrix (Laravel module system)
              </p>
            </div>
          </section>

          <!-- Technical Skills -->
          <section class="cv-section">
            <h3 class="cv-section-title">Technical Skills</h3>
            <div class="cv-skills-grid">
              <span class="cv-skill-cat">Backend</span>
              <span class="cv-skill-val">Laravel, PHP, REST APIs, Livewire, CodeIgniter</span>

              <span class="cv-skill-cat">Frontend</span>
              <span class="cv-skill-val">Alpine.js, Tailwind CSS, JavaScript, jQuery, Bootstrap</span>

              <span class="cv-skill-cat">Databases</span>
              <span class="cv-skill-val">MySQL, ClickHouse, SQLite, Redis</span>

              <span class="cv-skill-cat">Infrastructure</span>
              <span class="cv-skill-val">Docker, Docker Compose, Nginx, Linux, Cloudflare Tunnel, Git, GitHub Actions</span>

              <span class="cv-skill-cat">DevOps / Security</span>
              <span class="cv-skill-val">VPS Hardening, UFW, SSH Key Management, Zero-Trust Networking</span>

              <span class="cv-skill-cat">Integrations</span>
              <span class="cv-skill-val">Payment Gateways, Webhooks, Queue Workers, LLM APIs (Groq, OpenRouter)</span>
            </div>
          </section>

          <!-- Current Focus -->
          <section class="cv-section">
            <h3 class="cv-section-title">Current Focus</h3>
            <ul class="cv-list">
              <li>System design and scalable backend architecture</li>
              <li>Async processing, queues, and event-driven systems</li>
              <li>Real-time pipelines and data processing workflows</li>
              <li>Infrastructure and containerized development environments</li>
            </ul>
          </section>

          <!-- Education -->
          <section class="cv-section">
            <h3 class="cv-section-title">Education</h3>
            <div class="cv-edu-list">
              <div class="cv-edu-item">
                <div>
                  <h4 class="cv-edu-school">Port City International University</h4>
                  <span class="cv-edu-degree">B.Sc. in Computer Science & Engineering</span>
                </div>
                <span class="cv-edu-year">2020</span>
              </div>
              <div class="cv-edu-item">
                <div>
                  <h4 class="cv-edu-school">Daffodil Institute of IT</h4>
                  <span class="cv-edu-degree">Diploma in Computer Technology</span>
                </div>
                <span class="cv-edu-year">2016</span>
              </div>
            </div>
          </section>

          <!-- Languages -->
          <section class="cv-section cv-section--last">
            <h3 class="cv-section-title">Languages</h3>
            <p class="cv-languages">
              <strong>Bengali</strong> (Native), <strong>English</strong> (Fluent)
            </p>
          </section>

        </div>
      </div>

    </div>
  </main>
</MainLayout>

<script>
  document.getElementById("print-resume")?.addEventListener("click", () => window.print());
</script>

<style>
  .resume-page {
    padding: clamp(2rem, 5vw, 4rem) 0;
  }
  .resume-container {
    max-width: 860px;
    margin: 0 auto;
    padding: 0 clamp(1.25rem, 4vw, 2rem);
  }

  .resume-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 2.5rem;
    gap: 1rem;
  }

  .resume-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .print-btn {
    padding: 0.5rem 1rem;
    font-size: 0.8125rem;
    border-radius: var(--radius);
  }

  /* CV Card Frame */
  .cv-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: clamp(1.5rem, 4vw, 3rem);
  }

  .cv-header {
    text-align: center;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 2rem;
  }
  .cv-name {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.5rem, 3vw, 2rem);
    color: var(--text-primary);
    margin: 0 0 0.5rem;
  }
  .cv-contacts {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.5rem 0.75rem;
    font-family: var(--font-sans);
    font-size: 0.875rem;
  }
  .cv-contacts a {
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .cv-contacts a:hover {
    color: var(--accent);
  }
  .cv-sep {
    color: var(--text-muted);
    opacity: 0.4;
  }

  .cv-body {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .cv-section {
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }
  .cv-section--last {
    padding-bottom: 0;
    border-bottom: none;
  }

  .cv-section-title {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 1rem;
  }

  .cv-entries {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .cv-entry-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }
  .cv-entry-company {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.125rem;
    color: var(--text-primary);
    margin: 0;
  }
  .cv-entry-role {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--text-secondary);
    font-style: italic;
  }
  .cv-entry-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
  }
  @media (max-width: 600px) {
    .cv-entry-meta { align-items: flex-start; }
  }

  .cv-list {
    list-style: disc;
    padding-left: 1.25rem;
    margin: 0.5rem 0;
  }
  .cv-list li {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 0.375rem;
  }
  .cv-list li::marker {
    color: var(--accent);
  }

  .cv-tech {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    color: var(--text-muted);
    margin: 0.5rem 0 0;
  }
  .cv-tech strong {
    color: var(--text-secondary);
    font-weight: 600;
  }

  /* Projects */
  .cv-project-title {
    font-size: 0.9375rem;
    margin: 0 0 0.375rem;
  }
  .cv-project-name {
    font-family: var(--font-display);
    font-weight: 500;
    color: var(--text-primary);
  }
  .cv-project-sub {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--text-secondary);
    font-style: italic;
    font-weight: 400;
  }
  .cv-other-projects {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--text-muted);
    margin: 0.5rem 0 0;
  }

  /* Skills Grid */
  .cv-skills-grid {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 0.625rem 1rem;
    font-family: var(--font-sans);
    font-size: 0.875rem;
  }
  @media (max-width: 480px) {
    .cv-skills-grid { grid-template-columns: 1fr; }
  }
  .cv-skill-cat {
    font-weight: 600;
    color: var(--text-primary);
  }
  .cv-skill-val {
    color: var(--text-secondary);
  }

  /* Education */
  .cv-edu-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .cv-edu-item {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }
  .cv-edu-school {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1rem;
    color: var(--text-primary);
    margin: 0;
  }
  .cv-edu-degree {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--text-secondary);
    font-style: italic;
  }
  .cv-edu-year {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .cv-languages {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--text-secondary);
    margin: 0;
  }

  /* Single-Page Well-Balanced A4 Print Stylesheet */
  @media print {
    @page {
      size: A4 portrait;
      margin: 6mm 10mm;
    }
    :global(html), :global(body) {
      background: #ffffff !important;
      color: #000000 !important;
      font-size: 8.0pt !important;
      line-height: 1.22 !important;
      width: 100% !important;
      height: 100% !important;
      max-height: 100vh !important;
      overflow: hidden !important;
      margin: 0 !important;
      padding: 0 !important;
    }
    :global(header), :global(footer), :global(.site-nav), .resume-header, .print-btn, .case-nav, .article-nav, :global(.fixed) {
      display: none !important;
    }
    :global(.pt-16) {
      padding-top: 0 !important;
    }
    .resume-page, .resume-container, .cv-card {
      padding: 0 !important;
      margin: 0 !important;
      max-width: 100% !important;
      width: 100% !important;
      border: none !important;
      box-shadow: none !important;
      background: transparent !important;
      page-break-inside: avoid !important;
      break-inside: avoid !important;
    }
    .cv-card *, .cv-card a, .cv-card span, .cv-card p, .cv-card h2, .cv-card h3, .cv-card h4, .cv-card li {
      color: #000000 !important;
    }
    .cv-header {
      padding-bottom: 4pt !important;
      margin-bottom: 5pt !important;
      border-bottom: 1.2pt solid #000000 !important;
      text-align: center !important;
    }
    .cv-name {
      font-size: 15pt !important;
      color: #000000 !important;
      margin-bottom: 2pt !important;
      line-height: 1.1 !important;
    }
    .cv-contacts {
      font-size: 7.8pt !important;
      color: #000000 !important;
      gap: 2pt 8pt !important;
      justify-content: center !important;
    }
    .cv-contacts a {
      color: #000000 !important;
      text-decoration: none !important;
    }
    .cv-body {
      gap: 5pt !important;
    }
    .cv-section {
      padding-bottom: 4pt !important;
      border-bottom: 0.5pt solid #cccccc !important;
      page-break-inside: avoid !important;
      break-inside: avoid !important;
    }
    .cv-section-title {
      font-size: 8.2pt !important;
      color: #000000 !important;
      margin-bottom: 3pt !important;
      letter-spacing: 0.08em !important;
      font-weight: 700 !important;
    }
    .cv-entries {
      gap: 4.5pt !important;
    }
    .cv-entry {
      page-break-inside: avoid !important;
      break-inside: avoid !important;
    }
    .cv-entry-head {
      margin-bottom: 1pt !important;
    }
    .cv-entry-company {
      font-size: 9.2pt !important;
      color: #000000 !important;
    }
    .cv-entry-role {
      font-size: 8pt !important;
      color: #000000 !important;
    }
    .cv-entry-meta {
      font-size: 7.5pt !important;
      color: #000000 !important;
    }
    .cv-list {
      margin: 1pt 0 !important;
      padding-left: 10pt !important;
    }
    .cv-list li {
      font-size: 7.8pt !important;
      line-height: 1.22 !important;
      margin-bottom: 1pt !important;
      color: #000000 !important;
    }
    .cv-list li::marker {
      color: #000000 !important;
    }
    .cv-tech, .cv-other-projects, .cv-skills-grid, .cv-languages {
      font-size: 7.8pt !important;
      color: #000000 !important;
    }
    .cv-skills-grid {
      grid-template-columns: 110px 1fr !important;
      gap: 2pt 6pt !important;
      font-size: 7.8pt !important;
    }
    .cv-edu-list {
      gap: 3pt !important;
    }
    .cv-edu-school {
      font-size: 8.4pt !important;
      color: #000000 !important;
    }
    .cv-edu-degree {
      font-size: 7.8pt !important;
      color: #000000 !important;
    }
    .cv-edu-year {
      font-size: 7.4pt !important;
      color: #000000 !important;
    }
    .cv-languages {
      font-size: 7.8pt !important;
      color: #000000 !important;
    }
  }
</style>
