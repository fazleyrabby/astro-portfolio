---
import MainLayout from "@layouts/MainLayout.astro";
import { Content as UsesMarkdown } from "../content/uses.md";
---

<MainLayout title="Workbench & Setup — Fazley Rabbi">
  <main class="v2-uses-workspace max-w-[800px] mx-auto px-4 py-12">
    <header class="v2-uses-header pb-6 mb-8">
      <span class="font-mono text-xs text-[var(--accent)] tracking-wider uppercase mb-1 block">/ WORKBENCH</span>
      <h1 class="font-serif font-bold text-3xl text-theme-primary leading-tight mb-2">Setup & Workbench</h1>
      <p class="font-sans text-sm text-theme-secondary">Hardware specifications, software workspace components, and learning environments deployed daily.</p>
    </header>

    <!-- Flat borderless container rendering the exact markdown data -->
    <div class="v2-uses-content">
      <article class="prose prose-neutral dark:prose-invert max-w-none">
        <UsesMarkdown />
      </article>
    </div>
  </main>
</MainLayout>

<style>
  .v2-uses-content :global(.prose) {
    font-size: 1rem;
    color: var(--text-secondary);
  }
  .v2-uses-content :global(.prose h2) {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-top: 32px;
    margin-bottom: 12px;
    padding-bottom: 6px;
    padding-bottom: 6px;
  }
  .v2-uses-content :global(.prose h3) {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-style: italic;
    font-weight: 600;
    color: var(--text-primary);
    margin-top: 24px;
    margin-bottom: 8px;
  }
  .v2-uses-content :global(.prose p) {
    font-family: var(--font-sans);
    font-size: 1rem;
    line-height: 1.6;
    color: var(--text-secondary);
    margin: 12px 0;
  }
  .v2-uses-content :global(.prose ul) {
    list-style-type: disc;
    padding-left: 20px;
    margin: 12px 0;
  }
  .v2-uses-content :global(.prose li) {
    font-family: var(--font-sans);
    font-size: 1rem;
    line-height: 1.6;
    color: var(--text-secondary);
    margin: 6px 0;
  }
  .v2-uses-content :global(.prose strong) {
    color: var(--text-primary);
    font-weight: 600;
  }
  .v2-uses-content :global(.prose hr) {
    border: none;
    margin: 24px 0;
  }
  .v2-uses-content :global(.prose blockquote) {
    border-left: 2px solid var(--accent);
    padding-left: 16px;
    font-style: italic;
    color: var(--text-muted);
  }
</style>
