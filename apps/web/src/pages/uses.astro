---
import MainLayout from "@layouts/MainLayout.astro";
import PortBanner from "@components/port/PortBanner.astro";
import { Content as UsesMarkdown } from "../content/uses.md";
---

<MainLayout title="Setup & Workbench — Fazley Rabbi">
  <PortBanner title="Uses" kicker="The workbench" lede="The hardware, software and homelab I work with." motif="bay" />
  <main class="uses-page">
    <div class="uses-container">

      <div class="uses-content reveal">
        <article class="prose prose-neutral dark:prose-invert max-w-none">
          <UsesMarkdown />
        </article>
      </div>
    </div>
  </main>
</MainLayout>

<style>
  .uses-page {
    padding: 48px 0 64px;
  }
  .uses-container {
    width: min(900px, calc(100% - 48px));
    margin: 0 auto;
    padding: 0;
  }
  @media (max-width: 640px) {
    .uses-page {
      padding: 36px 0 48px;
    }
    .uses-container {
      width: calc(100% - 40px);
    }
  }
  .uses-content {
    max-width: 720px;
  }
  .uses-header {
    margin-bottom: 2.5rem;
  }

  .uses-content :global(.prose) {
    font-size: 1rem;
    color: var(--text-secondary);
  }
  .uses-content :global(.prose h2) {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 500;
    color: var(--text-primary);
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    letter-spacing: -0.01em;
  }
  .uses-content :global(.prose h3) {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-style: italic;
    font-weight: 500;
    color: var(--text-primary);
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
  }
  .uses-content :global(.prose p) {
    font-family: var(--font-sans);
    font-size: 1rem;
    line-height: 1.75;
    color: var(--text-secondary);
    margin: 0.75rem 0;
  }
  .uses-content :global(.prose ul) {
    list-style-type: disc;
    padding-left: 1.25rem;
    margin: 0.75rem 0;
  }
  .uses-content :global(.prose li) {
    font-family: var(--font-sans);
    font-size: 1rem;
    line-height: 1.75;
    color: var(--text-secondary);
    margin: 0.375rem 0;
  }
  .uses-content :global(.prose strong) {
    color: var(--text-primary);
    font-weight: 600;
  }
  .uses-content :global(.prose hr) {
    border: none;
    border-top: 1px solid var(--border);
    margin: 2rem 0;
  }
  .uses-content :global(.prose blockquote) {
    border-left: 2px solid var(--accent);
    padding-left: 1rem;
    font-style: italic;
    color: var(--text-muted);
  }
</style>
